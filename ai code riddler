-- Text helpers
function Guest.text.stripTags(s)
	if type(s) ~= "string" then return tostring(s) end
	return (s:gsub("<[^>]->", ""))
end

function Guest.text.trim(s)
	return (s or ""):gsub("^%s+",""):gsub("%s+$","")
end

function Guest.text.copy(s)
	if not setclipboardFn then return false end
	return (pcall(setclipboardFn, s))
end

function Guest.text.requireModule(inst)
	if not inst then return nil end
	local ok, mod = pcall(require, inst)
	if not ok then return nil end
	return mod
end

-- Generic require-if-loaded (only require modules already in memory)
function Guest.text.requireIfLoaded(inst)
	if not (inst and getloadedmodules) then return nil end
	local ok, mods = pcall(getloadedmodules)
	if not ok or type(mods) ~= "table" then return nil end
	for _, m in ipairs(mods) do
		if m == inst then return Guest.text.requireModule(inst) end
	end
end

-- Find first upvalue table containing a key
function Guest.text.findUpvalueTable(fn, key)
	if type(fn) ~= "function" or not getupvalues then return nil end
	local ok, ups = pcall(getupvalues, fn)
	if not ok or type(ups) ~= "table" then return nil end
	for _, uv in pairs(ups) do
		if type(uv) == "table" and rawget(uv, key) ~= nil then return uv end
	end
end

-- Cache passthroughs
function Guest.cache.synchronizedPlayer()
	local controllers = ReplicatedStorage:FindFirstChild("Controllers")
	local dataCtl = Guest.text.requireIfLoaded(controllers and controllers:FindFirstChild("DataController"))
	local tbl = Guest.text.findUpvalueTable(type(dataCtl) == "table" and dataCtl.Load or nil, "CacheTable")
	local value = type(tbl) == "table" and rawget(tbl, "CacheTable") or nil
	if type(value) == "table" then return value end
end

function Guest.cache.rngMachineConfig()
	local controllers = ReplicatedStorage:FindFirstChild("Controllers")
	local ctl = Guest.text.requireIfLoaded(controllers and controllers:FindFirstChild("RNGMachineController"))
	if type(ctl) ~= "table" then return nil end
	for _, v in pairs(ctl) do
		local t = Guest.text.findUpvalueTable(v, "Config")
		if type(t) == "table" and type(t.SkillTree) == "table" then return t end
	end
end

-- ============================================================
-- LIVE EXTREMES  (cheapest / most expensive / highest income)
-- ============================================================
Guest.extremes = { data = {} }

function Guest.extremes.record(category, displayName, price, income, source)
	local name = tostring(displayName or "")
	if name == "" then return end

	local function bucket(cat)
		local b = Guest.extremes.data[cat]
		if not b then b = {}; Guest.extremes.data[cat] = b end

		local isNormal = source == nil

		local function beats(a, curr, preferLower)
			if not curr then return true end
			if a ~= curr.value then
				if preferLower then return a < curr.value end
				return a > curr.value
			end
			if isNormal ~= curr.normal then return isNormal end
			return name < curr.name
		end

		if price and price > 0 then
			if beats(price, b.cheapest, true)  then b.cheapest  = { name = name, value = price,  normal = isNormal } end
			if beats(price, b.expensive, false) then b.expensive = { name = name, value = price,  normal = isNormal } end
		end
		if income and income > 0 and beats(income, b.income, false) then
			b.income = { name = name, value = income, normal = isNormal }
		end
	end

	bucket(tostring(category or "Unknown"):upper())
	bucket("*")
end

function Guest.extremes.summary()
	local out = { "LIVE_EXTREMES: zero-price placeholders excluded; price ties prefer a normal/non-event entry." }
	local keys = {}
	for k in pairs(Guest.extremes.data) do keys[#keys+1] = k end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local b = Guest.extremes.data[k]
		out[#out+1] = ("  %s: CHEAPEST=%s($%s); MOST_EXPENSIVE=%s($%s); HIGHEST_INCOME=%s(%s/s)"):format(
			k == "*" and "ALL" or k,
			b.cheapest  and b.cheapest.name  or "?", b.cheapest  and tostring(b.cheapest.value)  or "?",
			b.expensive and b.expensive.name or "?", b.expensive and tostring(b.expensive.value) or "?",
			b.income    and b.income.name    or "?", b.income    and tostring(b.income.value)    or "?"
		)
	end
	return table.concat(out, "\n")
end

function Guest.extremes.resolve(arg)
	local s = tostring(arg or ""):lower()

	for _, w in ipairs({ "second","third","fourth","fifth","2nd","3rd","5th" }) do
		if (" "..s.." "):find(" "..w.." ", 1, true) then return nil end
	end

	local kind
	if s:find("cheapest", 1, true) or s:find("lowest price", 1, true) then kind = "cheapest"
	elseif s:find("most expensive", 1, true) or s:find("highest price", 1, true) then kind = "expensive"
	elseif s:find("highest income", 1, true) or s:find("most income", 1, true) or s:find("highest earning", 1, true) then kind = "income"
	elseif (" "..s.." "):find(" best ", 1, true) or s:find(" greatest ", 1, true) or (" "..s.." "):find(" top ", 1, true) then kind = "best"
	else return nil end

	for _, w in ipairs({ "merchant","shop","machine","stall","sell","sold","stock" }) do
		if s:find(w, 1, true) then return nil end
	end

	local suffix = s:match("%splus%s+(%d+)%s*[%?%.!]*$") or s:match("%+%s*(%d+)%s*[%?%.!]*$")
	local body = s
	if suffix then
		body = s:gsub("%splus%s+%d+%s*[%?%.!]*$",""):gsub("%+%s*%d+%s*[%?%.!]*$","")
	end

	if body:find(" plus ", 1, true) or body:find("+", 1, true) or body:find(" and ", 1, true) then
		return nil
	end

	local padded = " " .. s:gsub("[^%w]", " ") .. " "
	local chosenKey, chosenBucket = "*", Guest.extremes.data["*"]

	for k, b in pairs(Guest.extremes.data) do
		if k ~= "*" then
			local pos = padded:find(" " .. k:lower() .. " ", 1, true)
			local take = pos and (chosenKey == "*" or #k > #chosenKey)
			if take then chosenKey, chosenBucket = k, b end
		end
	end

	if kind == "best" then
		if chosenKey == "*" or chosenKey == "OG" then return nil end
		kind = "income"
	end

	local entry = chosenBucket and chosenBucket[kind]
	if not entry then return nil end

	local codeName = Guest.codeName(entry.name) or entry.name:gsub("[^%w]",""):upper()
	if suffix and codeName:sub(-#suffix) ~= suffix then
		codeName = codeName .. suffix
	end
	return codeName
end

function Guest.malformedCodeBody(arg)
	local padded = " " .. tostring(arg or ""):lower() .. " "
	if #padded > 100 then return true end
	for _, w in ipairs({ " because "," between "," normally "," but "," tied "," than "," versus " }) do
		if padded:find(w, 1, true) then return true end
	end
	return false
end

-- ============================================================
-- RIDDLE / CODE CLASSIFIER
-- ============================================================
Guest.classify.run = function(raw)
	local src = tostring(raw or "")
	local low = src:lower()
	local tokens = {}
	for w in src:gmatch("[%w']+") do tokens[#tokens+1] = w end
	local count = #tokens
	if count == 0 then return nil end

	local padded = " " .. low:gsub("[^%w]", " ") .. " "
	if low:find("?", 1, true) then return "riddle" end

	for _, w in ipairs({
		" what "," whats "," which "," how "," when "," who "," whos ",
		" where "," why "," guess "," riddle "," name the ",
	}) do
		if padded:find(w, 1, true) then return "riddle" end
	end

	if padded:find(" my ", 1, true) then return "riddle" end
	if count >= 2 and (padded:find(" plus ", 1, true) or low:find("+", 1, true)) then return "riddle" end
	if count >= 4 and padded:find(" and ", 1, true) then return "riddle" end

	local allUpper = not src:find("%l")

	local stopWords = {
		LOL=1, OMG=1, GOOD=1, LUCK=1, CAPS=1, ALL=1, SPACES=1, WINS=1, WIN=1, HINT=1,
		NOT=1, LAST=1, ONE=1, UPPERCASE=1, CAPITALS=1, SECONDS=1, FAST=1, NEW=1, THE=1,
		AND=1, FIRST=1, GUYS=1, BRO=1, YES=1, NICE=1,
	}

	local propertyWords = {
		colour=1, color=1, colours=1, colors=1, name=1, rarity=1, income=1, gen=1,
		generation=1, mps=1, mutation=1, mutations=1, trait=1, traits=1, exist=1,
		exists=1, date=1, month=1, year=1, age=1, value=1, price=1, speed=1, tier=1,
		amount=1, stock=1, count=1, multiplier=1, birthday=1, cost=1, earnings=1,
		fav=1, favourite=1, favorite=1,
	}

	local isCodeByPhrase = low:find("code%s+was") ~= nil or low:find("answer%s+was") ~= nil

	local metaWords = {
		prize=1, hint=1, reward=1, time=1, limit=1, winners=1, redeems=1, uses=1, ends=1, giveaway=1,
	}

	if not isCodeByPhrase then
		local k, v = src:match("(%a+):%s*([%w]+)[%s%p]*$")
		if k and v and not metaWords[k:lower()] then isCodeByPhrase = true end
	end

	if not isCodeByPhrase then
		local words = {}
		for w in src:gmatch("[%w']+") do words[#words+1] = w end
		local insideOf = false

		for i, w in ipairs(words) do
			local bare  = w:gsub("'[sS]$","")
			local lowB  = bare:lower()
			local next1 = words[i+1] or ""
			local next2 = words[i+2] or ""
			local isProp = (w:match("'[sS]$") or w:match("[sS]$")) and propertyWords[next1:lower()]
			if not isProp and next1:match("'[sS]$") then isProp = propertyWords[next2:lower()] end

			if not isProp then
				isProp = metaWords[(words[i-1] or ""):lower()]
				if isProp then isProp = (words[i-2] or ""):lower() ~= "of" end
				if isProp then isProp = (words[i-2] or ""):lower() ~= "is" end
			end

			if lowB == "of" then
				insideOf = true
			elseif not (insideOf and lowB == "of") then
				if bare:match("^%d+[snrt][tdh]$") then
					insideOf = false
				else
					local isLongNum = #bare >= 4 and bare:match("^%d+$")
					local hitNum
					if isLongNum then
						hitNum = not (words[i+1] or ""):match("^%l")
					else
						hitNum = isLongNum
					end
					hitNum = hitNum or bare:match("^%d+%u+$") or (bare:match("%d") and select(2, bare:gsub("%a","")) >= 2)

					if hitNum then
						isCodeByPhrase = true
						break
					elseif not allUpper and #bare >= 3 and bare:match("^%u+$") and not stopWords[bare] then
						if not (insideOf or isProp) then
							isCodeByPhrase = true
							break
						end
					else
						insideOf = false
					end
				end
			end
		end
	end

	if not isCodeByPhrase then
		local articleWords = { the=1, its=1, his=1, this=1, that=1, their=1, our=1, sammys=1, todays=1, current=1, sabs=1 }
		local specialWords = { prize=1, brainrot=1, sab=1, sammy=1, dev=1, game=1, secret=1, new=1 }
		local followWords  = {
			next=1, same=1, one=1, below=1, above=1, weekend=1, week=1, monday=1, tuesday=1,
			wednesday=1, thursday=1, friday=1, saturday=1, sunday=1, message=1, worth=1,
			last=1, final=1, first=1,
		}
		local skipWords    = { just=1, literally=1, also=1, actually=1, still=1, gonna=1, going=1, to=1, be=1 }
		local codePatterns = {
			"code%s+is[%s%p]*","code%s+will%s+be[%s%p]*","code%s*=%s*","code%s*:%s*",
			"code%s+equals%s+","code%s+would%s+be%s+","codes?%s+gonna%s+be%s+",
			"code's%s+","code%s+this%s+time%s+is%s+","code%s+today%s+is%s+",
			"code%s+this%s+time%s+will%s+be%s+","code%s+for%s+[%a%s]-%s+is%s+",
			"code%s+for%s+[%a%s]-%s+will%s+be%s+","code%s+for%s+[%a%s]-:%s*",
		}

		local bestPos, bestEnd
		for _, pat in ipairs(codePatterns) do
			local s, e = low:find(pat)
			if s and (not bestPos or s < bestPos or (s == bestPos and e > bestEnd)) then
				bestPos, bestEnd = s, e
			end
		end

		if bestPos then
			local postWords, postRaw = {}, {}
			for w in src:sub(bestEnd + 1):gmatch("[%w']+") do
				postWords[#postWords+1] = w:lower():gsub("'","")
				postRaw[#postRaw+1]   = w
				if #postWords >= 8 then break end
			end

			local idx = 1
			while postWords[idx] and skipWords[postWords[idx]] do idx = idx + 1 end

			local firstLow  = postWords[idx]
			local firstRaw  = postRaw[idx]
			local badCapital = firstRaw and firstRaw:match("^%u%l") and firstLow ~= "the" and firstLow ~= "its"

			if firstLow and not badCapital then
				local nextLow  = postWords[idx+1]
				local looksLikeMsg = nextLow ~= nil and nextLow:match("^%d+[snrt][tdh]$") ~= nil and postWords[idx+2] == "of"

				for j = idx+1, math.min(idx+5, #postWords) do
					local w = postWords[j]
					if w == "message" or w == "messages" or w == "timer" or w == "announcement"
					or w == "below" or w == "top" or w == "following" then
						looksLikeMsg = true
					end
				end

				local timeWords = { morning=1, afternoon=1, evening=1, night=1, tonight=1, time=1, hour=1, month=1, year=1 }
				local thisThat  = firstLow == "this" or firstLow == "that"
				if thisThat then thisThat = timeWords[nextLow or ""] end
				if thisThat then thisThat = not propertyWords[postWords[idx+2] or ""] end
				if thisThat then looksLikeMsg = true end

				if firstLow == "this" and src:sub(bestEnd + 1):match("^[%s%p]*this[%s]*[,%.!:%-]") then
					looksLikeMsg = true
				end

				if articleWords[firstLow] and postRaw[idx+1] and postRaw[idx+1]:match("^%u%l") and not allUpper then
					local ok = false
					for j = idx+1, math.min(idx+4, #postWords) do
						if propertyWords[postWords[j]] or postRaw[j]:match("'[sS]$") then ok = true end
					end
					if not ok then looksLikeMsg = true end
				end

				if articleWords[firstLow] and nextLow ~= nil and not looksLikeMsg
					and (nextLow == "one" and (postWords[idx+2] == "that" or postWords[idx+2] == "with" or postWords[idx+2] == "one")
						or not followWords[nextLow]) then
					return "riddle", "property"
				end

				if firstLow:match("^%d+[snrt][tdh]$") then return "riddle", "property" end
				if propertyWords[firstLow] then return "riddle", "property" end

				local special = specialWords[firstLow]
				if special then
					local more = propertyWords[nextLow or ""] or propertyWords[postWords[idx+2] or ""]
					if more then return "riddle", "property" end
				end
			end

			if firstLow then
				for j = idx, math.min(idx+4, #postWords) do
					local plural = postRaw[j]:match("'[sS]$") or (postWords[j]:match("s$") and postWords[j] ~= "it" and postWords[j] ~= "its" and postWords[j] ~= "his")
					local hit = plural and propertyWords[postWords[j+1] or ""]
					if hit then return "riddle", "property" end
					if not (postRaw[j]:match("^%u") or postWords[j]:match("s$")) then break end
				end
			end
		end

		local shortForm = low:match("^(.-)%s+is%s+the%s+code")
			or low:match("^(.-)%s+is%s+today'?s%s+code")
			or low:match("^(.-)%s+will%s+be%s+the%s+code")
			or low:match("^(.-)%s*=%s*the%s+code")
		if shortForm and #shortForm < 40 then
			for w in shortForm:gmatch("%a+") do
				if propertyWords[w] then return "riddle", "property" end
			end
		end

		for _, tail in ipairs({
			" of the brainrot "," of the prize "," of this brainrot "," of that brainrot ",
			" of the reward "," of the item ",
		}) do
			local pos = padded:find(tail, 1, true)
			if pos and propertyWords[padded:sub(1, pos):match("(%a+)%s*$") or ""] then
				return "riddle", "property"
			end
		end
	end

	if low:find("code", 1, true) then return "code" end
	for _, w in ipairs({ " redeem "," type "," enter "," claim " }) do
		if padded:find(w, 1, true) then return "code" end
	end

	if count >= 7 then return "riddle" end
	if count == 1 then return "code" end

	if count <= 3 then
		local upperCount = 0
		for _, w in ipairs(tokens) do
			if #w >= 3 and ((w == w:upper() and w:match("%a")) or w:match("%d")) then
				upperCount = upperCount + 1
			end
		end
		if upperCount == count then return "code" end
	end

	return nil
end

