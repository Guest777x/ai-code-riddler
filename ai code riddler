-- ============================================================
-- SUBJECT RESOLVER  (which brainrot does the riddle "mean"?)
-- ============================================================
function Guest.subjectOf(arg)
	local padded = " " .. tostring(arg or ""):lower():gsub("[^%w]+", " ") .. " "

	local directAnimal = Guest.findAnimal(arg)
	if directAnimal then return directAnimal, false end

	local pos = padded:find(" the brainrot ", 1, true)
		or padded:find(" the prize ", 1, true)
		or padded:find(" the reward ", 1, true)
		or padded:find(" that brainrot ", 1, true)
		or padded:find(" this brainrot ", 1, true)
		or padded:find(" the pet ", 1, true)
		or padded:find(" the one ", 1, true)
		or padded:find(" of this brainrot ", 1, true)
		or padded:find(" of the pet ", 1, true)
		or padded:find(" that one ", 1, true)
		or padded:find(" its ", 1, true)
		or padded:find(" the animal ", 1, true)

	if not pos then
		for _, tail in ipairs({ " the prizes ", " the loot ", " the rewards " }) do
			local p = padded:find(tail, 1, true)
			if p then
				local w = padded:sub(p + #tail):match("^(%a+)") or ""
				if w:find("^colou?r") or w == "colour" or w == "rarity" or w == "income"
					or w:find("^mutation") or w:find("^exist") or w:find("^trait")
					or w == "exist" or w == "count" then
					pos = true
					break
				end
			end
		end
	end

	if not pos then return nil, false end

	local now = os.time()
	local prize   = Guest.state.prize
	local subject = Guest.state.subject

	if type(prize) == "table" and now - (prize.t or 0) > 5400 then prize = nil end
	if type(subject) == "table" and now - (subject.t or 0) > 3600 then subject = nil end

	local refPrize = padded:find(" the prize ", 1, true)
		or padded:find(" the answer ", 1, true)
		or padded:find(" the prizes ", 1, true)
		or padded:find(" codes are for ", 1, true)
		or padded:find(" code is for ", 1, true)
		or padded:find(" codes for ", 1, true)
		or padded:find(" code for ", 1, true)
		or padded:find(" giving away ", 1, true)
		or padded:find(" of the ", 1, true)

	if refPrize then
		prize = prize or subject
	elseif prize and subject then
		prize = (subject.t or 0) >= (prize.t or 0) and subject or prize
	else
		prize = prize or subject
	end

	if prize then return prize.name, true, prize end
	return nil, false
end

-- ============================================================
-- CACHE KEY  (keeps today/date/month/year queries fresh)
-- ============================================================
function Guest.cacheKey(arg)
	local key = tostring(arg or "")
	local subject, isPrize = Guest.subjectOf(key)
	if isPrize and subject then
		key = key .. "|pin=" .. subject
	end
	local low = key:lower()
	if low:find("today", 1, true) or low:find("date", 1, true)
		or low:find("month", 1, true) or low:find("year", 1, true)
		or low:find("%f[%a]days?%f[%A]") or low:find(" today ", 1, true)
		or low:find("yesterday", 1, true) then
		key = key .. "|ny=" .. os.date("!%Y-%m-%d", Guest.nyTime())
	end
	return key
end

-- ============================================================
-- NEW YORK TIME  (developer's clock)
-- ============================================================
function Guest.nyTime()
	local now = os.time()
	local year = tonumber(os.date("!%Y", now))

	local function nthSunday(month, n)
		local day, count = 1, 0
		while day <= 31 do
			if tonumber(os.date("!%w", os.time({ year = year, month = month, day = day, hour = 12 }))) == 0 then
				count = count + 1
				if count == n then return day end
			end
			day = day + 1
		end
		return 1
	end

	local dstStart = os.time({ year = year, month = 3, day = nthSunday(3, 2), hour = 7 })
	local dstEnd   = os.time({ year = year, month = 11, day = nthSunday(11, 1), hour = 6 })
	local offset = (now >= dstStart and now < dstEnd) and -4 or -5
	return now + offset * 3600
end

