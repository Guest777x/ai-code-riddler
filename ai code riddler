local FOLD_MAP = {
	["à"]="a",["á"]="a",["â"]="a",["ä"]="a",["ã"]="a",
	["è"]="e",["é"]="e",["ê"]="e",["ë"]="e",
	["ì"]="i",["í"]="i",["î"]="i",["ï"]="i",
	["ò"]="o",["ó"]="o",["ô"]="o",["ö"]="o",["õ"]="o",
	["ù"]="u",["ú"]="u",["û"]="u",["ü"]="u",
	["ñ"]="n",["ç"]="c",
	["À"]="a",["Á"]="a",["È"]="e",["É"]="e",["Ì"]="i",["Í"]="i",
	["Ò"]="o",["Ó"]="o",["Ù"]="u",["Ú"]="u",["Ñ"]="n",
}

function Guest.fold(s)
	return tostring(s or ""):gsub("[À-ß][\128-¿]", function(c) return FOLD_MAP[c] or "" end):lower()
end

