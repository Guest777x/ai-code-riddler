Guest.redeem = {}

-- Find the code TextBox in the game's Codes UI
function Guest.redeem.findCodeBox()
	local codes = PlayerGui:FindFirstChild("Codes")
	if not codes then return nil end
	local inner = codes:FindFirstChild("Codes") or codes
	local box = inner:FindFirstChild("CodeRedeem")
	box = box and box:FindFirstChild("TextBox")
	if box and box:IsA("TextBox") then return box end
	for _, d in ipairs(codes:GetDescendants()) do
		if d:IsA("TextBox") then return d end
	end
end

-- Find the confirm / submit / redeem button
function Guest.redeem.findConfirm()
	local codes = PlayerGui:FindFirstChild("Codes")
	if not codes then return nil end
	local inner = codes:FindFirstChild("Codes") or codes
	local btn = (inner:FindFirstChild("Main") or inner):FindFirstChild("Confirm")
	if btn and (btn:IsA("ImageButton") or btn:IsA("TextButton")) then return btn end
	local fallback
	for _, d in ipairs(codes:GetDescendants()) do
		if d:IsA("ImageButton") or d:IsA("TextButton") then
			local n = d.Name:lower()
			if n:find("confirm") or n:find("submit") or n:find("redeem") or n:find("enter") then
				return d
			end
			fallback = fallback or d
		end
	end
	return fallback
end

-- Safe-fires all connections on a signal, stripping boolean guards
local function stripBooleans(fn, depth)
	if not (fn and setupvalue and getupvalues) then return end
	depth = depth or 1
	local ok, ups = pcall(getupvalues, fn)
	if ok and type(ups) == "table" then
		for k, v in pairs(ups) do
			if type(v) == "boolean" then
				pcall(setupvalue, fn, k, false)
			elseif type(v) == "function" and depth > 0 then
				stripBooleans(v, depth - 1)
			end
		end
	end
end

local function fireAll(signal, ...)
	if not getconnections then return false end
	local ok, conns = pcall(getconnections, signal)
	if not ok or type(conns) ~= "table" or #conns == 0 then return false end
	local args = table.pack(...)
	local fired = false
	for _, c in ipairs(conns) do
		if c.Enabled ~= false then
			local fn = nil
			pcall(function() fn = c.Function end)
			stripBooleans(fn)
			local ok2
			if fn then
				ok2 = pcall(task.spawn, fn, table.unpack(args, 1, args.n))
			else
				ok2 = pcall(function() c:Fire(table.unpack(args, 1, args.n)) end)
			end
			fired = fired or ok2
		end
	end
	return fired
end

-- Method 1: drive the UI code box + confirm button
function Guest.redeem.viaUI(codeText)
	if not getconnections then return false, "no getconnections" end
	local box = Guest.redeem.findCodeBox()
	if not box then return false, "no codebox" end
	pcall(function()
		box.Text = codeText
		box.Active = true
		box.Selectable = true
	end)
	local btn = Guest.redeem.findConfirm()
	local fired = false
	if btn then
		fired = fireAll(btn.MouseButton1Click) or false
		fired = fireAll(btn.Activated) or fired
	end
	if not fired then
		fired = fireAll(box.FocusLost, true) or fired
	end
	return fired, fired and "sent" or "no submit control"
end

-- Method 2: invoke the net RemoteFunction directly
Guest.redeem.remoteFn = nil
function Guest.redeem.getRemote()
	if Guest.redeem.remoteFn and Guest.redeem.remoteFn.Parent then return Guest.redeem.remoteFn end
	local ok, net = pcall(require, Net)
	if ok and type(net) == "table" then
		local ok2, rf = pcall(function()
			return net:RemoteFunction("7d14a912-1040-4867-b005-98838eb9acc4")
		end)
		if ok2 and typeof(rf) == "Instance" then Guest.redeem.remoteFn = rf end
	end
	return Guest.redeem.remoteFn
end

function Guest.redeem.viaRemote(codeText)
	local rf = Guest.redeem.getRemote()
	if not rf then return false, "no remote" end
	local ok, result = pcall(function() return rf:InvokeServer(codeText) end)
	if not ok then return false, tostring(result) end
	return true, result
end

function Guest.redeem.submit(codeText)
	local ok, msg = Guest.redeem.viaUI(codeText)
	if ok then return true, msg end
	if getconnections then return false, msg end
	return Guest.redeem.viaRemote(codeText)
end

