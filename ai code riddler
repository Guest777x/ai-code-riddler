-- ============================================================
-- UNIT EXPANSION  ("2.5K" -> "2500", "1.2M" -> "1200000")
-- ============================================================
function Guest.expandUnits(arg)
	if type(arg) ~= "string" then return arg end
	local s = arg:gsub("%s*per%s+sec%w*", ""):gsub("%s*/%s*s$", "")
	local units = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
	local prefix, num, unit, trailing = s:match("^(.-)(%d+%.?%d*)%s*([KMBTkmbt])(%d*)$")

	if not num then
		prefix, num, unit, trailing = s:match("^(.-)(%d+%.?%d*)%s*([KMBTkmbt])(%a+)$")
		if not num then return arg end
		local allow = {
			SAMMY = true, SPYDERSAMMY = true, NOVA = true,
			JANUARY = true, FEBRUARY = true, MARCH = true, APRIL = true, MAY = true,
			JUNE = true, JULY = true, AUGUST = true, SEPTEMBER = true,
			OCTOBER = true, NOVEMBER = true, DECEMBER = true,
		}
		if not (num:find(".", 1, true) or allow[trailing:upper()]) then return arg end
	end

	local mul = units[unit:upper()]
	local val = tonumber(num)
	if not (mul and val) then return arg end
	local out = prefix .. ("%d"):format(math.floor(val * mul + 0.5)) .. trailing
	if out ~= arg then Guest.state.lastUnitExpand = arg .. " -> " .. out end
	return out
end

