-- NAME HIT  (loose substring match on names, minimum length)
-- ============================================================
function Guest.nameHit(haystack, needle)
	if #needle < 5 then return false end
	if haystack:find(needle, 1, true) then return true end
	local stem = needle:gsub("es$", ""):gsub("s$", "")
	return #stem >= 4 and haystack:find(stem, 1, true) ~= nil
end

-- ============================================================
-- LIVE MODEL COLOUR  (dominant BasePart colour of a Workspace model)
-- ============================================================
function Guest.modelColour(modelName)
	local function classify(colour)
		local h, s, v = colour:ToHSV()
		if v < 0.16 then return "black" end
		if s < 0.18 then return v > 0.8 and "white" or "gray" end
		local deg = h * 360
		if deg < 15 or deg >= 345 then return "red" end
		if deg < 45 then return "orange" end
		if deg < 68 then return "yellow" end
		if deg < 170 then return "green" end
		if deg < 195 then return "cyan" end
		if deg < 255 then return "blue" end
		if deg < 290 then return "purple" end
		return "pink"
	end

	local target = nil
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Model") and d.Name == modelName then target = d; break end
	end
	if not target then return nil end

	local buckets, total = {}, 0
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.5 and d.Name ~= "HumanoidRootPart" then
			local vol = d.Size.X * d.Size.Y * d.Size.Z
			local col = classify(d.Color)
			buckets[col] = (buckets[col] or 0) + vol
			total = total + vol
		end
	end

	local best, bestVol = nil, 0
	for colour, vol in pairs(buckets) do
		if vol > bestVol then bestVol, best = vol, colour end
	end
	if not best or total <= 0 or bestVol / total < 0.45 then return nil end
	return best, math.floor(bestVol / total * 100)
end
