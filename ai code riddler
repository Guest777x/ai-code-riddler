-- The notifier is a specific RemoteEvent the game fires when an event
-- or a riddle is posted. We locate it via NotificationController.Start.
local function findNotifier()
	local ok, ctl = pcall(function()
		return require(ReplicatedStorage.Controllers:FindFirstChild("NotificationController", true))
	end)
	if ok and type(ctl) == "table" and type(ctl.Start) == "function" then
		if not getupvalues then return nil end
		local ok2, ups = pcall(getupvalues, ctl.Start)
		if ok2 and type(ups) == "table" then
			for _, v in pairs(ups) do
				if typeof(v) == "Instance"
					and (v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("UnreliableRemoteEvent"))
					and v.Parent == Net then
					return v
				end
			end
		end
	end
end

