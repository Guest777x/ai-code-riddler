Guest.mutedPhrases = {
	"^%s*$","joined the server","left the server","has left","has joined",
	"just stole","stole a ","was stolen","robbed","welcome to","thanks for playing",
	"^%s*%d+%s*$",
}
Guest.triggerArticles = { "", "the%s+", "a%s+", "an%s+", "this%s+", "your%s+", "new%s+" }
Guest.triggerNames    = { "sammy" }

Guest.triggerPatterns = {
	"code%s+is","codes?%s+are","code%s+for","code%s+to%s+use","code%s*[:%-]",
	"new%s+code","free%s+code","secret%s+code","working%s+code","another%s+code",
	"riddle%s*[:%-]","riddle%s+is","answer%s+is","guess%s+the","hint%s*[:%-]",
}
do
	for _, w in ipairs({ "use","using","redeem","type","enter","write","claim","grab","check",
		"here is","heres","here's","there is","theres","there's" }) do
		local pat = w:gsub("%s+", "%%s+")
		for _, art in ipairs(Guest.triggerArticles) do
			Guest.triggerPatterns[#Guest.triggerPatterns+1] = pat .. "%s+" .. art .. "code"
		end
	end
end

function Guest.isAllowedMessage(arg)
	local low = tostring(arg or ""):lower()
	if #low < 3 then return false end
	for _, pat in ipairs(Guest.mutedPhrases) do
		if low:find(pat) then return false end
	end
	return true
end

function Guest.matchTrigger(arg)
	local low = arg:lower()
	local triggerPos, isTrigger = nil, nil

	local function scan(pat, plain, tag)
		local cursor = 1
		while true do
			local ok, s, e = pcall(string.find, low, pat, cursor, plain)
			if not (ok and s) then break end
			if not triggerPos or e > triggerPos then
				triggerPos = e
				isTrigger = tag
			end
			cursor = e + 1
		end
	end

	for _, pat in ipairs(Guest.triggerPatterns) do scan(pat, false, false) end
	if low:find("code") or low:find("riddle") then
		for _, n in ipairs(Guest.triggerNames) do scan(n:lower(), true, true) end
	end
	if not triggerPos then return nil end
	local tail = arg:sub(triggerPos + 1)
	local firstTok
	for m, _ in firstTok, tail:gmatch("()([%w_]+)") do
		if #tail:sub(m) >= 4 and tail:sub(m):match("%a") and (tail:sub(m):match("%u") or tail:sub(m):match("%d")) then
			return tail:sub(m)
		end
		break
	end
	return triggerPos and (firstTok and tail:sub(select(2, tail:find(firstTok, 1, true)) or 1) or "") or nil
end

