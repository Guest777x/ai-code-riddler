-- ============================================================
-- READ: NEW CONTENT (brainrots added in the current update)
-- ============================================================
Guest.read = {}

function Guest.read.newContent()
	local out = {}
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	if type(animals) ~= "table" then return out end

	local getConstants = _G.__GuestGetConstants

	for k, a in pairs(animals) do
		if type(a) == "table" and type(a.IsEnabled) == "function" then
			local stamp = nil
			if getConstants then
				local ok, consts = pcall(getConstants, a.IsEnabled)
				if ok and type(consts) == "table" then
					for _, c in pairs(consts) do
						if type(c) == "string" and c:match("^Update%-") then
							stamp = c
							break
						end
					end
				end
			end

			local enabled = stamp ~= nil
			local source  = type(a.ObtainedFrom) == "table" and a.ObtainedFrom.Source or nil

			out[#out+1] = {
				name    = tostring(a.DisplayName or k),
				gen     = tonumber(a.Generation),
				rarity  = tostring(a.Rarity or "?"),
				source  = source and tostring(source) or nil,
				stamp   = stamp,
				enabled = enabled,
			}
		end
	end

	table.sort(out, function(x, y) return (x.gen or 0) > (y.gen or 0) end)
	return out
end

-- ============================================================
-- READ: SHORT NUMBER FORMAT
-- ============================================================
function Guest.shortNum(n)
	local num = tonumber(n)
	if not num then return "?" end
	for _, p in ipairs({
		{ 1e30,"No" },{ 1e27,"Oc" },{ 1e24,"Sp" },{ 1e21,"Sx" },
		{ 1e18,"Qi" },{ 1e15,"Qa" },{ 1e12,"T" },{ 1e9,"B" },
		{ 1e6,"M" },{ 1e3,"K" },
	}) do
		if p[1] <= num then
			local q = num / p[1]
			return (q % 1 == 0 and tostring(math.floor(q)) or ("%.4g"):format(q)) .. " " .. p[2]
		end
	end
	return tostring(num)
end

-- ============================================================
-- READ: NEWEST REBIRTH
-- ============================================================
function Guest.read.newRebirth()
	local out = {}
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local mod = Guest.text.requireModule(datas and datas:FindFirstChild("Rebirth"))
	if type(mod) ~= "table" then return out end

	local max = 0
	for k, v in pairs(mod) do
		local n = tonumber(type(v) == "table" and v.RebirthNumber or k)
		if n and n > max then max = n end
	end

	local getConstants = _G.__GuestGetConstants
	for k, v in pairs(mod) do
		local n = tonumber(type(v) == "table" and v.RebirthNumber or k)
		if type(v) == "table" and n == max then
			local stamp = nil
			if getConstants and type(v.IsEnabled) == "function" then
				local ok, consts = pcall(getConstants, v.IsEnabled)
				if ok and type(consts) == "table" then
					for _, c in pairs(consts) do
						if type(c) == "string" and c:match("^Update%-") then stamp = c; break end
					end
				end
			end

			local req = type(v.Requirements) == "table" and v.Requirements or {}
			local rew = type(v.Rewards) == "table" and v.Rewards or {}
			local chars = {}
			if type(req.RequiredCharacters) == "table" then
				for _, c in pairs(req.RequiredCharacters) do chars[#chars+1] = tostring(c) end
			end

			out[#out+1] = {
				number = tonumber(v.RebirthNumber) or n,
				name   = tostring(v.Name or ("Rebirth " .. tostring(k))),
				cash   = tonumber(req.Cash),
				chars  = chars,
				reward = tonumber(rew.Cash),
				mult   = tonumber(rew.Multiplier),
				stamp  = stamp,
			}
		end
	end
	table.sort(out, function(x, y) return (x.number or 0) > (y.number or 0) end)
	return out
end

-- ============================================================
-- READ: PLAYER BASES
-- ============================================================
function Guest.read.bases()
	local out = {}
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return out end
	for _, plot in ipairs(plots:GetChildren()) do
		local skin = plot:GetAttribute("Skin")
		local tier = tonumber(plot:GetAttribute("Tier")) or 0
		if tier > 0 or (skin and tostring(skin) ~= "Normal") then
			local owner = nil
			for _, d in ipairs(plot:GetDescendants()) do
				if d:IsA("TextLabel") then
					local m = tostring(d.Text):match("^(.-)'s Base$")
					if m and m ~= "" then owner = m end
					break
				end
			end
			out[#out+1] = {
				skin  = skin and tostring(skin) or nil,
				tier  = tier,
				order = tonumber(plot:GetAttribute("Order")),
				owner = owner,
			}
		end
	end
	table.sort(out, function(x, y) return (x.tier or 0) > (y.tier or 0) end)
	return out
end

