-- READ: NEW-META SNAPSHOT  (what was added to traits, mutations, etc.)
-- ============================================================
function Guest.read.snapshotMeta()
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local seenNow = {}

	local function add(prefix, modName, field)
		local mod = Guest.text.requireModule(datas and datas:FindFirstChild(modName))
		if type(mod) ~= "table" then return end
		for k, v in pairs(mod) do
			local name = type(v) == "table" and tostring(v[field] or v.Name or k) or tostring(k)
			if name ~= "" then seenNow[prefix .. "\t" .. name] = true end
		end
	end
	add("T","Traits","Display")
	add("M","Mutations","Display")
	add("L","LuckyBlocks","Display")
	add("S","ShopItems","Name")
	add("R","Rarities","Name")
	add("F","RodsShopItems","Name")

	local itemsRoot = ReplicatedStorage:FindFirstChild("Items")
	if itemsRoot then
		for _, ch in ipairs(itemsRoot:GetChildren()) do
			if ch:IsA("Tool") then seenNow["G\t" .. ch.Name] = true end
		end
	end

	local ctrl = ReplicatedStorage:FindFirstChild("Controllers")
	local ev = ctrl and ctrl:FindFirstChild("EventController")
	local evl = ev and ev:FindFirstChild("Events")
	if evl then
		for _, ch in ipairs(evl:GetChildren()) do seenNow["E\t" .. ch.Name] = true end
	end

	if next(seenNow) == nil then return {} end

	local path = ("guest_seen_meta_%s.txt"):format(tostring(game.PlaceId))
	local seenBefore = {}
	if readfile and isfile then
		local ok, body = pcall(function() if isfile(path) then return readfile(path) end end)
		if ok and type(body) == "string" then
			for line in body:gmatch("[^\n]+") do
				local k, v = line:match("^(.-\t.-)\t(.*)$")
				if k then seenBefore[k] = tonumber(v) or 0 end
			end
		end
	end

	if type(Guest.shipped.meta) == "string" then
		for line in Guest.shipped.meta:gmatch("[^\n]+") do
			local trimmed = line:match("^%s*(.-)%s*$")
			if trimmed ~= "" and trimmed:find("\t") and seenBefore[trimmed] == nil then
				seenBefore[trimmed] = 0
			end
		end
	end

	local primed = next(seenBefore) ~= nil
	local kindMap = { T="trait", M="mutation", L="lucky block", S="shop item", E="event", G="gear", R="rarity", F="fishing rod" }

	local out = {}
	local now = os.time()
	if primed then
		for k in pairs(seenNow) do
			local stamp = seenBefore[k]
			if stamp == nil or (stamp > 0 and now - stamp < 604800) then
				local kind, name = k:match("^(.-)\t(.*)$")
				out[#out+1] = { kind = kindMap[kind] or kind, name = name, firstSeen = stamp or now }
			end
		end
		table.sort(out, function(x, y)
			if x.kind ~= y.kind then return x.kind < y.kind end
			return x.name < y.name
		end)
	end

	if writefile then
		local buf = {}
		for k in pairs(seenNow) do
			local stamp = seenBefore[k]
			if stamp == nil then stamp = primed and now or 0 end
			buf[#buf+1] = k .. "\t" .. tostring(stamp)
		end
		for k, stamp in pairs(seenBefore) do
			if not seenNow[k] then buf[#buf+1] = k .. "\t" .. tostring(stamp or 0) end
		end
		table.sort(buf)
		pcall(writefile, path, table.concat(buf, "\n"))
	end
	return out, primed
end

-- ============================================================
-- READ: NEW-BRAINROT SNAPSHOT (recently added brainrots)
-- ============================================================
function Guest.read.snapshotNew()
	local out = {}
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	if type(animals) ~= "table" then return out, false end

	local nowSet = {}
	for _, a in pairs(animals) do
		if type(a) == "table" and a.DisplayName then
			nowSet[tostring(a.DisplayName)] = tonumber(a.Generation) or 0
		end
	end

	local path = ("guest_seen_%s.txt"):format(tostring(game.PlaceId))
	local seenBefore = {}
	if readfile and isfile then
		local ok, body = pcall(function() if isfile(path) then return readfile(path) end end)
		if ok and type(body) == "string" then
			for line in body:gmatch("[^\n]+") do
				local name, _, stamp = line:match("^(.-)\t([^\t]*)\t?(.*)$")
				name = name or line
				if name ~= "" then seenBefore[name] = tonumber(stamp) or 0 end
			end
		end
	end

	if next(seenBefore) == nil and type(Guest.shipped.baseline) == "string" then
		for line in Guest.shipped.baseline:gmatch("[^\n]+") do
			local trimmed = line:match("^%s*(.-)%s*$")
			if trimmed ~= "" then seenBefore[trimmed] = 0 end
		end
	end

	local primed = next(seenBefore) ~= nil
	local now = os.time()
	if primed then
		for name, gen in pairs(nowSet) do
			local stamp = seenBefore[name]
			if stamp == nil then
				out[#out+1] = { name = name, gen = gen, firstSeen = now, ageHours = 0 }
			elseif stamp > 0 and now - stamp < 604800 then
				out[#out+1] = {
					name = name, gen = gen, firstSeen = stamp,
					ageHours = math.floor((now - stamp) / 3600),
				}
			end
		end
		table.sort(out, function(x, y)
			if (x.firstSeen or 0) == (y.firstSeen or 0) then return (x.gen or 0) > (y.gen or 0) end
			return (x.firstSeen or 0) > (y.firstSeen or 0)
		end)
	end

	if writefile then
		local buf = {}
		for name, gen in pairs(nowSet) do
			local stamp = seenBefore[name]
			if stamp == nil then stamp = primed and now or 0 end
			buf[#buf+1] = name .. "\t" .. tostring(gen) .. "\t" .. tostring(stamp)
		end
		for name, stamp in pairs(seenBefore) do
			if nowSet[name] == nil then buf[#buf+1] = name .. "\t0\t" .. tostring(stamp or 0) end
		end
		table.sort(buf)
		pcall(writefile, path, table.concat(buf, "\n"))
	end
	return out, primed
end

