function Guest.autoRedeemAnswer(text)
	local code = Guest.text.trim(text:gsub("^%a+%s*:%s*", ""):gsub("[^%w]", ""):upper())
	if code == "" then
		Guest.setStatus("no answer to redeem", "err")
		return false
	end

	if Guest.flags.secureRedeem then
		return Guest.secureRedeem(text)
	end

	Guest.setStatus("redeeming: " .. code, "busy")
	local cardSetter = Guest.addRedeemCard({ code }, "REDEEM")
	cardSetter(1, "sending")
	local ok, resp = Guest.redeem.submit(code)
	local success = ok and type(resp) == "table" and (resp.success or resp.Success) or false

	if ok and type(resp) ~= "table" then
		cardSetter(1, "sent")
		Guest.setStatus("sent: " .. code, "ok")
		return true
	end
	cardSetter(1, success and "ok" or "fail")
	Guest.setStatus(success and ("redeemed: " .. code) or ("redeem failed: " .. tostring(resp)), success and "ok" or "err")
	return success
end

-- Build a small set of variant codes and try them in order
function Guest.buildVariants(arg, altForm, altAnswer)
	local base = (arg or ""):gsub("%s*/%s*[sS][eE]?[cC]?%.?%s*$", ""):gsub("%s+per%s+sec[a-zA-Z]*%s*$", ""):gsub("[^%w]", ""):upper()
	if base == "" then return {} end
	local out, seen = {}, {}

	local function push(v, minLen)
		if v == nil then return end
		local f = (v or ""):gsub("%s*/%s*[sS][eE]?[cC]?%.?%s*$", ""):gsub("%s+per%s+sec[a-zA-Z]*%s*$", ""):gsub("[^%w]", ""):upper()
		if f ~= "" and #f >= (minLen or 2) and not seen[f] and #out < 3 then
			seen[f] = true
			out[#out+1] = f
		end
	end

	push(base, 1)
	if altForm   then push(altForm, 1)   end
	if altAnswer then push(altAnswer, 1) end

	local m, digits = base:match("^(%u+)AND(%d+)$")
	if not m then m, digits = base:match("^(%u+)WITH(%d+)$") end
	if m and digits and #m >= 4 then push(m .. digits, 2) end

	local prefix, n, suffix = base:match("^(.-)(%d+)XLUCK(.*)$")
	if not prefix then
		prefix, n, suffix = base:match("^(.-)LUCK(%d+)X(.*)$")
		if prefix then push(prefix .. n .. "XLUCK" .. suffix, 2) end
	else
		push(prefix .. "LUCK" .. n .. "X" .. suffix, 2)
	end
	if prefix then push(prefix .. n .. "X" .. suffix, 2) end

	local stripped = base:gsub("[\128-\255]", ""):gsub("[^%w]", ""):upper()
	if stripped ~= "" and stripped ~= base then push(stripped, 2) end

	if base:match("%d+$") then return out end
	local letterCount = select(2, base:gsub("%a", ""))
	if select(2, base:gsub("%d", "")) > 0 and letterCount <= 2 then return out end

	if base:sub(-1) == "S" and #base > 3 then
		push(base:sub(1, -2))
	else
		push(base .. "S")
	end

	local mapped = Guest.data.sources[base]
	if mapped then push(mapped) end

	return out
end

function Guest.secureRedeem(text, altForm, altAnswer)
	local codes = Guest.buildVariants(text, altForm, altAnswer)
	if #codes == 0 then
		Guest.setStatus("no answer to redeem", "err")
		return false
	end
	local cardSetter = Guest.addRedeemCard(codes, "SECURE REDEEM")
	if Guest.flags.openFeed and not FeedW.Visible then positionFeed() end

	task.spawn(function()
		for i, code in ipairs(codes) do
			Guest.setStatus(("secure %d/%d: %s"):format(i, #codes, code), "busy")
			cardSetter(i, "sending")
			local ok, resp = Guest.redeem.submit(code)
			local success = ok and type(resp) == "table" and (resp.success or resp.Success)
			if success then
				cardSetter(i, "ok")
				for j = i + 1, #codes do cardSetter(j, "skip") end
				Guest.setStatus(("redeemed: %s  (%d/%d)"):format(code, i, #codes), "ok")
				return
			end
			cardSetter(i, ok and "sent" or "fail")
			if i < #codes then task.wait(0.6) end
		end
		Guest.setStatus(("secure: tried all %d - %s"):format(#codes, table.concat(codes, ", ")), "wait")
	end)
	return true
end

