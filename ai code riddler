-- ============================================================
function Guest.read.traitRanking()
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local traits = Guest.text.requireModule(datas and datas:FindFirstChild("Traits"))
	if type(traits) ~= "table" then return nil end
	local out = {}
	for k, t in pairs(traits) do
		local mult = type(t) == "table" and tonumber(t.MultiplierModifier)
		if mult then
			out[#out+1] = { name = tostring(type(t) == "table" and (t.Display or k) or k), mult = mult }
		end
	end
	if #out == 0 then return nil end
	table.sort(out, function(x, y)
		if x.mult ~= y.mult then return x.mult > y.mult end
		return x.name < y.name
	end)
	return out
end

