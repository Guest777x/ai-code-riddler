-- GAME-DATA DUMP  (feeds the AI's live-state context)
-- ============================================================
Guest.data = {}
Guest.data.sources = {}
Guest.data.words   = {}

function Guest.data.build()
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	if not datas then return "GAME DATA UNAVAILABLE" end

	local out = { "GAME: Steal a Brainrot (creator group: BRAZILIAN SPYDER)" }
	local latestTs, latestName = -math.huge, nil

	local shared = ReplicatedStorage:FindFirstChild("Shared")
	shared = shared and Guest.text.requireModule(shared:FindFirstChild("Updates"))
	local hasUpdates = type(shared) == "table" and type(shared.List) == "table"

	if hasUpdates then
		for k, u in pairs(shared.List) do
			local ts = type(u) == "table" and tonumber(u.UnixTimeStamp) or nil
			if ts and ts > latestTs then latestTs, latestName = ts, tostring(k) end
		end
	end
	if latestName then out[#out+1] = "LATEST UPDATE: " .. latestName end

	local mutations = Guest.text.requireModule(datas:FindFirstChild("Mutations"))
	if mutations then
		local line = {}
		for k, m in pairs(mutations) do
			if type(m) == "table" then
				local mod = tonumber(m.Modifier)
				line[#line+1] = ("%s=%s=%s"):format(tostring(k), tostring(m.DisplayText or k), mod and tostring(1+mod) or "?")
			end
		end
		table.sort(line)
		out[#out+1] = "MUTATIONS_RAW: " .. table.concat(line, "|")

		local rar = {}
		for k in pairs(mutations) do rar[#rar+1] = k end
		table.sort(rar)
		out[#out+1] = "RARITIES: " .. table.concat(rar, ", ")
	end

	local traits = Guest.text.requireModule(datas:FindFirstChild("Traits"))
	if traits then
		local line = {}
		for k, t in pairs(traits) do
			local mult = type(t) == "table" and t.MultiplierModifier or nil
			line[#line+1] = mult and (tostring(k) .. "(x" .. tostring(mult) .. ")") or tostring(k)
		end
		table.sort(line)
		out[#out+1] = "TRAITS: " .. table.concat(line, ", ")
	end

	local animals = Guest.text.requireModule(datas:FindFirstChild("Animals"))
	if animals then
		local interesting = { Secret = true, Rainbow = true, Divine = true, OG = true }
		local byRarity, latest = {}, {}
		local maxPrice, maxIncome = { n="?", v=-1 }, { n="?", v=-1 }
		local total = 0

		for _, a in pairs(animals) do
			if type(a) == "table" and a.DisplayName then
				local rarity = tostring(a.Rarity or "Unknown")
				local display = a.DisplayName
				local price   = tonumber(a.Price)
				local income  = tonumber(a.Generation)
				byRarity[rarity] = byRarity[rarity] or {}

				local src = type(a.ObtainedFrom) == "table" and type(a.ObtainedFrom.Source) == "string" and a.ObtainedFrom.Source or nil
				local stamp = nil
				if latestName and _G.__GuestGetConstants and type(a.IsEnabled) == "function" then
					local ok, consts = pcall(_G.__GuestGetConstants, a.IsEnabled)
					if ok and type(consts) == "table" then
						for _, c in pairs(consts) do
							if c == latestName then stamp = latestName; break end
						end
					end
				end

				Guest.extremes.record(rarity, display, price, income, src)

				if src then
					local flat = src:gsub("[^%w]",""):upper()
					if #flat > 5 and flat:sub(-5) == "EVENT" then
						local head = flat:sub(1, #flat - 5)
						if #head >= 3 then Guest.data.sources[head] = flat end
					end
					local parts = {}
					for w in src:gmatch("[%w']+") do
						local up = w:gsub("[^%w]",""):upper()
						if up ~= "" and up ~= "?" then parts[#parts+1] = up end
					end
					if #parts > 1 then Guest.data.words[flat] = parts end
				end

				local entry = display
				if interesting[rarity] and (price or income) then
					entry = ("%s($%s, %s/s)"):format(display, tostring(price or "?"), tostring(income or "?"))
				end
				if src then entry = entry .. " <- " .. src end
				if stamp then
					entry = entry .. " [" .. stamp .. "]"
					latest[#latest+1] = ("%s [%s; source=%s; $%s; %s/s]"):format(display, rarity, tostring(src or "unknown"), tostring(price or "?"), tostring(income or "?"))
				end
				table.insert(byRarity[rarity], entry)

				if price and price > maxPrice.v then maxPrice = { n = display, v = price } end
				if income and income > maxIncome.v then maxIncome = { n = display, v = income } end
				total = total + 1
			end
		end

		local rarKeys = {}
		for k in pairs(byRarity) do rarKeys[#rarKeys+1] = k end
		table.sort(rarKeys)
		out[#out+1] = ("BRAINROTS_BY_RARITY: %d"):format(total)
		for _, r in ipairs(rarKeys) do
			table.sort(byRarity[r])
			out[#out+1] = ("  [%s] %s"):format(r, table.concat(byRarity[r], ", "))
		end

		if #latest > 0 then
			table.sort(latest)
			out[#out+1] = ("LATEST UPDATE BRAINROTS (%s, %d): "):format(latestName, #latest) .. table.concat(latest, ", ")
		end

		local incomeRank = {}
		for _, a in pairs(animals) do
			if type(a) == "table" and a.DisplayName and tonumber(a.Generation) then
				incomeRank[#incomeRank+1] = { name = a.DisplayName, gen = tonumber(a.Generation), price = tonumber(a.Price) }
			end
		end
		table.sort(incomeRank, function(x,y) return x.gen > y.gen end)

		local function shortNum(n)
			if not n then return "?" end
			for _, p in ipairs({ {1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"} }) do
				if p[1] <= n then return ("%.4g%s"):format(n / p[1], p[2]) end
			end
			return tostring(n)
		end

		local top = {}
		for i = 1, math.min(12, #incomeRank) do
			local a = incomeRank[i]
				top[#top+1] = ("%s(%s/s, costs %s)"):format(a.name, shortNum(a.gen), shortNum(a.price))
		end
		if #top > 0 then out[#out+1] = "TOP_INCOME: " .. table.concat(top, ", ") end

		out[#out+1] = ("MOST EXPENSIVE BRAINROT: %s ($%s). HIGHEST INCOME BRAINROT: %s (%s/s)."):format(
			maxPrice.n, tostring(maxPrice.v), maxIncome.n, tostring(maxIncome.v)
		)
		out[#out+1] = Guest.extremes.summary()
	end

	local controllers = ReplicatedStorage:FindFirstChild("Controllers")
	local evController = controllers and controllers:FindFirstChild("EventController")
	local evList = evController and evController:FindFirstChild("Events")
	if evList then
		local list = {}
		for _, ch in ipairs(evList:GetChildren()) do list[#list+1] = ch.Name end
		table.sort(list)
		out[#out+1] = "ALL EVENT MODULES PRESENT IN THE GAME FILES (includes removed ones): " .. table.concat(list, ", ")
	end

	if shared and type(shared.List) == "table" then
		local list = {}
		for k, u in pairs(shared.List) do
			local ts = type(u) == "table" and tonumber(u.UnixTimeStamp) or 0
			list[#list+1] = { key = tostring(k), ts = ts }
		end
		table.sort(list, function(x,y) return x.ts < y.ts end)
		local names = {}
		for _, r in ipairs(list) do names[#names+1] = r.key end
		if #names > 0 then out[#out+1] = "UPDATE SCHEDULE (oldest -> newest): " .. table.concat(names, ", ") end
	end

	local bee = Guest.text.requireModule(datas:FindFirstChild("BeeMerchantData"))
	if type(bee) == "table" and type(bee.Brainrots) == "table" then
		local line = {}
		for _, b in ipairs(bee.Brainrots) do
			if type(b) == "table" and b.Brainrot then
				line[#line+1] = ("%s (Honey=%s, stock=%s, Robux=%s, product=%s)"):format(
					tostring(b.Brainrot), tostring(b.Price or "?"), tostring(b.Stock or "?"),
					tostring(b.RobuxPrice or "?"), tostring(b.ProductId or "?")
				)
			end
		end
		if #line > 0 then
			Guest.data.beeLine = "BEE MERCHANT (currency: Honey): " .. table.concat(line, ", ")
			out[#out+1] = Guest.data.beeLine
		end
	end

	local rebirths = Guest.text.requireModule(datas:FindFirstChild("Rebirths"))
	if type(rebirths) == "table" and type(rebirths.Brainrots) == "table" then
		local tacoPrices = {}
		pcall(function()
			local flagMod = Guest.text.requireModule(ReplicatedStorage.Shared.Flags.TacoMerchantFlags)
			local val = flagMod.TacoPrices.Value
			if type(val) == "table" then
				for k, v in pairs(val) do tacoPrices[tostring(k)] = tonumber(v) end
			end
		end)

		local animalsIdx = {}
		local aMod = Guest.text.requireModule(datas:FindFirstChild("Animals"))
		if type(aMod) == "table" then
			for _, a in pairs(aMod) do
				if type(a) == "table" and a.DisplayName then animalsIdx[a.DisplayName] = a end
			end
		end

		local rows = {}
		for _, b in ipairs(rebirths.Brainrots) do
			if type(b) == "table" and b.Brainrot then
				local name = tostring(b.Brainrot)
				rows[#rows+1] = {
					name = name,
					data = animalsIdx[name] or {},
					tacos = tacoPrices[name] or tonumber(b.TacoPrice) or 0,
					robux = (tonumber(b.ProductId) or 0) > 0,
				}
			end
		end
		table.sort(rows, function(x,y) return x.tacos < y.tacos end)

		local line = {}
		for _, r in ipairs(rows) do
			line[#line+1] = ("%s (%s Tacos, %s, income %s/s, price %s%s)"):format(
				r.name, tostring(r.tacos), tostring(r.data.Rarity or "?"),
				tostring(r.data.Generation or "?"), tostring(r.data.Price or "?"),
				r.robux and ", robux option" or ""
			)
		end
		if #line > 0 then
			Guest.data.tacoLine = ("TACO MERCHANT (Taco Tuesday stall, pays in TACOS, open right now: %s; cheapest first): %s. CHEAPEST = %s. BEST / MOST EXPENSIVE / HIGHEST INCOME = %s."):format(
				ReplicatedStorage:GetAttribute("TacoMerchantEvent") == true and "YES" or "NO",
				table.concat(line, ", "), rows[1].name, rows[#rows].name
			)
			out[#out+1] = Guest.data.tacoLine
		end
	end

	local rngData = Guest.text.requireModule(datas:FindFirstChild("RNGMachineData"))
	local rngCfg = Guest.cache.rngMachineConfig()
	local rngLines = {}
	if type(rngData) == "table" and rngData.DisplayRotations ~= nil then
		rngLines[#rngLines+1] = "DisplayRotations=" .. tostring(rngData.DisplayRotations)
	end
	if type(rngCfg) == "table" then
		if type(rngCfg.SpinCosts) == "table" then
			local tmp = {}
			for k, v in pairs(rngCfg.SpinCosts) do
				if tonumber(k) and tonumber(v) then tmp[#tmp+1] = { tier = tonumber(k), cost = tonumber(v) } end
			end
			table.sort(tmp, function(x,y) return x.tier < y.tier end)
			local parts = {}
			for _, r in ipairs(tmp) do parts[#parts+1] = ("tier %d=$%s"):format(r.tier, tostring(r.cost)) end
			if #parts > 0 then rngLines[#rngLines+1] = "SpinCosts{" .. table.concat(parts, ", ") .. "}" end
		end
		if tonumber(rngCfg.SpeedSpinCostMultiplier) then
			rngLines[#rngLines+1] = "SpeedSpinCostMultiplier=" .. tostring(rngCfg.SpeedSpinCostMultiplier)
		end
		if rngCfg.ShowResultOdds ~= nil then
			rngLines[#rngLines+1] = "ShowResultOdds=" .. tostring(rngCfg.ShowResultOdds)
		end
	end
	if #rngLines > 0 then out[#out+1] = "RNG MACHINE CONFIG: " .. table.concat(rngLines, "; ") end

	if type(rngCfg) == "table" and type(rngCfg.SkillTree) == "table" then
		local skills = {}
		for k, s in pairs(rngCfg.SkillTree) do
			if type(s) == "table" then
				local lv = {}
				for k2, node in pairs(s) do
					if tonumber(k2) and type(node) == "table" then
						lv[#lv+1] = { level = tonumber(k2), node = node }
					end
				end
				table.sort(lv, function(x,y) return x.level < y.level end)
				local lines = {}
				for _, r in ipairs(lv) do
					local kv = {}
					for k2, v in pairs(r.node) do
						local t = type(v)
						if t == "string" or t == "number" or t == "boolean" then
							kv[#kv+1] = tostring(k2) .. "=" .. tostring(v)
						end
					end
					table.sort(kv)
					lines[#lines+1] = ("L%d{%s}"):format(r.level, table.concat(kv, ","))
				end
				skills[#skills+1] = tostring(k) .. ": " .. table.concat(lines, ", ")
			end
		end
		table.sort(skills)
		if #skills > 0 then out[#out+1] = "RNG MACHINE SKILL TREE: " .. table.concat(skills, " | ") end
	end

	local syncCache = Guest.cache.synchronizedPlayer()
	if type(syncCache) == "table" then
		local function keysOf(t)
			if type(t) ~= "table" then return nil end
			local ks = {}
			for k in pairs(t) do ks[#ks+1] = tostring(k) end
			table.sort(ks)
			return #ks > 0 and table.concat(ks, ",") or nil
		end
		local parts = {}
		local be, rngm = keysOf(syncCache.BeeEvent), keysOf(syncCache.RNGMachine)
		if be then parts[#parts+1] = "BeeEvent{" .. be .. "}" end
		if rngm then parts[#parts+1] = "RNGMachine{" .. rngm .. "}" end
		if #parts > 0 then out[#out+1] = "SYNCHRONIZER CACHED UPDATE DATA (schema only): " .. table.concat(parts, "; ") end
	end

	local mods = {}
	for _, ch in ipairs(datas:GetChildren()) do
		if ch:IsA("ModuleScript") then mods[#mods+1] = ch.Name end
	end
	table.sort(mods)
	out[#out+1] = ("ALL DATA MODULES PRESENT (%d): "):format(#mods) .. table.concat(mods, ", ")

	local function describeItem(v)
		if type(v) == "table" then
			local n = v.DisplayName or v.Name or v.Title
			if type(n) == "string" then return n end
			if v.Price or v.Cost then return "price " .. tostring(v.Price or v.Cost) end
			return nil
		end
		if type(v) == "string" or type(v) == "number" then return tostring(v) end
	end

	for _, modName in ipairs({
		"LuckyBlocks","Shop","ShopItems","RodsShopItems","Items","Bases","EggrotZoneNames",
		"ExtinctMachine","FuseMachineData","RNGMachineData","RNGMachineLimitedStockData",
		"MerchantData","CandyMerchantData","SantaMerchantData","MerchShopData","JumpShopData",
		"ValentinesShop","BeeMerchantData","TacoMerchantData","UnlockBase","Rarities",
	}) do
		local m = Guest.text.requireModule(datas:FindFirstChild(modName))
		if type(m) == "table" then
			local line, n = {}, 0
			for k, v in pairs(m) do
				n = n + 1
				if n <= 200 then
					local d = describeItem(v)
					local key = tostring(k)
					line[#line+1] = d and d ~= key and (key .. " (" .. d .. ")") or key
				end
			end
			if #line > 0 then
				table.sort(line)
				out[#out+1] = modName:upper() .. ": " .. table.concat(line, ", ") .. (n > 200 and (" ...(+%d more)"):format(n - 200) or "")
			end
		end
	end

	local muts = Guest.text.requireModule(datas:FindFirstChild("Mutations"))
	if type(muts) == "table" then
		local tiers = {}
		for k, v in pairs(muts) do
			local lvl = tonumber(k) or (type(v) == "table" and tonumber(v.RebirthNumber))
			if lvl and type(v) == "table" then
				tiers[#tiers+1] = { lvl = lvl, need = type(v.Requirements) == "table" and v.Requirements.Cash or nil }
			end
		end
		table.sort(tiers, function(x,y) return x.lvl < y.lvl end)
		local line = {}
		for _, t in ipairs(tiers) do
			line[#line+1] = t.need and ("R%d needs $%s"):format(t.lvl, tostring(t.need)) or ("R%d"):format(t.lvl)
		end
		if #line > 0 then out[#out+1] = ("REBIRTH TIERS (%d total): %s"):format(#tiers, table.concat(line, ", ")) end
	end

	local extinct = Guest.text.requireModule(datas:FindFirstChild("ExtinctMachine"))
	if type(extinct) == "table" and extinct.Output then
		local inputs = {}
		if type(extinct.Inputs) == "table" then
			for k, v in pairs(extinct.Inputs) do
				inputs[#inputs+1] = tostring(type(v) == "string" and v or k)
			end
			table.sort(inputs)
		end
		out[#out+1] = ("EXTINCT_RECIPE: %s -> %s"):format(table.concat(inputs, " + "), tostring(extinct.Output))
	end

	local sh = ReplicatedStorage:FindFirstChild("Shared")
	if sh then
		local soccer = Guest.text.requireModule(sh:FindFirstChild("LiveSoccerTeams"))
		if type(soccer) == "table" then
			local rows = {}
			for k, v in pairs(soccer) do
				local n = tonumber(k)
				if n and type(v) == "string" then rows[#rows+1] = { n = n, name = v } end
			end
			table.sort(rows, function(x,y) return x.n < y.n end)
			local line = {}
			for _, r in ipairs(rows) do line[#line+1] = r.n .. "=" .. r.name end
			if #line > 0 then out[#out+1] = ("SOCCER_TEAMS: %d | "):format(#line) .. table.concat(line, ", ") end
		end

		local skins = Guest.text.requireModule(sh:FindFirstChild("BaseSkins"))
		if type(skins) == "table" then
			local function join(t)
				if type(t) ~= "table" then return nil end
				local parts = {}
				for k, v in pairs(t) do parts[#parts+1] = tostring(type(v) == "string" and v or k) end
				table.sort(parts)
				return #parts > 0 and table.concat(parts, ", ") or nil
			end
			local ev, paid = join(skins.EventBaseSkins), join(skins.PaidBaseSkins)
			if ev   then out[#out+1] = "EVENT BASE SKINS: " .. ev end
			if paid then out[#out+1] = "PAID BASE SKINS: "  .. paid end
		end
	end

	return table.concat(out, "\n")
end

