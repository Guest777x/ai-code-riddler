-- Reducer so we don't process the same message twice inside 0.25s
do
	local lastText, lastAt = nil, 0
	local function handleOnce(...)
		local args = table.pack(...)
		local text = tostring(... or "")
		if #text < 8 then return end
		local now = os.clock()
		if text == lastText and now - lastAt < 0.25 then return end
		lastText, lastAt = text, now
		pcall(Guest.handleMessage, table.unpack(args, 1, args.n))
	end
	Guest._handleOnce = handleOnce
end

function Guest.handleMessage(...)
	local text = Guest.text.stripTags(tostring(... or ""))
	if text == "" then return end

	Guest.state.recent[#Guest.state.recent+1] = { t = os.time(), text = text }
	while #Guest.state.recent > 60 do table.remove(Guest.state.recent, 1) end

	-- Pull the brainrot name and its context out of the message
	local padded = " " .. text:lower():gsub("[^%w]+", " ") .. " "
	local animal = Guest.findAnimal(text)
	local propertyHit = false
	for _, w in ipairs({
		" colou?r"," name "," date "," day "," month "," og "," how many "," how much ",
		" exist"," plus "," my "," what "," which "," who "," when "," where ",
		" income "," age "," and "," mutation"," trait"," gen "," generation ",
		" mps "," value "," price "," speed "," tier "," fav "," favo"," birthday ",
		" cost "," worth "," count ",
	}) do
		if padded:find(w, 1) then propertyHit = true; break end
	end
	if not propertyHit and not animal and Guest.classify.run(text) == "riddle" then propertyHit = true end

	local announce = not propertyHit and (padded:find("%d+ %a+ codes? ") or padded:find(" codes? for ", 1)
		or padded:find(" doing %a+ codes? ") or padded:find(" code ") or padded:find(" codes "))
	if announce then Guest.state.announcementOnly = text end

	if animal then
		local flatAnimal = " " .. animal:lower():gsub("[^%w]+", " ")
		local pos = padded:find(flatAnimal, 1, true)
		local digitNear = (pos and padded:sub(math.max(1, pos - 18), pos) or ""):find("%d") ~= nil
		local trailing = pos and padded:sub(pos + #flatAnimal, pos + #flatAnimal + 13) or ""
		local prizeHint =
			trailing:find("^s? codes? ") ~= nil or trailing:find("^ codes? ") ~= nil
			or padded:find(" doing ", 1, true) or padded:find(" giv", 1, true)
			or padded:find(" stock", 1, true) or padded:find(" prize", 1, true)
			or padded:find(" reward", 1, true) or padded:find(" code for ", 1, true)
			or padded:find(" code is for ", 1, true) or padded:find(" codes for ", 1, true)
			or padded:find(" riddle for ", 1, true) or padded:find(" riddle is for ", 1, true)
			or padded:find(" win ", 1, true) or padded:find(" winner", 1, true)
			or padded:find(" for a ", 1, true) or padded:find(" get a ", 1, true)
			or padded:find(" gets a ", 1, true) or padded:find(" free ", 1, true)
			or padded:find(" drop", 1, true)
		if not prizeHint then
			prizeHint = not propertyHit and (
				padded:find(" next code is ", 1, true) or padded:find(" this code is ", 1, true)
				or padded:find(" code is the ", 1, true)
			)
		end
		local isRiddle = Guest.classify.run(text) == "riddle"
		local isPetOrEgg = animal:lower():find(" pet", 1, true) or animal:lower():find(" egg", 1, true) or animal:lower():find("^egg")

		if digitNear or prizeHint then
			Guest.state.prize = { name = animal, text = text, t = os.time(), prize = true }
			if not propertyHit then Guest.state.announcementOnly = text end
		elseif not isRiddle and not isPetOrEgg and text:find("%d") then
			Guest.state.subject = { name = animal, text = text, t = os.time(), prize = false }
		end
	end

	if Guest.state.announcementOnly == text then
		Guest.state.announcementOnly = nil
		QuestionText.Text = text
		QuestionText.TextColor3 = Guest.theme.sub
		Guest.setStatus("prize noted: " .. tostring(Guest.state.prize and Guest.state.prize.name), "ok")
		return
	end

	QuestionText.Text = text
	QuestionText.TextColor3 = Guest.theme.sub

	-- Auto-arm listen mode the first time we catch a trigger
	if Guest.flags.autoListen and not Guest.flags.listen and Guest.matchTrigger(text) then
		Guest.flags.listen = true
		ListenSetter(true, false)
		refreshListenRow()
		Guest.setStatus("auto-listen armed", "ok")
	end

	if not Guest.flags.listen then return end

	local classified = Guest.classify.run(text)

	-- Duo-mode: leave code messages for the redeemer
	if Guest.flags.duo and _G.__RdmDuo then
		if classified == "code" then
			_G.__SabDropClaim = { text = text, kind = "code", at = os.clock() }
			Guest.setStatus("typed code - left to the redeemer", "wait")
			return
		end
		if classified == "riddle" then
			_G.__SabDropClaim = { text = text, kind = "riddle", at = os.clock() }
		end
	end

	local isSystem, phrase = Guest.isSystemPhrase(text)
	if isSystem then
		isSystem = not (classified == "riddle" and tostring(phrase):find("code", 1, true))
	end
	if isSystem then
		Guest.setStatus("ignored system phrase: " .. tostring(phrase), "wait")
		return
	end

	if not Guest.isAllowedMessage(text) then return end
	QuestionText.TextColor3 = Guest.theme.txt

	if not Guest.flags.ai then
		Guest.setStatus("question caught - AI is OFF", "wait")
		return
	end
	Guest.solve(text, true)
end

-- Wire the notifier if we found it; otherwise sweep up to 400 remotes
do
	local connections = {}

	if Guest.state.notifierFound then
		headerDot.BackgroundColor3 = Guest.theme.ok
		connections[#connections+1] = Guest.state.notifierFound.OnClientEvent:Connect(Guest._handleOnce)
		Guest.state.notifierMapped = true
	else
		local swept = 0
		for _, ch in ipairs(Net:GetChildren()) do
			if ch:IsA("RemoteEvent") or ch:IsA("UnreliableRemoteEvent") then
				swept = swept + 1
				connections[#connections+1] = ch.OnClientEvent:Connect(Guest._handleOnce)
				if swept >= 400 then break end
			end
		end
		Guest.state.notifierMapped = swept > 0
		headerDot.BackgroundColor3 = Guest.state.notifierMapped and Guest.theme.warn or Guest.theme.err
	end
	Guest.state.notifierConnections = connections
end

-- ============================================================
-- AUTO-BUY HEARTBEAT
-- ============================================================
do
	local animalCache = nil
	do
		local ok, mod = pcall(require, ReplicatedStorage.Datas:FindFirstChild("Animals"))
		if ok then animalCache = mod end
	end

	local function shortNum(n)
		local num = tonumber(n)
		if not num then return tostring(n or "---") end
		local abs = math.abs(num)
		for _, p in ipairs({ {1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"} }) do
			if p[1] <= abs then
				local v = num / p[1]
				return string.format(v >= 100 and "%.0f%s" or "%.1f%s", v, p[2])
			end
		end
		return num % 1 == 0 and tostring(math.floor(num)) or string.format("%.1f", num)
	end

	local function stripPrice(s)
		return (tostring(s or ""):gsub("%s*%$?[%d%.,]+%s*[KMBTQaqs]*%s*$", ""):gsub("^%s+",""):gsub("%s+$",""))
	end

	local function findAnimalRecord(name)
		if type(animalCache) ~= "table" or not name or name == "" then return nil end
		if type(animalCache[name]) == "table" then return animalCache[name] end
		for _, a in pairs(animalCache) do
			if type(a) == "table" and type(a.DisplayName) == "string" and a.DisplayName:lower() == name:lower() then
				return a
			end
		end
	end

	local prompts, promptSet = {}, {}
	local connections = {}

	local function isBuyPrompt(obj)
		local text = (tostring(obj.Name) .. " " .. tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)):lower()
		for _, w in ipairs({ "buy","purchase","claim","steal","collect" }) do
			if text:find(w, 1, true) then return true end
		end
		return false
	end

	local function addPrompt(d)
		if d:IsA("ProximityPrompt") then promptSet[d] = true end
	end
	for _, d in ipairs(Workspace:GetDescendants()) do addPrompt(d) end
	connections[#connections+1] = Workspace.DescendantAdded:Connect(addPrompt)
	connections[#connections+1] = Workspace.DescendantRemoving:Connect(function(d) promptSet[d] = nil end)

	local function promptWorldPos(prompt)
		local parent = prompt.Parent
		if not parent then return nil end
		if parent:IsA("Attachment") then return parent.WorldPosition end
		if parent:IsA("BasePart") then return parent.Position end
		local model = parent:FindFirstAncestorOfClass("Model")
		if model then
			local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
			if primary then return primary.Position end
		end
	end

	local function nearestBuyPrompt()
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil, math.huge end
		local best, bestDist = nil, math.huge
		for prompt in pairs(promptSet) do
			if prompt.Parent and prompt.Enabled and isBuyPrompt(prompt) then
				local pos = promptWorldPos(prompt)
				if pos then
					local d = (hrp.Position - pos).Magnitude
					if d < bestDist then best, bestDist = prompt, d end
				end
			end
		end
		return best, bestDist
	end

	local function firePrompt(prompt)
		if not (prompt and prompt.Parent and prompt.Enabled) then return false end
		if type(fireproximityprompt) == "function" then
			return (pcall(fireproximityprompt, prompt))
		end
		return (pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.05) + 0.05)
			prompt:InputHoldEnd()
		end))
	end

	local function describePrompt(prompt)
		local cleaned = stripPrice(prompt.ObjectText ~= "" and prompt.ObjectText
			or prompt.ActionText ~= "" and prompt.ActionText or prompt.Name)
		local model = prompt.Parent and prompt.Parent:FindFirstAncestorOfClass("Model")
		local rec = findAnimalRecord(cleaned)
		if not rec and model then rec = findAnimalRecord(model.Name) end

		local display = rec and rec.DisplayName or cleaned
		local gen = rec and (rec.Generation or rec.Income)
		local rarity = rec and rec.Rarity
		local mutation, trait
		if model then
			mutation = model:GetAttribute("Mutation") or model:GetAttribute("MutationName")
			local t = model:GetAttribute("Traits") or model:GetAttribute("Trait")
			if type(t) == "string" then trait = t end
		end
		return display, gen, rarity, mutation, trait
	end

	local lastFired, lastFireAt = nil, 0
	local tick = 0
	local heartbeat = RunService.Heartbeat:Connect(function(dt)
		tick = tick + dt
		if tick < 0.2 then return end
		tick = 0
		if not Guest.flags.autoBuy and not AutoBuyW.Visible then return end

		local prompt, dist = nearestBuyPrompt()
		if not prompt then
			clearABInfo()
			setABIdle(Guest.flags.autoBuy and "no buy prompt found" or "idle", Guest.flags.autoBuy and "warn" or nil)
			return
		end

		local name, income, rarity, mutation, trait = describePrompt(prompt)
		ABLineName.Text = "Name: " .. tostring(name or "---")
		ABLineIncome.Text = "Income: " .. shortNum(income) .. " /sec"
		ABLineRarity.Text = "Rarity: " .. tostring(rarity or "---")
		ABLineMutation.Text = "Mutation: " .. tostring(mutation or "---")
		ABLineTraits.Text = "Traits: " .. tostring(trait or "---")
		ABDistance.Text = string.format("Distance: %.1f studs", dist)

		if not Guest.flags.autoBuy then
			setABIdle("idle (watching)", nil)
			return
		end

		if dist > (prompt.MaxActivationDistance or 10) + 2 then
			setABIdle("move closer to buy", "warn")
			return
		end
		setABIdle("buying: " .. tostring(name), "ok")

		if prompt ~= lastFired or os.clock() - lastFireAt >= 1.2 then
			lastFired = prompt
			lastFireAt = os.clock()
			task.spawn(function()
				if not firePrompt(prompt) and Guest.flags.autoBuy then
					setABIdle("prompt failed", "err")
				end
			end)
		end
	end)
	Guest.state.autoBuyHeartbeat = heartbeat
	Guest.state.autoBuyConnections = connections
end

-- ============================================================
-- WARM LOOP  (keeps the relay connection alive)
-- ============================================================
do
	_G.__GuestWarmGen = (_G.__GuestWarmGen or 0) + 1
	local gen = _G.__GuestWarmGen
	task.spawn(function()
		if not requestFn then return end
		pcall(Guest.net.warm)
		while task.wait(600) and _G.__GuestWarmGen == gen do
