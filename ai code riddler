-- ============================================================
-- PIN: LIVE MUTATION  (replace a stale mutation name with the live one)
-- ============================================================
function Guest.pinLiveMutation(arg, candidate, isCode)
	if type(candidate) ~= "string" or candidate == "" then return candidate, false end
	local low = tostring(arg or ""):lower()
	if low == "" then return candidate, false end
	if not Guest.topic(arg, "event") then return candidate, false end

	local liveWords = {
		"now","current","right now","at the moment","this second","running",
		"active","we are in","we're in","we in","happening","going on","today","live",
	}
	local blockWords = {
		"was","were","last","previous","before","yesterday","used to","rarest","rare",
		"best","worst","first","oldest","newest","next","will","ever","not running",
		"isn't","is not",
	}
	local function contains(list)
		for _, w in ipairs(list) do if low:find(w, 1, true) then return true end end
		return false
	end
	if not contains(liveWords) then return candidate, false end
	if contains(blockWords) then return candidate, false end

	local live = Guest.read.liveEvents()
	if #live ~= 1 then return candidate, false end
	local liveName = live[1].name
	local target = low:find("mutation", 1, true) and (Guest.eventToMutation[liveName] or liveName) or liveName
	if type(target) ~= "string" or target == "" then return candidate, false end

	local known = {}
	for k, v in pairs(Guest.eventToMutation) do
		known[k:gsub("%W",""):upper()] = true
		known[v:gsub("%W",""):upper()] = true
	end
	local sorted = {}
	for k in pairs(known) do sorted[#sorted+1] = k end
	table.sort(sorted, function(a, b) return #a > #b end)

	local targetFlat = target:gsub("%W",""):upper()
	local candUpper = candidate:upper()
	if candUpper:find(targetFlat, 1, true) then return candidate, false end

	for _, k in ipairs(sorted) do
		if k == targetFlat then
			continue
		end
		local s, e = candUpper:find(k, 1, true)
		if s then
			local replacement = isCode and targetFlat or target
			local updated = candidate:sub(1, s - 1) .. replacement .. candidate:sub(e + 1)
			Guest.state.lastPin = ("%s -> %s (live: %s)"):format(candidate, updated, liveName)
			return updated, true
		end
	end
	return candidate, false
end

-- ============================================================
-- PIN: NEW GEAR
-- ============================================================
function Guest.pinNewGear(arg, candidate, isCode)
	if type(candidate) ~= "string" or candidate == "" then return candidate, false end
	local letters = select(2, candidate:gsub("%a", ""))
	if select(2, candidate:gsub("%d", "")) > 0 and letters <= 2 then return candidate, false end
	local low = tostring(arg or ""):lower()
	if low:find("how many", 1, true) or low:find("count", 1, true) or low:find("total number", 1, true) then
		return candidate, false
	end
	if not (low:find("gear", 1, true) or low:find("tool", 1, true)) then return candidate, false end
	local newer = false
	for _, w in ipairs({ "new","newest","just added","just got added","got added","was added",
		"added to","just came out","latest","this update","in the update" }) do
		if low:find(w, 1, true) then newer = true; break end
	end
	if not newer then return candidate, false end

	local ok, list = pcall(Guest.read.snapshotMeta)
	if not ok or type(list) ~= "table" then return candidate, false end

	local gears = {}
	for _, m in ipairs(list) do
		if m.kind == "gear" and m.name and m.name ~= "" then gears[#gears+1] = m.name end
	end
	if #gears == 0 then return candidate, false end

	local flatCand = candidate:upper():gsub("%W","")
	for _, g in ipairs(gears) do
		if g:upper():gsub("%W","") == flatCand then return candidate, false end
	end

	local hits = {}
	for w in low:gmatch("%a+") do
		if #w >= 4 and w ~= "gear" and w ~= "tool" and w ~= "gears" and w ~= "tools" and w ~= "added" and w ~= "newest" then
			for _, g in ipairs(gears) do
				if not hits[g] and g:lower():find(w, 1, true) then hits[g] = true end
			end
		end
	end
	local picked = {}
	for k in pairs(hits) do picked[#picked+1] = k end
	if #picked == 1 then
		Guest.state.lastGearPin = ("%s -> %s"):format(candidate, picked[1])
		return picked[1], true
	end
	if #gears == 1 then
		Guest.state.lastGearPin = ("%s -> %s"):format(candidate, gears[1])
		return gears[1], true
	end

	local items = ReplicatedStorage:FindFirstChild("Items")
	if items then
		for _, ch in ipairs(items:GetChildren()) do
			if ch:IsA("Tool") and ch.Name:upper():gsub("%W","") == flatCand then return candidate, false end
		end
	end
	Guest.state.lastGearPin = ("%s (not a gear) -> %s"):format(candidate, gears[1])
	return gears[1], true
end

-- ============================================================
-- PIN: NEW META (trait, mutation, lucky block, rarity, fishing rod)
-- ============================================================
function Guest.pinNewMeta(arg, candidate, isCode)
	if type(candidate) ~= "string" or candidate == "" then return candidate, false end
	if candidate:upper() == "YES" or candidate:upper() == "NO" then return candidate, false end
	local letters = select(2, candidate:gsub("%a", ""))
	if select(2, candidate:gsub("%d", "")) > 0 and letters <= 2 then return candidate, false end
	local low = tostring(arg or ""):lower()
	if low == "" then return candidate, false end
	if low:find("how many", 1, true) or low:find("count", 1, true) then return candidate, false end

	local running = { "running","right now","active","currently","happening","going on","we are in","we're in" }
	for _, w in ipairs(running) do if low:find(w, 1, true) then return candidate, false end end

	local newer = false
	for _, w in ipairs({ "new","newest","just added","just got added","got added","was added",
		"added to","just came out","latest","this update","in the update" }) do
		if low:find(w, 1, true) then newer = true; break end
	end
	if not newer then return candidate, false end

	local padded = " " .. low:gsub("[^%w]", " ") .. " "
	local kind = nil
	for _, e in ipairs({
		{ kind = "event",        words = { "event" } },
		{ kind = "trait",        words = { "trait" } },
		{ kind = "mutation",     words = { "mutation" } },
		{ kind = "lucky block",  words = { "lucky block","luckyblock","lucky-block" } },
		{ kind = "rarity",       words = { "rarity","rarities" } },
		{ kind = "fishing rod",  words = { "fishing rod"," rod "," rods " } },
	}) do
		for _, word in ipairs(e.words) do
			if word:sub(1,1) == " " then
				if padded:find(word, 1, true) then kind = e.kind; break end
			else
				if low:find(word, 1, true) then kind = e.kind; break end
			end
		end
		if kind then break end
	end
	if not kind then return candidate, false end

	local ok, list = pcall(Guest.read.snapshotMeta)
	if not ok or type(list) ~= "table" then return candidate, false end
	local names = {}
	for _, m in ipairs(list) do
		if m.kind == kind and m.name and m.name ~= "" then names[#names+1] = m.name end
	end
	if #names == 0 then return candidate, false end

	local flatCand = candidate:upper():gsub("%W","")
	for _, n in ipairs(names) do
		if n:upper():gsub("%W","") == flatCand then return candidate, false end
	end

	local hits, seen = {}, {}
	for w in low:gmatch("%a+") do
		if #w >= 4 and w ~= "added" and w ~= "newest" and w ~= "event" and w ~= "trait"
			and w ~= "mutation" and w ~= "lucky" and w ~= "block" and w ~= "rarity" then
			for _, n in ipairs(names) do
				if not seen[n] and n:lower():find(w, 1, true) then seen[n] = true; hits[#hits+1] = n end
			end
		end
	end
	local choice = #hits == 1 and hits[1] or (#names == 1 and names[1] or nil)
	if not choice then return candidate, false end
	Guest.state.lastMetaPin = ("%s -> %s (%s)"):format(candidate, choice, kind)
	return choice, true
end

-- ============================================================
-- PIN: RARITY / BEST / RAREST / MOST VALUABLE
-- ============================================================
function Guest.pinRarity(arg, candidate, isCode)
	if type(candidate) ~= "string" or candidate == "" then return candidate, false end
	local low = tostring(arg or ""):lower()
	if low == "" then return candidate, false end

	local blockers = { "trait","mutation","event","gear","tool","rebirth","lucky block","rod","rarity tier",
		"exist count","how many exist","exists are there","how many are there",
		"second","third","fourth","fifth","2nd","3rd","5th","next rarest","after the rarest" }
	for _, w in ipairs(blockers) do if low:find(w, 1, true) then return candidate, false end end

	local rarityHits = { "rarest","rarer","least common","hardest to find","most rare" }
	local valueHits  = { "best","most valuable","most valued","highest value","most expensive" }

	local isRarity = false
	for _, w in ipairs(rarityHits) do if low:find(w, 1, true) then isRarity = true; break end end
	local isValue = false
	for _, w in ipairs(valueHits) do
		if low:gsub("beside", " "):find(w, 1, true) then isValue = true; break end
	end
	if not (isRarity or isValue) then return candidate, false end
	if isRarity and isValue then return candidate, false end

	-- Skip if the question already names a specific source
	local sourceWords = { "merchant","shop","taco","secret","admin","brainrot god","common",
		"epic","legendary","mythic","festive","spooky","valentine","easter","summer","honey",
		"patrick","limited","craft","fat sammy","machine","lucky","wheel","bee","sold","buy","from the","stock" }
	for _, w in ipairs(sourceWords) do if low:find(w, 1, true) then return candidate, false end end
	local world = { game=true, whole=true, entire=true, world=true, index=true }
	local skipWorld = false
	for w in low:gmatch("in the (%a+)") do
		if not world[w] then skipWorld = true; break end
	end
	if skipWorld then return candidate, false end

	if not (low:find("brainrot", 1, true) or low:find("animal", 1, true) or low:find("%f[%a]og%f[%A]")) then
		return candidate, false
	end

	local unlocked = {
		"obtain","get","carpet","brainrot track","track","no robux","without robux","free","still available",
	}

	local name
	if isRarity then
		local exotic = { "besides spyder","except spyder","other than spyder","excluding spyder",
			"not spyder","apart from spyder","besides the spyder","except the spyder" }
		local isExotic = false
		for _, w in ipairs(exotic) do if low:find(w, 1, true) then isExotic = true; break end end

		if isExotic then
			local ok, counts = pcall(Guest.read.existCounts)
			if not (ok and type(counts) == "table" and #counts > 0) then return candidate, false end
			name = counts[1].name
		elseif low:find("no robux", 1, true) or low:find("without robux", 1, true) then
			name = "Strawberry Elephant"
		else
			name = "Spyder Elephant"
		end
	else
		local unlockable = false
		for _, w in ipairs(unlocked) do if low:find(w, 1, true) then unlockable = true; break end end
		name = unlockable and "Strawberry Elephant" or "Headless Horseman"
	end

	local flatName = name:upper():gsub("%W","")
	local flatCand = candidate:upper():gsub("%W","")
	if flatCand == flatName then return candidate, false end
	if low:upper():gsub("%W",""):find(flatName, 1, true) then return candidate, false end

	local marker = { " plus "," and ","+"," with "," my "," then ","&","combined"," also " }
	local hasMarker = false
	for _, w in ipairs(marker) do if low:find(w, 1, true) then hasMarker = true; break end end
	if low:find("%d") or hasMarker then
		for _, other in ipairs({ "SPYDERELEPHANT","HEADLESSHORSEMAN","STRAWBERRYELEPHANT" }) do
			if other == flatName then continue end
			local s, e = flatCand:find(other, 1, true)
			if s then
				local updated = flatCand:sub(1, s - 1) .. flatName .. flatCand:sub(e + 1)
				Guest.state.lastRarityPin = ("%s -> %s (spliced)"):format(candidate, updated)
				return updated, true
			end
		end
		return candidate, false
	end

	Guest.state.lastRarityPin = ("%s -> %s"):format(candidate, name)
	return name, true
end

-- ============================================================
-- PIN: NEW BRAINROT  (replace stale name with the current new one)
-- ============================================================
function Guest.pinNewBrainrot(arg, candidate, isCode)
	if type(candidate) ~= "string" or candidate == "" then return candidate, false end
	local letters = select(2, candidate:gsub("%a", ""))
	if select(2, candidate:gsub("%d", "")) > 0 and letters <= 2 then return candidate, false end
	local low = tostring(arg or ""):lower()
	if low == "" then return candidate, false end

	local newer = false
	for _, w in ipairs({ "new","newest","just added","just got added","got added","was added",
		"added to","just came out","latest","this update","in the update" }) do
		if low:find(w, 1, true) then newer = true; break end
	end
	if not newer then return candidate, false end

	local blockers = {
		"rarest","best","worst","first","oldest","og","most expensive","cheapest","highest",
		"lowest","used to","removed","deleted","before","last update","previous","how much",
		"income","per second","per sec","produce","produces","earn","earns","earnings",
		"makes how much","generate","generates","mutation","trait","event","luck",
		"multiplier","boost","weather","rebirth","gear","tool","rarity","rarities","fishing",
	}
	for _, w in ipairs(blockers) do if low:find(w, 1, true) then return candidate, false end end

	local padded = " " .. low:gsub("[^%w]", " ") .. " "
	if padded:find(" rod ", 1, true) or padded:find(" rods ", 1, true) then return candidate, false end

	local news = {}
	for _, e in ipairs(Guest.read.newContent()) do
		if e.enabled and e.name and e.name ~= "" then news[#news+1] = e end
	end
	if #news == 0 then return candidate, false end

	local flatCand = candidate:upper():gsub("%W","")
	for _, e in ipairs(news) do
		if flatCand:find(e.name:upper():gsub("%W",""), 1, true) then return candidate, false end
	end

	local unrelated = false
	for w in low:gmatch("%a+") do
		if #w >= 5 and not ({ new=true, newest=true, added=true, brainrot=true, called=true,
			whats=true, which=true, update=true, released=true, recently=true })[w] then
			local found = false
			for _, e in ipairs(news) do
				if e.name:lower():gsub("%W",""):find(w, 1, true) then found = true; break end
			end
			if not found then unrelated = true end
		end
	end

	if unrelated then
		-- allow candidates that still exist in the game
		local datas = ReplicatedStorage:FindFirstChild("Datas")
		local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
		if type(animals) == "table" then
			local flatUpper = candidate:upper():gsub("%W","")
			for k, a in pairs(animals) do
				if type(a) == "table" then
					local flat = tostring(a.DisplayName or k):upper():gsub("%W","")
					if #flat >= 4 and flatUpper:find(flat, 1, true) then return candidate, false end
				end
			end
		end
	end

	local pick = news[1]
	local m, unit = low:match("(%d+%.?%d*)%s*([mkb])/?s")
	if m and unit then
		local unitScale = unit == "b" and 1e9 or unit == "m" and 1e6 or 1e3
		local target = tonumber(m) * unitScale
		for _, e in ipairs(news) do
			if e.gen and math.abs(e.gen - target) < 1 then pick = e; break end
		end
	end

	local finalName = isCode and pick.name:upper():gsub("%W","") or pick.name
	local candUpper = candidate:upper()
	local bestPos, bestLen = nil, nil
	if type(animals) == "table" then
		for k, a in pairs(animals) do
			if type(a) == "table" then
				local flat = tostring(a.DisplayName or k):upper():gsub("%W","")
				if #flat >= 4 then
					local p = candUpper:find(flat, 1, true)
					if p and (not bestLen or #flat > bestLen) then bestLen, bestPos = #flat, p end
				end
			end
		end
	end

	local updated
	if bestPos then
		updated = candidate:sub(1, bestPos - 1) .. finalName .. candidate:sub(bestPos + bestLen)
	else
		local suffix = candUpper:match("(%d+)$")
		if not suffix then
			for _, a in ipairs({ "SPYDERSAMMY","SAMMY","JANUARY","FEBRUARY","MARCH","APRIL","MAY",
				"JUNE","JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER" }) do
				if #candUpper > #a and candUpper:sub(-#a) == a then suffix = a; break end
			end
		end
		updated = finalName
		if suffix then updated = updated .. candidate:sub(#candidate - #suffix + 1) end
	end
	Guest.state.lastNewPin = ("%s -> %s"):format(candidate, updated)
	return updated, true
end
