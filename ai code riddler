		"best trait","strongest trait","highest trait","worst trait","lowest trait",
		"weakest trait","which trait","what trait gives","trait multiplier","top trait",
	},
}

Guest.wordTopics = { income = { "mps", "gen", "gens" } }
Guest.nowWords   = { "now","current","today","at the moment","this second" }

Guest.topicBlockers = {
	"mutation","trait","event","luck","multiplier","boost","weather","gear",
	"tool","rarity","rarities","fishing","rebirth",
}

function Guest.topic(arg, kind)
	local s = tostring(arg or ""):lower()
	if s == "" then return true end

	if kind == "new" then
		for _, w in ipairs(Guest.topicBlockers) do
			if s:find(w, 1, true) then return false end
		end
		local padded = " " .. s:gsub("[^%w]", " ") .. " "
		if padded:find(" rod ", 1, true) or padded:find(" rods ", 1, true) then return false end
	end

	local list = Guest.topicWords[kind] or {}
	for _, w in ipairs(list) do
		if s:find(w, 1, true) then return true end
		if w:find(" ", 1, true) then
			local cursor, ok = 1, true
			for piece in w:gmatch("%S+") do
				local pos = s:find(piece, cursor, true)
				if not pos then ok = false; break end
				cursor = pos + #piece
			end
			if ok then return true end
		end
	end

	local wordList = Guest.wordTopics[kind]
	if wordList then
		local padded = " " .. s:gsub("[%.%-/]", ""):gsub("[^%w]", " ") .. " "
		for _, w in ipairs(wordList) do
			if padded:find(" " .. w .. " ", 1, true) then return true end
		end
	end

	if kind == "event" then
		for _, w in ipairs(Guest.nowWords) do
			if s:find(w, 1, true) then return true end
		end
	end
	return false
end

-- ============================================================
-- LIVE STATE BUILDER  (this is what gets shipped to the model)
-- ============================================================
function Guest.liveState(arg)
	local out = {}
	local isEvent  = Guest.topic(arg, "event")
	local isLuck   = Guest.topic(arg, "luck")
	local isTrait  = Guest.topic(arg, "trait")
	local isNew    = Guest.topic(arg, "new")
	local isReb    = Guest.topic(arg, "rebirth")
	local isBase   = Guest.topic(arg, "base")
	local isIncome = Guest.topic(arg, "income")
	local isCount  = Guest.topic(arg, "count")
	local isRank   = Guest.topic(arg, "traitrank")
	local isDesc   = Guest.topic(arg, "describe")
	local traitInc = isIncome and Guest.read.traitIncome(arg) or nil

	if isNew and not traitInc then
		local entries = Guest.read.newContent()
		local lines = {}
		for _, e in ipairs(entries) do
			if e.enabled then
				local g = e.gen
				local gs = "?"
				if g then
					if g >= 1e9 then gs = ("%.4gB"):format(g / 1e9)
					elseif g >= 1e6 then gs = ("%.4gM"):format(g / 1e6)
					elseif g >= 1e3 then gs = ("%.4gK"):format(g / 1e3)
					else gs = tostring(g) end
				end
				lines[#lines+1] = ("%s (%s/s, %s%s%s)"):format(
					e.name, gs, e.rarity,
					e.source and (", from the " .. e.source) or "",
					e.stamp and (", " .. e.stamp) or ""
				)
			end
		end
		if #lines > 0 then
			out[#out+1] = "BRAINROTS ADDED IN THE NEWEST UPDATE: " .. table.concat(lines, "; ") ..
				"  <- these are the ONLY brainrots added in the current update. If the question DESCRIBES one (the new dinosaur, the new flower, the new narwhal), first pick its NAME from this list, then answer with THAT entry's income figure copied digit for digit - never round it and never invent a number not on this line."
		end
	end

	if isNew and not traitInc then
		local padded = " " .. arg:lower():gsub("[^%w]", " ") .. " "
		local rarityFilter = nil
		for _, r in ipairs({ "brainrot god","secret","mythic","legendary","epic","rare","common","og" }) do
			if padded:find(" " .. r .. " ", 1, true) then rarityFilter = r; break end
		end
		if rarityFilter then
			local items = Guest.read.newContent()
			local rows = {}
			for _, e in ipairs(items) do
				if e.enabled and tostring(e.rarity or ""):lower() == rarityFilter then
					local g = e.gen
					local gs = "?"
					if g then
						if g >= 1e9 then gs = ("%.4gB"):format(g / 1e9)
						elseif g >= 1e6 then gs = ("%.4gM"):format(g / 1e6)
						elseif g >= 1e3 then gs = ("%.4gK"):format(g / 1e3)
						else gs = tostring(g) end
					end
					rows[#rows+1] = { n = e.name, g = g or 0, s = gs }
				end
			end
			table.sort(rows, function(a, b) return a.g > b.g end)
			if #rows > 0 then
				local parts = {}
				for _, r in ipairs(rows) do parts[#parts+1] = ("%s (%s/s)"):format(r.n, r.s) end
				table.insert(out, 1, ("NEW %s BRAINROTS IN THE NEWEST UPDATE (highest income first): %s.  <- \"the new/newest %s\" is answered from THIS line only; the first entry is the top one."):format(
					rarityFilter:upper(), table.concat(parts, "; "), rarityFilter
				))
			else
				table.insert(out, 1, ("NO %s BRAINROT WAS ADDED IN THE NEWEST UPDATE. Name the most recently added %s you are sure of and offer an ALT."):format(
					rarityFilter:upper(), rarityFilter
				))
			end
		end
	end

	if isNew and not traitInc then
		local list, primed = Guest.read.snapshotNew()
		if #list > 0 then
			local lines = {}
			for _, r in ipairs(list) do
				local h = r.ageHours or 0
				local when
				if h <= 0 then when = "just now"
				elseif h < 24 then when = tostring(h) .. "h ago"
				else local days = math.floor(h / 24); when = tostring(days) .. (days == 1 and " day ago" or " days ago") end
				lines[#lines+1] = ("%s (%s/s, first seen %s)"):format(r.name, Guest.shortNum(r.gen), when)
			end
			local best = list[1]
			for _, r in ipairs(list) do if (r.gen or 0) > (best.gen or 0) then best = r end end
			out[#out+1] = "BRAINROTS THAT CAME OUT RECENTLY, NEWEST FIRST: " .. table.concat(lines, "; ") ..
				("  BEST OF THESE (highest income among the new ones) = %s at %s/s."):format(best.name, Guest.shortNum(best.gen)) ..
				"  <- HOW TO READ THIS LINE, IN THIS ORDER: (1) IF THE RIDDLE DESCRIBES THE BRAINROT AT ALL - an animal, a job, an object, a colour, anything - MATCH THAT DESCRIPTION TO A NAME IN THIS LIST FIRST. The names are literal: a narwhal is Honey Honey Narwhal, a samurai is Syrup Samurai, a dinosaur is Rosatops Triceratino (triceratops), a motorbike is Motorino Bumbino. Never fall back to the highest earner when the riddle described something - that is a DIFFERENT question. (2) ONLY IF the riddle asks for the \"best\", \"strongest\" or \"highest\" with NO description, use the BEST OF THESE value. (3) \"Newest\" or \"latest\" with no description = the FIRST listed. (4) If the riddle asks HOW MUCH one makes, this list is NOT the answer - use the EXACT INCOME line and reply with its number."
		elseif not primed then
			out[#out+1] = "NEW-BRAINROT BASELINE NOT SET YET (first run on this client - nothing can be reported as new)"
		end
		local update = Guest.read.currentUpdate()
		if update then out[#out+1] = "UPDATE THE SERVER IS RUNNING: " .. update end
	end

	local isNewGeneric = tostring(arg or "") == "" 
	if not isNewGeneric then
		for _, w in ipairs(Guest.topicWords.new) do
			if tostring(arg):lower():find(w, 1, true) then isNewGeneric = true; break end
		end
	end
	if isNewGeneric then
		local meta = Guest.read.snapshotMeta()
		if meta and #meta > 0 then
			local lines = {}
			for _, m in ipairs(meta) do lines[#lines+1] = ("%s (%s)"):format(m.name, m.kind) end
			out[#out+1] = "NEW SINCE THE LAST UPDATE (not brainrots): " .. table.concat(lines, "; ") ..
				"  <- newly added traits / mutations / lucky blocks / shop items / events / gears / rarities / fishing rods. \"The new trait\", \"the newest mutation\", \"the new event\", \"the new gear / tool / flying gear\" are answered from THIS line, never from the brainrot list."
		end
	end

	if isReb or isNew then
		for _, r in ipairs(Guest.read.newRebirth()) do
			local facts = {}
			if r.cash then facts[#facts+1] = Guest.shortNum(r.cash) .. " cash" end
			if #r.chars > 0 then facts[#facts+1] = table.concat(r.chars, " + ") end
			out[#out+1] = ("NEWEST REBIRTH: %s (rebirth number %s%s). TO REBIRTH YOU NEED: %s.%s%s"):format(
				r.name, tostring(r.number), r.stamp and (", added " .. r.stamp) or "",
				#facts > 0 and table.concat(facts, " AND ") or "unknown",
				r.reward and ("  Reward: " .. Guest.shortNum(r.reward) .. " cash.") or "",
				r.mult and ("  Cash multiplier becomes " .. tostring(r.mult) .. "x.") or ""
			) .. "  <- this rebirth is NEWER than anything you already know; answer rebirth questions from this line."
		end
		local newItems = Guest.read.newItems()
		if #newItems > 0 then
			local lines = {}
			for _, it in ipairs(newItems) do lines[#lines+1] = ("%s (%s)"):format(it.name, table.concat(it.facts, ", ")) end
			out[#out+1] = "ALSO ADDED IN THE NEWEST UPDATE: " .. table.concat(lines, "; ")
		end
	end

	if Guest.topic(arg, "exist") then
		local counts = Guest.read.existCounts()
		if counts and #counts > 0 then
			local top = {}
			for i = 1, math.min(8, #counts) do
				top[#top+1] = ("%s %s (%d)"):format(
					i == 1 and "1st" or i == 2 and "2nd" or i == 3 and "3rd" or (tostring(i) .. "th"),
					counts[i].name, counts[i].n
				)
			end
			local padded = " " .. tostring(arg or ""):lower():gsub("[^%w]+", " ") .. " "
			local isRankQ = padded:find(" rarest ", 1, true) or padded:find(" rarer ", 1, true)
				or padded:find(" fewest ", 1, true) or padded:find(" lowest ", 1, true)
				or padded:find(" least ", 1, true) or padded:find(" most rare ", 1, true)
				or padded:find(" second ", 1, true) or padded:find(" third ", 1, true)
				or padded:find(" 2nd ", 1, true) or padded:find(" 3rd ", 1, true)
				or padded:find(" hardest to find ", 1, true)
			local hasSubject = Guest.subjectOf(arg) ~= nil
			if isRankQ or not hasSubject then
				out[#out+1] = "RAREST BY EXIST COUNT, live from the game, fewest first: " .. table.concat(top, "; ") ..
					"  <- THE RAREST BRAINROT BY EXIST COUNT IS THE 1st ONE; 2nd rarest = the 2nd entry, 3rd rarest = the 3rd entry. Spyder Elephant is not on this list. Use these numbers exactly; never invent or round an exist count. Spyder Elephant has NO public count."
			end

			local lowerText = tostring(arg or ""):lower()
			local anchorSet = nil
			local anchorText = " " .. lowerText:gsub("[^%w]+", " ") .. " "
			for _, a in ipairs(Guest.animalNames()) do
				local stem = a.flat:sub(1, -2)
				if anchorText:find(a.flat, 1, true) or anchorText:find(stem .. "s ", 1, true) or anchorText:find(stem .. "es ", 1, true) then
					anchorSet = anchorSet or {}
					anchorSet[a.name] = true
				end
			end
			local subject = Guest.subjectOf(arg)
			if subject then
				anchorSet = anchorSet or {}
				anchorSet[subject] = true
				lowerText = lowerText .. " " .. subject:lower()
			end

			local function matches(row)
				if anchorSet then return anchorSet[row.name] == true end
				for w in lowerText:gmatch("%a+") do
					if Guest.nameHit(row.name:lower():gsub("[^%w]",""), w) then return true end
				end
				return false
			end

			local perSubject = {}
			for _, row in ipairs(counts) do
				if matches(row) then perSubject[#perSubject+1] = ("%s = %d exists"):format(row.name, row.n) end
				if #perSubject >= 3 then break end
			end
			if #perSubject > 0 then
				out[#out+1] = "EXIST COUNT FOR THE BRAINROT NAMED IN THIS QUESTION: " .. table.concat(perSubject, "; ") ..
					"  <- the brainrot's TOTAL across all mutations."
			end

			if lowerText:find("1 of 1", 1, true) or lowerText:find("one of one", 1, true)
				or lowerText:find("1/1", 1, true) or lowerText:find("one-of-one", 1, true)
				or lowerText:find("one of a kind", 1, true) then
				local oneOfOne = {}
				for _, row in ipairs(counts) do
					if type(row.muts) == "table" then
						for k, v in pairs(row.muts) do
							if v == 1 and tostring(k) ~= "None" then
								oneOfOne[#oneOfOne+1] = tostring(k) .. " " .. row.name
							end
						end
					end
				end
				table.sort(oneOfOne)
				if #oneOfOne > 0 then
					out[#out+1] = ("OFFICIAL (MUTATION) 1 OF 1s VISIBLE IN LIVE DATA (%d): %s"):format(#oneOfOne, table.concat(oneOfOne, "; ")) ..
						"  <- each is the only brainrot with that name+mutation. For 'how many 1 of 1s exist' the answer is the developer's stated 122, not this count."
				end
			end

			local perBrainrot = {}
			local rowOrder = {}
			for _, row in ipairs(counts) do
				if matches(row) then rowOrder[row.name] = select(2, lowerText:find(row.name:lower():match("%a+") or "", 1, true)) or 999 end
			end
			local rowCount = 0
			for _ in pairs(rowOrder) do rowCount = rowCount + 1 end

			for _, row in ipairs(counts) do
				if matches(row) and type(row.muts) == "table" then
					local mutsList = {}
					for k, v in pairs(row.muts) do
						if type(v) == "number" then
							if v == 1 and tostring(k) ~= "None" then
								mutsList[#mutsList+1] = ("%s 1 (OFFICIAL 1 OF 1)"):format(tostring(k))
							else
								mutsList[#mutsList+1] = ("%s %d"):format(tostring(k), v)
							end
						end
					end
					table.sort(mutsList)

					local named = {}
					local sum = 0
					for k, v in pairs(row.muts) do
						local flat = tostring(k):lower():gsub("[^%w]", "")
						local pos = type(v) == "number" and #flat >= 3 and lowerText:find(flat, 1, true) or nil
						if pos then
							local closest, closestName = nil, nil
							for name, p in pairs(rowOrder) do
								if p > pos and (not closest or p < closest) then closest, closestName = p, name end
							end
							if not closestName then
								for name, p in pairs(rowOrder) do
									if not closest or p > closest then closest, closestName = p, name end
								end
							end
							if rowCount <= 1 or closestName == row.name then
								named[#named+1] = { k = tostring(k), v = v }
								sum = sum + v
							end
						end
					end

					table.sort(named, function(a, b) return a.k < b.k end)

					local labels = {}
					for _, n in ipairs(named) do labels[#labels+1] = n.k end

					perBrainrot[#perBrainrot+1] = {
						fig = #named > 0 and sum or row.n,
						label = #named > 0 and (table.concat(labels, "+") .. " " .. row.name) or row.name,
						pos = lowerText:find(row.name:lower():sub(1, 5), 1, true) or 999,
					}

					if #named == 1 then
						table.insert(out, 1, ("EXACT ANSWER: there are %d %s %s in existence."):format(named[1].v, named[1].k, row.name) ..
							" The question names that mutation, so THIS is the figure - not the brainrot's total.")
					elseif #named >= 2 then
						local parts = {}
						for _, n in ipairs(named) do parts[#parts+1] = ("%s %d"):format(n.k, n.v) end
						local sums = {}
						for _, n in ipairs(named) do sums[#sums+1] = tostring(n.v) end
						table.insert(out, 1, ("EXACT ANSWER: %s %s: %s = %d in total."):format(
							row.name, table.concat(parts, " and "), table.concat(sums, " + "), sum
						) .. " If the question adds them up, the answer is exactly " .. tostring(sum) .. ".")
					end

					local none = type(row.muts.None) == "number" and row.muts.None or 0
					out[#out+1] = ("%s TOTAL %d = %d with NO mutation + %d WITH a mutation."):format(row.name, row.n, none, row.n - none)
					if #mutsList > 0 then
						out[#out+1] = ("%s BY MUTATION: %s."):format(row.name, table.concat(mutsList, ", ")) ..
							(type(row.owners) == "number" and row.owners > 0 and ("  UNIQUE OWNERS: %d."):format(row.owners) or "")
					end
				end
			end

			if #perBrainrot >= 2 then
				table.sort(perBrainrot, function(a, b) return a.pos < b.pos end)
				local parts, sums = {}, {}
				local total = 0
				for _, b in ipairs(perBrainrot) do
					parts[#parts+1] = ("%s %d"):format(b.label, b.fig)
					sums[#sums+1] = tostring(b.fig)
					total = total + b.fig
				end
				local line = ("EXACT ANSWER (%d brainrots named): %s. ADDED TOGETHER: %s = %d."):format(
					#perBrainrot, table.concat(parts, "; "), table.concat(sums, " + "), total
				)
				if #perBrainrot == 2 then
					line = line .. (" DIFFERENCE: %d - %d = %d."):format(perBrainrot[1].fig, perBrainrot[2].fig, perBrainrot[1].fig - perBrainrot[2].fig)
				end
				table.insert(out, 1, line .. " Use these figures as arithmetic; never write them side by side as one number.")
			end
		end
	end

	if isCount then
		local lc = Guest.read.liveCounts()
		if lc then
			local line = {}
			if lc.brainrots then line[#line+1] = ("%d brainrots"):format(lc.brainrots) end
			if lc.traits    then line[#line+1] = ("%d traits"):format(lc.traits) end
			if lc.mutations then line[#line+1] = ("%d mutations"):format(lc.mutations) end
			if lc.maxRebirth then line[#line+1] = ("%d rebirths (the highest is rebirth %d)"):format(lc.maxRebirth, lc.maxRebirth) end
			if #line > 0 then
				out[#out+1] = "EXACT COUNTS IN THE GAME RIGHT NOW: " .. table.concat(line, ", ") ..
					"  <- counted from the game this second. Use these figures and ignore any total you remember."
			end
		end
	end

	local roster = Guest.sourceRoster(arg)
	if roster then
		out[#out+1] = "COMPLETE ROSTER OF THE SOURCE THIS QUESTION NAMES: " .. roster ..
			"  <- the answer to a \"which brainrot from <this source>\" question is ALWAYS one of these exact names - it cannot be anything else."
	end

	if isDesc then
		local names = Guest.nameCandidates(arg)
		if names then
			out[#out+1] = "REAL BRAINROTS WHOSE NAMES SHARE WORDS WITH THIS QUESTION: " .. table.concat(names, "; ") ..
				"  <- every name here EXISTS in the game, copied from the game files. Use one ONLY if it matches EVERY part of the description - a \"vampire duck\" must be both a vampire AND a duck."
		end
	end

	if isRank then
		local ranked = Guest.read.traitRanking()
		if ranked and #ranked > 0 then
			local top = {}
			for i = 1, math.min(8, #ranked) do top[#top+1] = ("%s %sx"):format(ranked[i].name, tostring(ranked[i].mult)) end
			local lowest = ranked[#ranked]
			out[#out+1] = ("TRAIT MULTIPLIERS, READ FROM THE GAME: highest is %s at %sx. Top: %s. Lowest is %s at %sx."):format(
				ranked[1].name, tostring(ranked[1].mult), table.concat(top, ", "), lowest.name, tostring(lowest.mult)
			) .. "  <- these are the live values."
		end
	end

	if isIncome and traitInc then
		out[#out+1] = "EXACT INCOME: " .. traitInc ..
			"  <- use this figure; do not recompute it. THIS LINE OUTRANKS EVERY OTHER LINE."
	end

	if isBase then
		local devBases = Guest.read.devBases()
		if #devBases > 0 then
			local lines = {}
			for _, b in ipairs(devBases) do
				lines[#lines+1] = ("%s is SPAWNED RIGHT NOW%s%s"):format(
					b.event,
					b.skin and (" wearing the " .. b.skin .. " base skin") or "",
					b.timeLeft and (", " .. b.timeLeft .. " left") or ""
				)
			end
			out[#out+1] = "DEVELOPER BASE EVENT: " .. table.concat(lines, "; ") ..
				"  <- when the riddle says \"my base\" it means THIS one. NEVER with the words unknown, unreadable, or none."
		else
			out[#out+1] = "DEVELOPER BASE EVENT: none spawned right now. NEVER write NONE, N/A or UNKNOWN as part of a code; if the riddle names the base event, answer SAMMYSBASE and its usual skin as a best guess."
		end

		local playerBases = Guest.read.bases()
		if #playerBases > 0 then
			local lines = {}
			for _, b in ipairs(playerBases) do
				lines[#lines+1] = ("%s's base, %s skin, tier %s"):format(b.owner or "unknown", b.skin or "no", tostring(b.tier))
			end
			out[#out+1] = "PLAYER BASES IN THIS SERVER: " .. table.concat(lines, "; ") ..
				"  <- these belong to ORDINARY PLAYERS. A riddle asking about \"my base\" is NOT asking about any of these."
		end
	end

	if isEvent or isTrait then
		local live = Guest.read.liveEvents()
		if #live > 0 then
			local names, mutations, traits, dedupe = {}, {}, {}, {}
			local function pushTrait(t)
				if type(t) == "string" and t ~= "" and not dedupe[t] then dedupe[t] = true; traits[#traits+1] = t end
			end
			for _, e in ipairs(live) do
				names[#names+1] = e.timeLeft and ("%s (%s left)"):format(e.name, e.timeLeft) or e.name
				if Guest.eventToMutation[e.name] then mutations[#mutations+1] = Guest.eventToMutation[e.name] end
				pushTrait(Guest.eventToTrait[e.name])
				pushTrait(e.name)
			end
			out[#out+1] = "EVENTS RUNNING RIGHT NOW: " .. table.concat(names, ", ")
			if #mutations > 0 then
				out[#out+1] = "MUTATION RUNNING RIGHT NOW: " .. table.concat(mutations, ", ") ..
					"  <- this is the answer to \"the mutation running now\" / \"the one we are in\""
			else
				out[#out+1] = "MUTATION RUNNING RIGHT NOW: none (the live events above do not grant a mutation)"
			end
			if #traits > 0 then
				out[#out+1] = "TRAIT RUNNING RIGHT NOW: " .. table.concat(traits, " or ") ..
					"  <- this is the answer to \"the trait running now\". Prefer the FIRST spelling."
			else
				out[#out+1] = "TRAIT RUNNING RIGHT NOW: none"
			end
		else
			out[#out+1] = "EVENTS RUNNING RIGHT NOW: none"
			out[#out+1] = "MUTATION RUNNING RIGHT NOW: none"
			out[#out+1] = "TRAIT RUNNING RIGHT NOW: none"
		end
	end

	if isLuck then
		local amount
		for k, v in pairs(ReplicatedStorage:GetAttributes()) do
			local m = tostring(k):match("^(%d+)xServerLuckEvent$")
			if m and v == true then amount = m .. "x"; break end
		end

		local active = PlayerGui:FindFirstChild("ActiveEvents")
		local activeInner = active and active:FindFirstChild("ActiveEvents")
		local luck = activeInner and activeInner:FindFirstChild("Luck")
		local visible = luck and luck.Visible
		local timeLeft
		if visible then
			local lbl = luck:FindFirstChildWhichIsA("TextLabel", true)
			timeLeft = lbl and lbl.Text or nil
		end

		local shown = false
		if amount then
			local s = ("SERVER LUCK RUNNING RIGHT NOW: %s luck (say it as %s)"):format(amount, amount:upper())
			if timeLeft and timeLeft ~= "" then s = s .. (" - %s left"):format(timeLeft) end
			out[#out+1] = s
			shown = true
		elseif visible then
			local img
			for _, d in ipairs(luck:GetDescendants()) do
				if d:IsA("ImageLabel") and d.Image ~= "" then img = d.Image; break end
			end
			local catalog = Guest.text.requireModule(ReplicatedStorage.Datas:FindFirstChild("ServerLuck"))
			local match = nil
			if img and type(catalog) == "table" then
				for _, e in pairs(catalog) do
					if type(e) == "table" and e.Icon and tostring(e.Icon) == img then match = e; break end
				end
			end
			local s = match and match.Id and ("SERVER LUCK RUNNING RIGHT NOW: %s"):format(tostring(match.Id))
				or "SERVER LUCK RUNNING RIGHT NOW: yes (multiplier not readable)"
			if timeLeft and timeLeft ~= "" then s = s .. (" - %s left"):format(timeLeft) end
			out[#out+1] = s
			shown = true
		end
		if not shown then
			out[#out+1] = "SERVER LUCK RUNNING RIGHT NOW: LUCK (no multiplier is active at this moment; if the riddle still asks for \"the luck running\", it has just started - write that part as LUCK, never NONE or NO)"
		end

		local function formatTime(seconds)
			if type(seconds) ~= "number" or seconds <= 0 then return "" end
			seconds = seconds > 1e9 and (seconds - Guest.identity.serverNow()) or seconds
			if seconds <= 0 then return "" end
			return (" - %d:%02d left"):format(math.floor(seconds / 60), math.floor(seconds % 60))
		end

		local fuseLuck, fuseTimer = ReplicatedStorage:GetAttribute("FuseMachineLuck"), ReplicatedStorage:GetAttribute("FuseMachineLuckTimer")
		local fuseActive = (type(fuseLuck) == "number" and fuseLuck > 1) or (type(fuseTimer) == "number" and fuseTimer > 0)
		if fuseActive then
			out[#out+1] = ("FUSE MACHINE LUCK RUNNING RIGHT NOW: %sx%s"):format(tostring(fuseLuck or "?"), formatTime(fuseTimer))
		else
			out[#out+1] = "FUSE MACHINE LUCK RIGHT NOW: FUSELUCK (no fuse machine multiplier is active)"
		end

		local rngLuck, rngTimer = ReplicatedStorage:GetAttribute("RNGMachineLuck"), ReplicatedStorage:GetAttribute("RNGMachineLuckTimer")
		if rngLuck == true or (type(rngTimer) == "number" and rngTimer > 0) then
			out[#out+1] = "RNG MACHINE LUCK RUNNING RIGHT NOW: yes (2x)" .. formatTime(rngTimer)
		else
			out[#out+1] = "RNG MACHINE LUCK RIGHT NOW: RNGLUCK (no RNG machine luck is active)"
		end

		out[#out+1] = "LUCKY BASE EVENT: " .. (ReplicatedStorage:GetAttribute("LuckyBaseEvent") == true and "running right now" or "not running")
		out[#out+1] = "BEE LUCKY BLOCK EVENT: " .. (ReplicatedStorage:GetAttribute("BeeLuckyBlockEvent") == true and "running right now" or "not running")
		out[#out+1] = "  <- \"the luck running right now\" with no machine named means the SERVER LUCK line."
	end

	if isEvent or isLuck or isTrait then
		local flags = {}
		for k, v in pairs(ReplicatedStorage:GetAttributes()) do
			local name = tostring(k)
			if v == true and (name:find("Event") or name:find("Active")) then
				flags[#flags+1] = name
			elseif name == "FuseMachineLuck" and tonumber(v) and tonumber(v) > 1 then
				flags[#flags+1] = ("FuseMachineLuck=%sx"):format(tostring(v))
			end
		end
		if #flags > 0 then table.sort(flags); out[#out+1] = "ACTIVE STATE FLAGS: " .. table.concat(flags, ", ") end

		local tag = tostring(game.Name or ""):match("^%s*(%[.-%])")
		if tag then out[#out+1] = "SERVER EVENT TAG: " .. tag end
	end

	-- Recent message memory
	local helpers = {
		findAnimals = Guest.findAnimals,
		subjectOf   = Guest.subjectOf,
		classify    = Guest.classify.run,
		names       = function()
			if not _G.__GuestPickNames then
				local list = {}
				for _, a in ipairs(Guest.animalNames()) do list[#list+1] = a.name end
				_G.__GuestPickNames = list
			end
			return _G.__GuestPickNames
		end,
	}

	local ok, result, mode = pcall(Guest.pickMemory, arg, Guest.state.recent, os.time(), helpers)
	Guest.state.lastMemory = ok and (tostring(mode) .. ": " .. #result) or ("error: " .. tostring(result))
	if ok and type(result) == "table" and #result > 0 then
		local lines = {}
		for _, m in ipairs(result) do lines[#lines+1] = ("[%s] %s"):format(m.when, m.text) end
		if mode == "relevant" then
			out[#out+1] = "WHAT HE SAID EARLIER THIS EVENT THAT THIS QUESTION POINTS BACK TO, oldest first: " ..
				table.concat(lines, "  //  ") .. "  <- the fact the question needs is in these lines; use it exactly as he said it."
		else
			out[#out+1] = "WHAT THE DEVELOPER ANNOUNCED BEFORE THIS, oldest first: " .. table.concat(lines, "  //  ")
		end
	end

	-- Prize anchor
	local subject, isPrize, anchor = Guest.subjectOf(arg)
	local prize = anchor or Guest.state.prize
	if isPrize and type(prize) == "table" then
		local extra = ""
		pcall(function()
			for _, a in pairs(require(ReplicatedStorage.Datas.Animals)) do
				if type(a) == "table" and a.DisplayName == prize.name then
					local src = type(a.ObtainedFrom) == "table" and a.ObtainedFrom.Source or a.ObtainedFrom
					extra = (" It is %s rarity%s, %s/s."):format(
						tostring(a.Rarity or "?"), src and (", from " .. tostring(src)) or "", tostring(a.Generation or "?")
					)
					break
				end
			end
		end)
		local when
		if os.time() - prize.t < 90 then when = "just now"
		elseif os.time() - prize.t < 600 then when = "a few minutes ago"
		else when = "earlier this event" end

		table.insert(out, 1, ("THE BRAINROT HE MEANS IS %s. He %s \"%s\" %s and has mentioned no other since, so \"the brainrot\", \"the prize\", \"it\" in this riddle = %s (written in a code as %s).%s"):format(
			prize.name:upper(),
			prize.prize and "announced the prize:" or "said",
			prize.text, when,
			prize.name:upper(),
			Guest.codeName(prize.name),
			extra
		))

		local m = tostring(prize.text):match("(%d[%d,%.]*)")
		if m and not prize.prize and (padded:find(" how many ", 1, true) or padded:find(" how much ", 1, true)
			or padded:find(" the number ", 1, true) or padded:find(" that number ", 1, true)) then
			table.insert(out, 1, ("THE NUMBER HE STATED ABOUT %s IS %s (from \"%s\")."):format(prize.name:upper(), m, prize.text))
		end
	end

	if type(Guest.state.prizeTemplate) == "table" and Guest.state.prizeTemplate.riddle == arg
		and os.time() - (Guest.state.prizeTemplate.t or 0) < 30 then
		table.insert(out, 1, ("THE CODE IS ALREADY BUILT EXCEPT ONE PART: %s - where [COLOUR] stands for the single colour word of %s. Replace [COLOUR] with that colour and change NOTHING else."):format(
			Guest.state.prizeTemplate.code, Guest.state.prizeTemplate.name:upper()
		))
	end

	if subject and (padded:find(" color ", 1, true) or padded:find(" colour ", 1, true)
		or padded:find(" colored ", 1, true) or padded:find(" colors ", 1, true)
		or padded:find(" colours ", 1, true) or padded:find(" coloured ", 1, true)) then
		local colour = Guest.colourOf(subject)
		local multi = Guest.findAnimals(arg)

		if #multi > 1 then
			table.sort(multi, function(a, b)
				local pa = padded:find(" " .. a:lower():gsub("[^%w]+", " ") .. " ", 1, true) or 1e9
				local pb = padded:find(" " .. b:lower():gsub("[^%w]+", " ") .. " ", 1, true) or 1e9
				return pa < pb
			end)
			local lines = {}
			for _, n in ipairs(multi) do
				lines[#lines+1] = ("%s IS %s"):format(n:upper(), Guest.colourOf(n) or "UNKNOWN (best guess)")
			end
			table.insert(out, 1, "COLOURS, in the order the riddle names them: " .. table.concat(lines, "; ") .. ".")
		elseif colour then
			if padded:find(" plus ", 1, true) or padded:find(" and ", 1, true) or padded:find(",", 1, true) or padded:find(" then ", 1, true) then
				table.insert(out, 1, ("THE COLOUR OF %s IS %s - that is only the %s part of the code."):format(subject:upper(), colour, subject:upper()))
			else
				table.insert(out, 1, ("THE COLOUR OF %s IS %s. Write it as the single word %s."):format(subject:upper(), colour, colour))
			end
		else
			out[#out+1] = ("NO COLOUR IS KNOWN FOR %s - give your own best guess and offer an ALT."):format(subject:upper())
		end
	end

	if subject and (padded:find(" exist", 1) or padded:find(" how many ", 1, true)) then
		local ok2, counts = pcall(Guest.read.existCounts)
		if ok2 and type(counts) == "table" and #counts > 0 then
			local found = false
			for _, row in ipairs(counts) do
				if row.name == subject then found = true; break end
			end
			if not found then
				table.insert(out, 1, ("%s HAS NO PUBLIC EXIST COUNT."):format(subject:upper()))
			end
		end
	end

	local bestKey = padded:find(" best ", 1, true) or padded:find(" strongest ", 1, true) or padded:find(" top ", 1, true)
	if bestKey then
		local rarity = nil
		for _, r in ipairs({ "brainrot god","secret","mythic","legendary","epic","rare","common" }) do
			if padded:find(" " .. r .. " ", 1, true) then rarity = r; break end
		end
		if rarity then
			local datas = ReplicatedStorage:FindFirstChild("Datas")
			local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
			local rows = {}
			if type(animals) == "table" then
				for _, a in pairs(animals) do
					if type(a) == "table" and a.DisplayName and tostring(a.Rarity or ""):lower() == rarity and (tonumber(a.Generation) or 0) > 0 then
						rows[#rows+1] = { n = a.DisplayName, g = tonumber(a.Generation) }
					end
				end
			end
			table.sort(rows, function(a, b) return a.g > b.g end)
			if #rows > 0 then
				local function shortNum(n)
					if n >= 1e9 then return ("%.4gB"):format(n / 1e9) end
					if n >= 1e6 then return ("%.4gM"):format(n / 1e6) end
					if n >= 1e3 then return ("%.4gK"):format(n / 1e3) end
					return tostring(n)
				end
				local top = {}
				for i = 1, math.min(3, #rows) do
					top[#top+1] = ("%s %s (%s/s)"):format(
						i == 1 and "1st" or i == 2 and "2nd" or "3rd", rows[i].n, shortNum(rows[i].g)
					)
				end
				table.insert(out, 1, ("BEST %s RIGHT NOW, by income, live from the game: %s.  <- the best/strongest %s is the 1st one."):format(
					rarity:upper(), table.concat(top, "; "), rarity
				))
			end
		end
	end

	if Guest.data.tacoLine and (arg:lower():find("taco", 1, true) or arg:lower():find("merchant", 1, true)) then
		out[#out+1] = Guest.data.tacoLine
	end
	if Guest.data.beeLine and (arg:lower():find("bee", 1, true) or arg:lower():find("honey", 1, true) or arg:lower():find("merchant", 1, true)) then
		out[#out+1] = Guest.data.beeLine
	end

	local nyTime = Guest.nyTime()
	out[#out+1] = "CURRENT MONTH: " .. os.date("!%B", nyTime):upper()
	out[#out+1] = "CURRENT YEAR: " .. os.date("!%Y", nyTime)
	out[#out+1] = "TODAY'S DATE (developer's clock, New York time): " .. os.date("!%Y-%m-%d", nyTime)
	out[#out+1] = "DAY OF THE MONTH TODAY: " .. tostring(tonumber(os.date("!%d", nyTime)))

	return table.concat(out, "\n")
end

