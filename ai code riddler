local function stripBooleans(fn, depth)
	if not (fn and setupvalue and getupvalues) then return end
	depth = depth or 1
	local ok, ups = pcall(getupvalues, fn)
	if ok and type(ups) == "table" then
		for k, v in pairs(ups) do
			if type(v) == "boolean" then
				pcall(setupvalue, fn, k, false)
			elseif type(v) == "function" and depth > 0 then
				stripBooleans(v, depth - 1)
			end
		end
	end
end

local function fireAll(signal, ...)
	if not getconnections then return false end
	local ok, conns = pcall(getconnections, signal)
	if not ok or type(conns) ~= "table" or #conns == 0 then return false end
	local args = table.pack(...)
	local fired = false
	for _, c in ipairs(conns) do
		if c.Enabled ~= false then
			local fn = nil
			pcall(function() fn = c.Function end)
			stripBooleans(fn)
			local ok2
			if fn then
				ok2 = pcall(task.spawn, fn, table.unpack(args, 1, args.n))
			else
				ok2 = pcall(function() c:Fire(table.unpack(args, 1, args.n)) end)
			end
			fired = fired or ok2
		end
	end
	return fired
end

function Guest.redeem.viaUI(codeText)
	if not getconnections then return false, "no getconnections" end
	local box = Guest.redeem.findCodeBox()
	if not box then return false, "no codebox" end
	pcall(function()
		box.Text = codeText
		box.Active = true
		box.Selectable = true
	end)
	local btn = Guest.redeem.findConfirm()
	local fired = false
	if btn then
		fired = fireAll(btn.MouseButton1Click) or false
		fired = fireAll(btn.Activated) or fired
	end
	if not fired then
		fired = fireAll(box.FocusLost, true) or fired
	end
	return fired, fired and "sent" or "no submit control"
end

