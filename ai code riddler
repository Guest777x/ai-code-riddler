	local function tokenize(text)
		local out = {}
		for w in (" " .. text:lower():gsub("[^%w']+", " "):gsub("'", "") .. " "):gmatch("%a+") do
			if #w >= 3 and not stopWords[w] then out[#out+1] = normalise(w) end
		end
		return out
	end

	local numberWords = {
		one=1,two=2,three=3,four=4,five=5,six=6,seven=7,eight=8,nine=9,ten=10,
		eleven=11,twelve=12,thirteen=13,fourteen=14,fifteen=15,sixteen=16,seventeen=17,
		eighteen=18,nineteen=19,twenty=20,thirty=30,forty=40,fifty=50,sixty=60,
		seventy=70,eighty=80,ninety=90,hundred=100,thousand=1000,million=1e6,
	}

	local timeWords = {
		min=1,mins=1,minute=1,minutes=1,sec=1,secs=1,second=1,seconds=1,
		hour=1,hours=1,hr=1,hrs=1,h=1,m=1,s=1,pm=1,am=1,x=1,
	}

	local function extractNumbers(text)
		local tokens = {}
		for w in text:lower():gmatch("[%w']+") do tokens[#tokens+1] = w:gsub("'","") end
		local out, i = {}, 1
		while i <= #tokens do
			local tok = tokens[i]
			local pre, digits, suffix = tok:match("^(%a*)(%d+)(%a*)$")
			if digits then
				local nxt, nxt2 = tokens[i+1] or "", tokens[i+2] or ""
				local entry = { value = digits, unit = "", kind = "count" }
				if pre == "times" or suffix == "x" or nxt == "x" then entry.kind = "mult"
				elseif suffix == "m" or suffix == "k" or suffix == "b" or suffix == "t" then
					entry.kind = "money"; entry.unit = normalise(nxt)
				elseif suffix ~= "" and timeWords[suffix] then entry.kind = "add"
				elseif suffix ~= "" then entry.unit = normalise(suffix)
				elseif timeWords[nxt] then entry.kind = "time"
				elseif (nxt == "more" or nxt == "extra") and timeWords[nxt2] then entry.kind = "add"
				elseif nxt == "soon" or nxt == "upcoming" then entry.kind = "soon"; entry.unit = normalise(nxt2)
				else entry.unit = normalise(nxt) end
				out[#out+1] = entry
				i = i + 1
			elseif numberWords[tok] then
				local total, running = 0, 0
				while tokens[i] and (numberWords[tokens[i]] or tokens[i] == "and") do
					local v = numberWords[tokens[i]]
					if v then
						if v == 100 then running = (running == 0 and 1 or running) * 100
						elseif v >= 1000 then total = total + (running == 0 and 1 or running) * v; running = 0
						else running = running + v end
					end
					i = i + 1
				end
				local n = total + running
				if n > 0 then
					out[#out+1] = { value = tostring(n), unit = normalise(tokens[i] or ""), kind = "count" }
				end
			else
				i = i + 1
			end
		end
		return out
	end

	local referenced = false
	for _, phrase in ipairs({
		" i said "," he said "," you said "," said "," i say "," did i say ",
		" earlier "," before "," earlier said "," that prize "," mentioned ",
		" i mentioned "," told "," remember "," last message "," announced ",
		" the one i "," that one "," that brainrot "," the prize "," the reward ",
		" of that "," did i "," i gave "," i give "," i spawned "," i spawn ",
		" i picked "," the color "," i was "," i typed "," i type "," just type",
		" i wrote "," talking about "," stated "," of the reward "," i did ",
		" i just "," last thing ",
	}) do
		if padded:find(phrase, 1, true) then referenced = true; break end
	end

	local lastRef   = padded:find(" last message ", 1, true) or padded:find(" just type", 1, true)
		or padded:find(" just said ", 1, true) or padded:find(" just say ", 1, true)
		or padded:find(" just wrote ", 1, true) or padded:find(" last thing ", 1, true)
	local prizeRef  = padded:find(" the prize ", 1, true) or padded:find(" the reward ", 1, true)
		or padded:find(" codes are for ", 1, true) or padded:find(" code is for ", 1, true)
		or padded:find(" codes for ", 1, true) or padded:find("prize", 1, true)
		or padded:find(" prize ", 1, true)
	local perRef    = padded:find(" per ", 1, true) ~= nil
	local ogRef     = padded:find(" og ", 1, true) ~= nil
	local countRef  = padded:find(" how many ", 1, true) or padded:find(" how much ", 1, true)
		or padded:find(" how old ", 1, true) or padded:find(" how long ", 1, true)
		or padded:find(" amount ", 1, true)

	-- Anchor tokens (names, subject)
	local anchorSet, anchorList = {}, {}
	for _, name in ipairs(helpers.findAnimals and helpers.findAnimals(query) or {}) do
		anchorSet[name] = true
		anchorList[#anchorList+1] = name
	end
	if helpers.subjectOf then
		local s, isPrize = helpers.subjectOf(query)
		if s and isPrize then anchorSet[s] = true; anchorList[#anchorList+1] = s end
	end

	local queryTokens = tokenize(query)
	local anchorTokSet = {}
	for _, name in ipairs(anchorList) do
		for _, tok in ipairs(tokenize(name)) do anchorTokSet[tok] = true end
	end
	local looseTokens = {}
	for _, tok in ipairs(queryTokens) do
		if not anchorTokSet[tok] then looseTokens[#looseTokens+1] = tok end
	end

	local rarityHint  = (padded:find(" mythic ", 1, true) or padded:find(" secret ", 1, true) or padded:find(" og ", 1, true)) and #anchorList == 0
	local numberQ     = padded:match(" how many (%a+) ") or padded:match(" number of (%a+) ")
		or padded:match(" amount of (%a+) ") or padded:match(" how much (%a+) ")
	local numberKey   = numberQ and not stopWords[numberQ] and normalise(numberQ) or nil

	local numericSet = {}
	for pre, digits in padded:gmatch("(%a*) ?(%d+)") do
		if pre ~= "plus" and pre ~= "minus" and pre ~= "times" and pre ~= "x" and pre ~= "divided" and pre ~= "over" then
			numericSet[digits] = true
		end
	end

	local myWords = {}
	for w in padded:gmatch(" my (%a+)") do
		if not stopWords[w] then myWords[#myWords+1] = normalise(w) end
	end

	local hasTime = padded:find(" minute", 1, true) or padded:find(" second", 1, true) or padded:find(" hour", 1, true)
	local hasLuck = padded:find(" luck ", 1, true) or padded:find(" boost", 1, true)
		or padded:find(" multiplier", 1, true) or padded:find(" x ", 1, true)

	if #anchorList > 0 and not referenced and not prizeRef then
		return {}, "specific"
	end

	local function isPetOrEgg(text)
		local l = text:lower()
		return l:find(" pet", 1, true) or l:find(" egg", 1, true) or l:find("^egg")
	end

	local pickIndex = _G.__GuestPickIndex
	if helpers.names then
		local allNames = helpers.names()
		if not pickIndex or pickIndex.n ~= #allNames then
			pickIndex = { n = #allNames, byKey = {} }
			for _, name in ipairs(allNames) do
				if not isPetOrEgg(name) then
					for tok in name:lower():gmatch("%a+") do
						if #tok >= 5 then
							local k = tok:sub(1, 3)
							pickIndex.byKey[k] = pickIndex.byKey[k] or {}
							table.insert(pickIndex.byKey[k], { tok = tok, name = name })
						end
					end
				end
			end
			_G.__GuestPickIndex = pickIndex
		end
	end

	local function pickAnimalsFrom(text)
		local out = {}
		if helpers.findAnimals then
			for _, name in ipairs(helpers.findAnimals(text)) do
				if not isPetOrEgg(name) or text:find(name, 1, true) then
					out[#out+1] = name
				end
			end
		end
		if #out > 0 or not pickIndex then return out end

		local candidates = {}
		for tok in text:lower():gmatch("%a+") do
			if #tok >= 6 then
				local list = pickIndex.byKey[tok:sub(1, 3)] or {}
				for _, cand in ipairs(list) do
					if cand.tok == tok or (cand.tok:sub(1, #tok) == tok and #tok >= 0.7 * #cand.tok) then
						candidates[cand.name] = candidates[cand.name] or {}
						candidates[cand.name][cand.tok] = true
					elseif levenshtein(tok, cand.tok) <= 1 then
						candidates[cand.name] = candidates[cand.name] or {}
						candidates[cand.name][cand.tok] = "typo"
					end
				end
			end
		end

		local out2 = {}
		for name, hits in pairs(candidates) do
			local total, matched, strict = 0, 0, 0
			for tok in name:lower():gmatch("%a+") do
				if #tok >= 5 then
					total = total + 1
					if hits[tok] then
						matched = matched + 1
						if hits[tok] == true then strict = strict + 1 end
					end
				end
			end
			if total > 0 and matched == total and strict > 0 then out2[#out2+1] = name end
		end
		return out2
	end

	local rarityNames = { common=1,rare=1,epic=1,legendary=1,mythic=1,secret=1,og=1,god=1,admin=1 }

	local function isPrizeRef(text)
		return (text:find(" for ", 1, true) or text:find(":", 1, true)) and (text:find("code", 1, true) or text:find("riddle", 1, true))
			or text:find(" for ", 1, true) or text:find("reward", 1, true)
			or text:find("riddle", 1, true) or text:find("code", 1, true)
	end

	local prepared = {}
	for _, entry in ipairs(recentList) do
		if type(entry) == "table" and type(entry.text) == "string" and now - (entry.t or 0) <= 3600 then
			prepared[#prepared+1] = entry
		end
	end

	local merged = {}
	for i, entry in ipairs(prepared) do entry.__k = i end
	table.sort(prepared, function(a, b)
		if (a.t or 0) ~= (b.t or 0) then return (a.t or 0) < (b.t or 0) end
		return a.__k < b.__k
	end)

	local noise = { gg=1,lol=1,ok=1,okay=1,brb=1,back=1,lmao=1,xd=1,nice=1,w=1,l=1,yes=1,no=1 }

	local i = 1
	while i <= #prepared do
		local entry = prepared[i]
		local text, t = entry.text, entry.t
		local low = entry.text:lower()
		if low:find("%.%.%.%s*$") or low:find(":%s*$") or low:find("%sis%s*$") or low:find("?%s*$") then
			for j = i + 1, math.min(i + 3, #prepared) do
				local nxt = prepared[j]
				if (nxt.t or 0) - (entry.t or 0) <= 90 then
					local words = 0
					for _ in nxt.text:gmatch("[%w']+") do words = words + 1 end
					if words <= 3 then
						if not noise[nxt.text:lower():match("^%s*(%a+)%s*$") or ""] then
							text = entry.text .. " " .. nxt.text
							t = nxt.t
							nxt.__merged = true
							break
						end
					end
				end
			end
		end
		if not entry.__merged then merged[#merged+1] = { text = text, t = t } end
		i = i + 1
	end

	local scored = {}
	local rewardSeen = false
	local prizeSeen  = false
	local codeIsFor  = padded:find(" codes are for ", 1, true) or padded:find(" code is for ", 1, true)
		or padded:find(" codes for ", 1, true) or padded:find(" code for ", 1, true)
	local rewardRef  = padded:find(" the reward ", 1, true)

	for idx = #merged, 1, -1 do
		local entry = merged[idx]
		local low = entry.text:lower():gsub("%s+", " ")
		if low ~= compact then
			local animals = pickAnimalsFrom(entry.text)
			local nums    = extractNumbers(entry.text)
			local tokens  = tokenize(entry.text)
			local isPrizeText = isPrizeRef(" " .. low:gsub("[^%w'?]+", " "):gsub("'", "") .. " ")
			local qMark   = entry.text:find("?", 1, true)
			local afterQ  = qMark and (select(2, entry.text:sub(qMark+1):gsub("[%a]+", "")) > 0 or entry.text:sub(qMark+1):find("%d"))
			local firstWord = (" " .. low .. " "):match("^%s*(%a+)")
			local isQuestion = qMark and not afterQ

			if not isQuestion then
				isQuestion = (firstWord == "what" or firstWord == "whats" or firstWord == "which"
					or firstWord == "who" or firstWord == "whos" or firstWord == "when" or firstWord == "where")
					and not qMark
			end

			local classified = helpers.classify and helpers.classify(entry.text) or nil
			local isCodeClaim = classified == "riddle" and low:find(" code", 1, true) ~= nil and not isPrizeText
			local realNums = {}
			for _, n in ipairs(nums) do
				local relevant = n.kind == "count" or n.kind == "money"
					or (n.kind == "add" and hasTime)
					or (n.kind == "mult" and hasLuck)
					or (n.kind == "soon" and numberKey and looseEq(n.unit, numberKey))
				if relevant then realNums[#realNums+1] = n end
			end
			local trivial = #tokens <= 1 and #animals == 0 and #realNums == 0
			local skip = isCodeClaim
			if not skip then skip = isQuestion and not isPrizeText end

			if not skip then
				local score = 0
				local anchorHit = false
				for _, a in ipairs(animals) do
					if anchorSet[a] then score = score + 10; anchorHit = true end
				end

				if #anchorList > 0 and not anchorHit and not prizeRef then
					score = -1
				else
					local matched = {}
					for _, qt in ipairs(looseTokens) do
						for _, entryTok in ipairs(tokens) do
							if not matched[qt] and looseEq(qt, entryTok) then
								score = score + (qt == "brainrot" and 1 or 3)
								matched[qt] = true
								break
							end
						end
					end

					for i = 1, #looseTokens - 1 do
						for j = 1, #tokens - 1 do
							local pair1 = looseEq(looseTokens[i], tokens[j]) and looseEq(looseTokens[i+1], tokens[j+1])
							local pair2 = looseEq(looseTokens[i], tokens[j+1]) and looseEq(looseTokens[i+1], tokens[j])
							if pair1 or pair2 then score = score + 3; break end
						end
					end

					for _, qt in ipairs(looseTokens) do
						local low2 = " " .. entry.text:lower() .. " "
						if low2:find(" the " .. qt, 1, true) or low2:find(" a " .. qt, 1, true) then
							score = score + 2
							break
						end
					end

					for _, my in ipairs(myWords) do
						for own in entry.text:lower():gmatch(" my (%a+)") do
							if looseEq(normalise(own), my) then score = score + 4; break end
						end
					end

					if perRef and (entry.text:lower():find(" im %d+", 1) or entry.text:lower():find(" i am %d+", 1)
						or entry.text:lower():find(" %d+ years", 1) or entry.text:lower():find(" turn%a* %d+", 1)) then
						score = score + 8
					end

					if ogRef then
						for tok in entry.text:lower():gmatch("%a+") do
							if rarityNames[tok] then score = score + 5; break end
						end
					end

					if numberKey then
						for _, n in ipairs(realNums) do
							if n.unit ~= "" and looseEq(n.unit, numberKey) then score = score + 6; break end
						end
						local animalMatchesKey = false
						for _, a in ipairs(animals) do
							if a:lower():find(numberKey, 1, true) then animalMatchesKey = true; break end
						end
						if animalMatchesKey then
							for _, n in ipairs(realNums) do
								if n.unit ~= "" then score = score + 4; break end
							end
						end
					end

					for _, n in ipairs(nums) do
						if numericSet[n.value] then score = score + 8; break end
					end

					if countRef and #realNums > 0 then score = score + 2 end

					if prizeRef and isPrizeText and #anchorList == 0 then
						score = score + 5
						if low:find(" prize", 1, true) or low:find(" reward", 1, true) then score = score + 8 end
						if codeIsFor and low:find("code", 1, true) and low:find("is", 1, true) then score = score + 4 end
						if rewardRef and not rewardSeen then score = score + 4; rewardSeen = true end
					end

					if rarityHint and #animals > 0 then score = score + 5 end
				end

				local age = now - (entry.t or now)
				if score >= 0 then
					scored[#scored+1] = {
						entry = entry,
						score = score,
						age = age,
						isPrize = isPrizeText,
						animals = animals,
						realNums = realNums,
						fact = (#animals > 0 or #realNums > 0 or #tokens >= 2) and not trivial,
					}
					if lastRef and not trivial and not prizeSeen then
						prizeSeen = scored[#scored]
					end
				end
			end
		end
	end

	if prizeSeen then prizeSeen.score = prizeSeen.score + 6 end

	local function summarise(s)
		return {
			when = s.age < 90 and "just now" or s.age < 180 and "a while ago" or "earlier this event",
			text = s.entry.text,
			t    = s.entry.t,
		}
	end

	table.sort(scored, function(a, b)
		if a.score ~= b.score then return a.score > b.score end
		return a.age < b.age
	end)

	local threshold = referenced and 3 or 5
	local top = scored[1] and scored[1].score or 0
	local out = {}
	local pickedPrize = false

	for _, s in ipairs(scored) do
		if s.score >= threshold and s.score >= top * 0.9 then
			if not (prizeRef and s.isPrize and pickedPrize) then
				out[#out+1] = summarise(s)
				if prizeRef and s.isPrize then pickedPrize = true end
			end
			if #out >= 3 then break end
		else
			break
		end
	end

	local mode = "relevant"
	if #out == 0 then
		if not referenced then return {}, "none" end
		if countRef then
			local best = nil
			for _, s in ipairs(scored) do
				if #s.realNums > 0 and (not best or s.age < best.age) then best = s end
			end
			if best then out[1] = summarise(best) end
		end
		if #out == 0 then
			local facts = {}
			for _, s in ipairs(scored) do if s.fact then facts[#facts+1] = s end end
			table.sort(facts, function(a, b) return a.age < b.age end)
			for i = 1, math.min(3, #facts) do out[#out+1] = summarise(facts[i]) end
		end
		mode = #out == 0 and "none" or "fallback"
	end

	table.sort(out, function(a, b) return (a.t or 0) < (b.t or 0) end)
	return out, mode
end

-- ============================================================
-- PRIZE PARTS RESOLVER  ("name + age + colour" -> concatenated code)
-- ============================================================
function Guest.resolvePrizeParts(arg)
	local s = tostring(arg or ""):lower()
		:gsub("^%s*the code is%s*", "")
		:gsub("^%s*code is%s*", "")
		:gsub("^%s*the code will be%s*", "")

	local subject = Guest.subjectOf(s)
	Guest.state.lastPrizeDbg = "subject=" .. tostring(subject)
	if not subject then return nil end
	if #Guest.findAnimals(s) > 1 then
		Guest.state.lastPrizeDbg = "two names"
		return nil
	end

	local hasComma = s:find(",", 1, true) or s:find(" and ", 1, true) or s:find(" plus ", 1, true) or s:find("+", 1, true)
	local padded = " " .. s:gsub("[^%w]+", " ") .. " "
	local countMode = (padded:find(" how many ", 1, true) or padded:find(" how much ", 1, true)) and not Guest.findAnimal(s)

	if not (hasComma or countMode) then
		Guest.state.lastPrizeDbg = "not a list"
		return nil
	end

	local parts = {}
	for chunk in (s .. ","):gmatch("(.-)[,+]") do
		for sub in (chunk .. " and "):gmatch("(.-)%s+and%s+") do
			for piece in (sub .. " plus "):gmatch("(.-)%s+plus%s+") do
				local p = piece:gsub("^%s+",""):gsub("%s+$","")
				if p ~= "" then parts[#parts+1] = p end
			end
		end
	end

	if #parts < 1 or (#parts < 2 and not countMode) then
		Guest.state.lastPrizeDbg = "parts=" .. #parts
		return nil
	end

	local animalData = nil
	pcall(function()
		for _, a in pairs(require(ReplicatedStorage.Datas.Animals)) do
			if type(a) == "table" and a.DisplayName == subject then animalData = a; break end
		end
	end)

	local nowNY = Guest.nyTime()
	local subjectCode = Guest.codeName(subject)
	local out = {}
	local hasColourGap = false

	local subjectTokens = {}
	for w in Guest.fold(subject):gmatch("%a+") do subjectTokens[w] = true end

	local ignoreInParts = {
		the=1,of=1,a=1,an=1,is=1,it=1,its=1,this=1,that=1,one=1,
		brainrot=1,brainrots=1,prize=1,reward=1,pet=1,code=1,
		what=1,whats=1,["over"]=1,["in"]=1,caps=1,all=1,
		colour=1,color=1,colours=1,colors=1,rarity=1,income=1,name=1,
		exist=1,exists=1,count=1,how=1,many=1,much=1,number=1,
		per=1,second=1,make=1,makes=1,earn=1,earns=1,generation=1,
		s=1,plus=1,called=1,does=1,have=1,has=1,his=1,her=1,their=1,
		main=1,body=1,
	}

	local function onlyAllowedWords(text)
		for w in text:gmatch("%a+") do
			if not ignoreInParts[w] and not subjectTokens[w] then return false end
		end
		return true
	end

	local function resolvePart(rawPart)
		local t = " " .. Guest.fold(rawPart):gsub("[^%w]+", " ") .. " "

		if t:find(" sammy ", 1, true) then return "SAMMY" end
		if t:find(" my age ", 1, true) then return "AGE" end
		if t:find(" my cat", 1, true) then return "NOVA" end
		if t:find(" my favou?rite colou?r", 1) or t:find(" my fav colou?r", 1) then return "BLUE" end

		if t:find(" colou?r", 1) then
			if onlyAllowedWords(t) then return Guest.colourOf(subject) end
			local knownColours = {
				grass="GREEN",leaves="GREEN",leaf="GREEN",trees="GREEN",tree="GREEN",frog="GREEN",
				sky="BLUE",ocean="BLUE",sea="BLUE",water="BLUE",
				sun="YELLOW",banana="YELLOW",bananas="YELLOW",lemon="YELLOW",cheese="YELLOW",
				snow="WHITE",clouds="WHITE",cloud="WHITE",milk="WHITE",paper="WHITE",
				blood="RED",fire="RED",tomato="RED",strawberry="RED",apple="RED",rose="RED",
				night="BLACK",coal="BLACK",
				orange="ORANGE",oranges="ORANGE",carrot="ORANGE",pumpkin="ORANGE",
				chocolate="BROWN",dirt="BROWN",mud="BROWN",wood="BROWN",
				pig="PINK",flamingo="PINK",
				grape="PURPLE",grapes="PURPLE",lavender="PURPLE",
			}
			for w in t:gmatch("%a+") do
				if knownColours[w] then return knownColours[w] end
			end
			return nil
		end

		if t:find(" rarity ", 1, true) then
			if not onlyAllowedWords(t) then return nil end
			return animalData and tostring(animalData.Rarity):gsub("[^%w]",""):upper() or nil
		end

		if t:find(" date ", 1, true) or t:find(" day ", 1, true) then
			return tostring(tonumber(os.date("!%d", nowNY)))
		end
		if t:find(" month ", 1, true) then return os.date("!%B", nowNY):upper() end
		if t:find(" year ", 1, true)  then return os.date("!%Y", nowNY) end

		if t:find(" income ", 1, true) or t:find(" per second ", 1, true)
			or t:find(" make", 1, true) or t:find(" earn", 1, true) then
			if not onlyAllowedWords(t) then return nil end
			return animalData and animalData.Generation and ("%d"):format(animalData.Generation) or nil
		end

		local existKey = t:find(" exist", 1) or t:find(" count", 1, true) or t:find(" how many ", 1, true)
		if existKey then
			local function findInCounts()
				local ok, counts = pcall(Guest.read.existCounts)
				if not (ok and type(counts) == "table") then return nil end
				for _, row in ipairs(counts) do
					if row.name == subject and type(row.muts) == "table" then
						for k, v in pairs(row.muts) do
							if tostring(k):lower() ~= "its" and type(v) == "number" and t:find(" " .. tostring(k):lower() .. " ", 1, true) then
								return tostring(v)
							end
						end
					end
				end
				return nil
			end
			local v = findInCounts()
			if v then return v end
		end

		if t:find(" how many ", 1, true) or t:find(" how much ", 1, true) or t:find(" the number ", 1, true) then
			local sub = Guest.state.subject
			local m = type(sub) == "table" and sub.name == subject and not sub.prize and tostring(sub.text):match("(%d[%d,]*)") or nil
			if m then return m:gsub(",", "") end
			local ok, counts = pcall(Guest.read.existCounts)
			if ok and type(counts) == "table" then
				for _, row in ipairs(counts) do
					if row.name == subject then return tostring(row.n) end
				end
			end
		end

		if t:find(" name ", 1, true) or t:find(" called ", 1, true) then
			if not onlyAllowedWords(t) then return nil end
			return subjectCode
		end

		local pronoun = t:find(" the brainrot ", 1, true) or t:find(" the reward ", 1, true)
			or t:find(" it ", 1, true) or t:find(" that one ", 1, true)
		if pronoun then
			local allowed = { what=1,is=1,im=1,i=1,am=1,doing=1,the=1,code=1,codes=1,["for"]=1,of=1,
				it=1,its=1,this=1,that=1,he=1,his=1,one=1,prize=1,brainrot=1,giving=1,away=1,
				which=1,a=1,an=1,gonna=1,be=1,are=1,we=1,you=1,u=1,ur=1,my=1,to=1 }
			local ok = true
			for w in t:gmatch("%a+") do
				if not allowed[w] then ok = false; break end
			end
			if ok then return subjectCode end
		end

		local digitsOnly = t:match("^%s*(%d+)%s*$")
		if digitsOnly then return digitsOnly end

		return nil
	end

	for _, part in ipairs(parts) do
		local resolved = resolvePart(part)
		if not resolved and " " .. Guest.fold(part):gsub("[^%w]+"," ") .. " ":find(" colou?r", 1) and not hasColourGap then
			resolved = "[COLOUR]"
			hasColourGap = true
		end
		if not resolved then
			Guest.state.lastPrizeDbg = "unresolved part: " .. part
			Guest.state.prizeTemplate = nil
			return nil
		end
		out[#out+1] = resolved
	end

	if hasColourGap then
		Guest.state.prizeTemplate = { name = subject, code = table.concat(out), t = os.time(), riddle = arg }
		Guest.state.lastPrizeDbg = "colour gap: " .. table.concat(out)
		return nil
	end

	Guest.state.prizeTemplate = nil
	local code = table.concat(out)
	Guest.state.lastPrizeParts = ("%s -> %s"):format(arg, code)
	return code
end
