Guest.animalNamesCache = nil

function Guest.animalNames()
	if Guest.animalNamesCache then return Guest.animalNamesCache end
	local out = {}
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local ok, animals = pcall(require, datas and datas:FindFirstChild("Animals"))
	if ok and type(animals) == "table" then
		for _, a in pairs(animals) do
			if type(a) == "table" and type(a.DisplayName) == "string" and a.DisplayName:find("%a%a%a") then
				out[#out+1] = {
					name = a.DisplayName,
					flat = " " .. Guest.fold(a.DisplayName):gsub("[^%w]+", " "):gsub("^%s+",""):gsub("%s+$","") .. " ",
				}
			end
		end
		table.sort(out, function(x, y) return #x.flat > #y.flat end)
		if #out > 0 then Guest.animalNamesCache = out end
	end
	return out
end

-- Find ALL animal names in a phrase
function Guest.findAnimals(arg)
	local text = " " .. Guest.fold(arg):gsub("[^%w]+", " ") .. " "
	for k, v in pairs(Guest.aliases) do
		text = text:gsub(" " .. k .. " ", " " .. v .. " ")
	end

	local out, seen = {}, {}
	for _, entry in ipairs(Guest.animalNames()) do
		local stem = entry.flat:sub(1, -2)
		local hit = (not seen[entry.name]) and (
			text:find(entry.flat, 1, true)
			or text:find(stem .. "s ", 1, true)
			or text:find(stem .. "es ", 1, true)
		)
		if hit then
			local dup = false
			for _, prev in ipairs(out) do
				if (" " .. prev:lower() .. " "):find(stem, 1, true) then dup = true; break end
			end
			if not dup then
				seen[entry.name] = true
				out[#out+1] = entry.name
			end
		end
	end
	return out
end

-- Find the FIRST animal name in a phrase
function Guest.findAnimal(arg)
	local text = " " .. Guest.fold(arg):gsub("[^%w]+", " ") .. " "
	for k, v in pairs(Guest.aliases) do
		text = text:gsub(" " .. k .. " ", " " .. v .. " ")
	end
	for _, entry in ipairs(Guest.animalNames()) do
		local stem = entry.flat:sub(1, -2)
		if text:find(entry.flat, 1, true)
			or text:find(stem .. "s ", 1, true)
			or text:find(stem .. "es ", 1, true) then
			return entry.name
		end
	end
	return nil
end

