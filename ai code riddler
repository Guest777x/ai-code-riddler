-- Toggle switch (returns a setter + current value)
function Guest.ui.toggleSwitch(parent, initial, onChange)
	local track = Guest.ui.new("Frame", {
		Size = UDim2.fromOffset(44, 22),
		BackgroundColor3 = initial and Guest.theme.acc or Guest.theme.line,
		BorderSizePixel = 0,
	}, parent)
	Guest.ui.corner(track, 11)

	local knob = Guest.ui.new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.new(0, initial and 25 or 3, 0.5, -8),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, track)
	Guest.ui.corner(knob, 8)

	local state = initial
	local function setter(value, fire)
		if value == state and not fire then return end
		state = value
		Guest.ui.tween(track, 0.16, {
			BackgroundColor3 = value and Guest.theme.acc or Guest.theme.line,
		})
		Guest.ui.tween(knob, 0.16, {
			Position = UDim2.new(0, value and 25 or 3, 0.5, -8),
		}, Enum.EasingStyle.Back)
		if fire and onChange then onChange(value) end
	end

	local click = Guest.ui.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
	}, track)
	click.MouseButton1Click:Connect(function() setter(not state, true) end)

	return setter, function() return state end, track
end

