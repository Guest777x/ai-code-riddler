function Guest.read.newItems()
	local out = {}
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	if not datas then return out end
	local getConstants = _G.__GuestGetConstants
	if not getConstants then return out end

	for _, modName in ipairs({ "ShopItems","Shop","Items","MerchShopData","RodsShopItems" }) do
		local inst = datas:FindFirstChild(modName)
		if inst then
			local mod = Guest.text.requireIfLoaded(inst)
			if type(mod) == "table" then
				for k, v in pairs(mod) do
					if type(v) == "table" and type(v.IsEnabled) == "function" then
						local ok, consts = pcall(getConstants, v.IsEnabled)
						local stamp = nil
						if ok and type(consts) == "table" then
							for _, c in pairs(consts) do
								if type(c) == "string" and c:match("^Update%-") then stamp = c; break end
							end
						end
						if stamp then
							local facts = {}
							if v.Price then facts[#facts+1] = Guest.shortNum(v.Price) .. " " .. tostring(v.Currency or "cash") end
							if v.RebirthRequired then facts[#facts+1] = "needs rebirth " .. tostring(v.RebirthRequired) end
							if v.Description then facts[#facts+1] = tostring(v.Description):sub(1, 60) end
							out[#out+1] = {
								source = inst.Name,
								name   = tostring(v.Name or v.DisplayName or k),
								facts  = facts,
								stamp  = stamp,
							}
						end
					end
				end
			end
		end
	end
	return out
end

-- ============================================================
-- READ: TRAIT + MUTATION INCOME FOR A NAMED BRAINROT
-- ============================================================
function Guest.read.traitIncome(arg)
	local s = tostring(arg or ""):lower()
	if s == "" then return nil end
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	local traits  = Guest.text.requireModule(datas and datas:FindFirstChild("Traits"))
	local muts    = Guest.text.requireModule(datas and datas:FindFirstChild("Mutations"))
	if type(animals) ~= "table" or type(traits) ~= "table" then return nil end

	local function flat(s) return (tostring(s):lower():gsub("[^%w]","")) end

	local function closestMatch(query, pool, nameOf)
		local q = flat(query)
		local best, bestScore = nil, nil
		local function record(name, key, data, score)
			if not bestScore or score > bestScore then
				best, bestScore = { key = key, data = data, name = name }, score
			end
		end

		for k, v in pairs(pool) do
			local n = nameOf(k, v)
			if type(n) == "string" and #n >= 3 then
				local f = flat(n)
				if #f >= 3 then
					if q:find(f, 1, true) then
						record(n, k, v, #f + 100)
					else
						local run = 0
						for i = 1, math.max(1, #q - 5) do
							local l = 0
							while l < #f and q:sub(i+l,i+l) == f:sub(l+1,l+1) do l = l + 1 end
							if l > run then run = l end
						end
						if run >= 6 then record(n, k, v, run) end
					end
				end
			end
		end
		return best
	end

	local hit = closestMatch(s, animals, function(k, v)
		return type(v) == "table" and tostring(v.DisplayName or k) or nil
	end)

	if not hit then
		local candidates = Guest.nameCandidates and Guest.nameCandidates(arg)
		if candidates and #candidates > 0 then
			for k, v in pairs(animals) do
				if type(v) == "table" and tostring(v.DisplayName or k) == candidates[1] then
					hit = { key = k, data = v, name = candidates[1] }
					break
				end
			end
		end
	end

	if hit and (s:find("new",1,true) or s:find("latest",1,true) or s:find("came out",1,true) or s:find("just added",1,true)) then
		local snap = Guest.read.snapshotNew()
		local known = {}
		for _, r in ipairs(snap) do known[r.name] = true end
		if not known[hit.name] then
			local candidates = Guest.nameCandidates and Guest.nameCandidates(arg) or {}
			for _, c in ipairs(candidates) do
				if known[c] then
					for k, v in pairs(animals) do
						if type(v) == "table" and tostring(v.DisplayName or k) == c then
							hit = { key = k, data = v, name = c }
							break
						end
					end
					break
				end
			end
		end
	end

	if not hit then return nil end

	local s2 = s
	local pos = s2:find(hit.name:lower(), 1, true)
	if pos then s2 = s2:sub(1, pos - 1) .. " " .. s2:sub(pos + #hit.name) end

	local foundTraits, seen = {}, {}
	for _ = 1, 4 do
		local h = closestMatch(s2, traits, function(k, v)
			return type(v) == "table" and tostring(v.Display or k) or tostring(k)
		end)
		if h and not seen[h.name] then
			seen[h.name] = true
			foundTraits[#foundTraits+1] = h
			local p = s2:find(h.name:lower(), 1, true)
			if p then s2 = s2:sub(1, p - 1) .. " " .. s2:sub(p + #h.name) else break end
		else break end
	end

	local mutation = nil
	if type(muts) == "table" then
		mutation = closestMatch(s, muts, function(k) return tostring(k) end)
	end

	local baseGen = tonumber(hit.data.Generation)
	if not baseGen then return nil end

	if #foundTraits == 0 and not mutation then
		return ("%s earns %s per second with no trait or mutation applied. Answer with that figure."):format(hit.name, Guest.shortNum(baseGen))
	end

	local notes = {}
	local mult = 1
	if mutation and type(mutation.data) == "table" then
		local m = tonumber(mutation.data.Modifier)
		if m then
			mult = 1 + m
			notes[#notes+1] = ("%s mutation +%s"):format(mutation.name, tostring(m))
		end
	end

	local sleepy = false
	for _, tr in ipairs(foundTraits) do
		if tr.name == "Sleepy" then
			notes[#notes+1] = "Sleepy halves it"
			sleepy = true
		else
			local m = tonumber(tr.data and tr.data.MultiplierModifier)
			if m then
				mult = mult + m
				notes[#notes+1] = ("%s +%s"):format(tr.name, tostring(m))
			end
		end
	end

	local final = baseGen * mult
	if sleepy then final = final * 0.5 end
	return ("%s base income is %s. With %s the multiplier is 1 + %s = %s, giving %s. Answer with the figure only - never append \"/s\" or any unit."):format(
		hit.name, Guest.shortNum(baseGen), table.concat(notes, ", "),
		tostring(mult - 1), tostring(mult), Guest.shortNum(final)
	)
end
