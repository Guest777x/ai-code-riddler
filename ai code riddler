local function runTest(text)
	local fired = Guest.text.trim(text)
	if fired == "" then
		TestStatusLbl.Text = "nothing to send"
		TestStatusLbl.TextColor3 = Guest.theme.err
		return
	end
	if not Guest.flags.ai then
		TestStatusLbl.Text = "AI is OFF — turn it on first"
		TestStatusLbl.TextColor3 = Guest.theme.warn
		return
	end
	if not Guest.flags.listen and not Guest.flags.autoListen then
		TestStatusLbl.Text = "LISTEN and AUTO LISTEN are both off"
		TestStatusLbl.TextColor3 = Guest.theme.warn
		return
	end
	if Guest.state.notifierFound and not Guest.state.notifierMapped and typeof(firesignal) == "function" then
		local ok = pcall(firesignal, Guest.state.notifierFound.OnClientEvent, fired, 5.5, "Sounds.Sfx.Blop", "Top", 2678001507)
		TestStatusLbl.Text = ok and ("fired: " .. fired) or "firesignal failed"
		TestStatusLbl.TextColor3 = ok and Guest.theme.ok or Guest.theme.err
		if ok then return end
	end
	local ok = pcall(Guest.handleMessage, fired, 5.5, "Sounds.Sfx.Blop", "Top", 2678001507)
	TestStatusLbl.Text = ok and ("local test: " .. fired) or "handler error"
	TestStatusLbl.TextColor3 = ok and Guest.theme.ok or Guest.theme.err
end

