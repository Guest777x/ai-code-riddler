-- READ: LIVE COUNTS
-- ============================================================
function Guest.read.liveCounts()
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	if not datas then return nil end

	local function countModule(name)
		local mod = Guest.text.requireModule(datas:FindFirstChild(name))
		if type(mod) ~= "table" then return nil end
		local n = 0
		for _ in pairs(mod) do n = n + 1 end
		return n
	end

	local out = {
		brainrots = countModule("Animals"),
		traits    = countModule("Traits"),
		mutations = countModule("Mutations"),
		rebirths  = countModule("Rebirth"),
	}
	local muts = Guest.text.requireModule(datas:FindFirstChild("Mutations"))
	if type(muts) == "table" then
		local max = 0
		for k, v in pairs(muts) do
			local n = tonumber(type(v) == "table" and v.RebirthNumber or k)
			if n and n > max then max = n end
		end
		if max > 0 then out.maxRebirth = max end
	end
	return out
end

-- ============================================================
-- READ: EXIST COUNTS  (Replion upvalue chain + local cache)
-- ============================================================
function Guest.read.existCounts()
	local ok, replion = pcall(require, ReplicatedStorage.Packages:FindFirstChild("Replion"))
	if not ok or type(replion) ~= "table" then return nil end
	local fn = rawget(replion, "GetGlobalData")
	if type(fn) ~= "function" then return nil end
	local getupvalue = debug and debug.getupvalue or getupvalue
	if type(getupvalue) ~= "function" then return nil end

	local holder = nil
	for i = 1, 13 do
		local ok2, r1, r2 = pcall(getupvalue, fn, i)
		holder = nil
		if ok2 then
			holder = r2 ~= nil and r2 or r1
			if type(holder) == "table" and rawget(holder, "PublicExistCounts") ~= nil then
				break
			end
			holder = nil
		end
	end
	if type(holder) ~= "table" then return nil end

	local public = rawget(holder, "PublicExistCounts")
	if type(public) ~= "table" then return nil end
	local d = rawget(public, "Data")
	local val = type(d) == "table" and rawget(d, "Value") or nil
	if type(val) ~= "table" then return nil end

	local out = {}
	for k, v in pairs(val) do
		local n = type(v) == "table" and rawget(v, "total_exists") or nil
		if type(n) == "number" and type(k) == "string" then
			out[#out+1] = {
				name   = k,
				n      = n,
				muts   = rawget(v, "mutations"),
				owners = rawget(v, "unique_owners"),
			}
		end
	end
	if #out == 0 then
		return Guest.read.existCache and Guest.read.existCache() or nil
	end
	table.sort(out, function(x, y) return x.n < y.n end)

	if writefile then
		local buf = { ("#%d"):format(os.time()) }
		for _, r in ipairs(out) do buf[#buf+1] = r.name .. "\t" .. tostring(r.n) end
		pcall(writefile, ("guest_exists_%s.txt"):format(tostring(game.PlaceId)), table.concat(buf, "\n"))
	end
	return out
end

function Guest.read.existCache()
	if not (readfile and isfile) then return nil end
	local path = ("guest_exists_%s.txt"):format(tostring(game.PlaceId))
	local ok, body = pcall(function()
		if isfile(path) then return readfile(path) end
	end)
	if not ok or type(body) ~= "string" or body == "" then return nil end

	local out, stamp = {}, nil
	for line in body:gmatch("[^\n]+") do
		local h = line:match("^#(%d+)$")
		if h then
			stamp = tonumber(h)
		else
			local name, n = line:match("^(.-)\t(%d+)$")
			if name and n then out[#out+1] = { name = name, n = tonumber(n) } end
		end
	end
	if #out == 0 then return nil end
	if stamp and os.time() - stamp > 2592000 then return nil end
	table.sort(out, function(x, y) return x.n < y.n end)
	out.cachedAt = stamp
	return out
end

-- Prime the exist-count cache on first run (needs the game's Index UI)
Guest.primeExistCounts = (function()
	local primed = false
	return function()
		if primed then return end
		primed = true
		pcall(function()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then return end
			local idxRoot = pg:FindFirstChild("Index")
			local idx = idxRoot and idxRoot:FindFirstChild("Index")
			local lc = pg:FindFirstChild("LeftCenter")
			local lc2 = lc and lc:FindFirstChild("LeftCenter")
			lc2 = lc2 and lc2:FindFirstChild("Buttons")
			lc2 = lc2 and lc2:FindFirstChild("Index")
			if not (idxRoot and idx and lc2 and getconnections) then return end

			local prevEnabled, prevVisible = idxRoot.Enabled, idx.Visible
			local blurPrev = {}
			for _, root in ipairs({ game:GetService("Lighting"), workspace.CurrentCamera }) do
				if root then
					for _, ch in ipairs(root:GetChildren()) do
						if ch:IsA("BlurEffect") or ch:IsA("DepthOfFieldEffect") then
							blurPrev[ch] = ch.Enabled
							ch.Enabled = false
						end
					end
				end
			end
			idxRoot.Enabled = false

			local alive = true
			local conn = RunService.RenderStepped:Connect(function()
				if not alive then return end
				if idxRoot.Enabled then idxRoot.Enabled = false end
				local cam = workspace.CurrentCamera
				for _, root in ipairs({ game:GetService("Lighting"), cam }) do
					if root then
						for _, ch in ipairs(root:GetChildren()) do
							if (ch:IsA("BlurEffect") or ch:IsA("DepthOfFieldEffect")) and ch.Enabled then
								if blurPrev[ch] == nil then blurPrev[ch] = true end
								ch.Enabled = false
							end
						end
					end
				end
			end)

			local function fireIndex()
				for _, c in ipairs(getconnections(lc2.Activated)) do
					pcall(function() c:Fire() end)
				end
			end
			fireIndex()

			task.spawn(function()
				for _ = 1, 20 do
					task.wait(0.25)
					local r = Guest.read.existCounts()
					if r and #r > 0 then break end
				end
				pcall(function()
					if idx.Visible ~= prevVisible then
						fireIndex()
						task.wait(0.35)
					end
					idx.Visible = prevVisible
				end)
				alive = false
				conn:Disconnect()
				pcall(function()
					idxRoot.Enabled = prevEnabled
					for k, v in pairs(blurPrev) do if k and k.Parent then k.Enabled = v end end
				end)
			end)
		end)
	end
end)()

