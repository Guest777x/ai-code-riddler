-- Push a solve card into the feed
function Guest.addSolveCard(question, answer, elapsed, cached, isCode, searched, source)
	if feedEmpty then feedEmpty:Destroy(); feedEmpty = nil end
	feedCount = feedCount + 1
	feedCountLbl.Text = feedCount .. " solved"

	local card = Guest.ui.new("Frame", {
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Guest.theme.panel,
		BorderSizePixel = 0,
		LayoutOrder = -feedCount,
	}, FeedScroll)
	Guest.ui.corner(card, 10)
	Guest.ui.stroke(card, answer and Guest.theme.acc or Guest.theme.err, 1, 0.35)
	Guest.ui.padding(card, 11, 11, 9, 9)
	Guest.ui.new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, card)

	local topRow = Guest.ui.new("Frame", { Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, LayoutOrder = 1 }, card)
	local kind = (searched and "WEB" or "GENERAL")
	if isCode then kind = "CODE" end
	if cached then kind = kind .. " *" end
	local kindLbl = Guest.ui.label(kind, 8, Guest.theme.acc, Guest.font.black, Enum.TextXAlignment.Left, topRow)
	kindLbl.Size = UDim2.new(0.45, 0, 1, 0)
	local meta = Guest.ui.label(("%s   %.2fs"):format(os.date("%H:%M:%S"), elapsed or 0), 8, Guest.theme.sub, Guest.font.medium, Enum.TextXAlignment.Right, topRow)
	meta.Size = UDim2.new(0.55, 0, 1, 0)
	meta.Position = UDim2.new(0.45, 0, 0, 0)

	local qLbl = Guest.ui.label(question, 11, Guest.theme.txt, Guest.font.medium, Enum.TextXAlignment.Left, card)
	qLbl.Size = UDim2.new(1, 0, 0, 0)
	qLbl.AutomaticSize = Enum.AutomaticSize.Y
	qLbl.TextWrapped = true
	qLbl.LayoutOrder = 2

	local ansBox = Guest.ui.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Guest.theme.input,
		Text = answer or "FAILED",
		Font = Guest.font.black,
		TextSize = 12,
		TextColor3 = answer and Guest.theme.accHi or Guest.theme.err,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		TextWrapped = true,
	}, card)
	Guest.ui.corner(ansBox, 7)
	Guest.ui.stroke(ansBox, answer and Guest.theme.acc or Guest.theme.err, 1.2, 0.35)
	Guest.ui.padding(ansBox, 6, 6)

	if answer then
		local actions = Guest.ui.new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 4 }, card)
		Guest.ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, actions)
		local copyBtn = Guest.ui.flatButton("COPY", actions)
		copyBtn.Size = UDim2.new(0.5, -3, 1, 0)
		copyBtn.TextSize = 10
		copyBtn.LayoutOrder = 1
		copyBtn.MouseButton1Click:Connect(function()
			copyBtn.Text = Guest.text.copy(answer) and "COPIED" or "ERR"
			task.delay(0.7, function() if copyBtn.Parent then copyBtn.Text = "COPY" end end)
		end)
		local redeemBtn = Guest.ui.primaryButton("REDEEM", actions)
		redeemBtn.Size = UDim2.new(0.5, -3, 1, 0)
		redeemBtn.TextSize = 10
		redeemBtn.LayoutOrder = 2
		redeemBtn.MouseButton1Click:Connect(function()
			redeemBtn.Text = "..."
			Guest.autoRedeemAnswer(answer)
			redeemBtn.Text = "REDEEM"
		end)
	end

	table.insert(feedCards, card)
	trimCardList()

	if source then
		_G.GuestLastFeedSource = source
	end
end

-- Multi-code redeem card (secure mode tries them all)
local function pushMultiRedeemCard(codes, labelText)
	if feedEmpty then feedEmpty:Destroy(); feedEmpty = nil end
	feedCount = feedCount + 1
	feedCountLbl.Text = feedCount .. " solved"

	local card = Guest.ui.new("Frame", {
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Guest.theme.panel,
		BorderSizePixel = 0,
		LayoutOrder = -feedCount,
	}, FeedScroll)
	Guest.ui.corner(card, 10)
	Guest.ui.stroke(card, Guest.theme.warn, 1, 0.35)
	Guest.ui.padding(card, 11, 11, 9, 9)
	Guest.ui.new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, card)

	local topRow = Guest.ui.new("Frame", { Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, LayoutOrder = 1 }, card)
	local titleLbl = Guest.ui.label(labelText or "REDEEMING", 8, Guest.theme.warn, Guest.font.black, Enum.TextXAlignment.Left, topRow)
	titleLbl.Size = UDim2.new(0.5, 0, 1, 0)
	local timeLbl = Guest.ui.label(os.date("%H:%M:%S"), 8, Guest.theme.sub, Guest.font.medium, Enum.TextXAlignment.Right, topRow)
	timeLbl.Size = UDim2.new(0.5, 0, 1, 0)
	timeLbl.Position = UDim2.new(0.5, 0, 0, 0)

	local rows = {}
	for i, code in ipairs(codes) do
		local row = Guest.ui.new("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = Guest.theme.input,
			BorderSizePixel = 0,
			LayoutOrder = 1 + i,
		}, card)
		Guest.ui.corner(row, 6)
		Guest.ui.padding(row, 8, 8)

		local idx = Guest.ui.label(("%d/%d"):format(i, #codes), 9, Guest.theme.sub, Guest.font.black, Enum.TextXAlignment.Left, row)
		idx.Size = UDim2.fromOffset(30, 24)
		local codeLbl = Guest.ui.label(code, 11, Guest.theme.txt, Guest.font.black, Enum.TextXAlignment.Left, row)
		codeLbl.Size = UDim2.new(1, -104, 1, 0)
		codeLbl.Position = UDim2.fromOffset(45, 0)
		codeLbl.TextTruncate = Enum.TextTruncate.AtEnd
		local status = Guest.ui.label("queued", 9, Guest.theme.sub, Guest.font.medium, Enum.TextXAlignment.Right, row)
		status.Size = UDim2.fromOffset(58, 24)
		status.Position = UDim2.new(1, -64, 0, 0)
		rows[i] = { code = codeLbl, status = status }
	end

	table.insert(feedCards, card)
	trimCardList()

	return function(index, state)
		local r = rows[index]
		if not r then return end
		if state == "sending" then
			r.status.Text = "sending"
			r.status.TextColor3 = Guest.theme.warn
			r.code.TextColor3 = Guest.theme.txt
		elseif state == "sent" then
			r.status.Text = "sent"
			r.status.TextColor3 = Guest.theme.acc
			r.code.TextColor3 = Guest.theme.acc
		elseif state == "ok" then
			r.status.Text = "REDEEMED"
			r.status.TextColor3 = Guest.theme.ok
			r.code.TextColor3 = Guest.theme.ok
			titleLbl.Text = "REDEEMED"
			titleLbl.TextColor3 = Guest.theme.ok
		elseif state == "fail" then
			r.status.Text = "failed"
			r.status.TextColor3 = Guest.theme.err
		elseif state == "skip" then
			r.status.Text = "skipped"
			r.status.TextColor3 = Guest.theme.subDim
		end
	end
end

Guest.addRedeemCard = pushMultiRedeemCard

