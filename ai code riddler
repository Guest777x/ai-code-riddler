-- ============================================================
-- SOLVE PIPELINE  (LLM call -> sanitize -> pin -> cache)
-- ============================================================
function Guest.solve(arg, force)
	local key = Guest.cacheKey(arg)
	if Guest.state.busy and not force then return end
	if Guest.state.busy then
		-- one solve at a time is enough — a second call would race the UI
		return
	end

	local text = Guest.text.trim(Guest.text.stripTags(arg))
	if text == "" then return end
	if not force and not Guest.isAllowedMessage(text) then return end

	Guest.state.busy = true
	QuestionText.Text = text
	QuestionText.TextColor3 = Guest.theme.txt
	AnswerBox.Text = ""
	Guest.setStatus("thinking...", "busy")

	task.spawn(function()
		if setThreadIdentity then pcall(setThreadIdentity, 8) end
		local startedAt = os.clock()

		local ok, err = pcall(function()
			local answer, cached, errMsg, isCode, searched, searchQuery, altForm, altAnswer, cacheId =
				Guest.dispatch(text)
			local elapsed = os.clock() - startedAt
			if setThreadIdentity then pcall(setThreadIdentity, 8) end

			if answer then
				AnswerBox.Text = answer
				Guest.state.lastAnswer = answer
				AnswerBox.TextColor3 = isCode and Guest.theme.acc or Guest.theme.txt
				AnswerLabel.Text = isCode and "ANSWER  (CODE)"
					or searched and "ANSWER  (WEB)"
					or "ANSWER  (GENERAL)"

				if Guest.flags.autoCopy then Guest.text.copy(answer) end
				Guest.setStatus(("%s  (%.2fs%s)"):format(answer, elapsed, cached and ", cached" or ""), "ok")
				if altForm then
					AnswerLabel.Text = AnswerLabel.Text .. "   alt: " .. altForm
				end

				if Guest.flags.autoRedeem then
					Guest.state.lastAltForm   = altForm
					Guest.state.lastAltAnswer = altAnswer
					if Guest.flags.secureRedeem then
						Guest.secureRedeem(answer, altForm, altAnswer)
					else
						Guest.autoRedeemAnswer(answer)
					end
				end
			else
				AnswerBox.Text = ""
				Guest.setStatus("failed: " .. tostring(errMsg), "err")
			end

			Guest.addSolveCard(text, answer, elapsed, cached, isCode, searched, searchQuery)
			if Guest.flags.openFeed and not FeedW.Visible then positionFeed() end

			if searchQuery and not answer or (searchQuery and cached) then
				task.spawn(function()
					local webAnswer = Guest.searchWeb(text, searchQuery, answer, isCode, cacheId)
					if setThreadIdentity then pcall(setThreadIdentity, 8) end
					if webAnswer then
						AnswerBox.Text = webAnswer
						Guest.state.lastAnswer = webAnswer
						AnswerLabel.Text = isCode and "ANSWER  (CODE, WEB)" or "ANSWER  (WEB)"
						if Guest.flags.autoCopy then Guest.text.copy(webAnswer) end
						Guest.setStatus(("%s  (web, was %s)"):format(webAnswer, answer), "ok")
						Guest.addSolveCard(text, webAnswer, os.clock() - startedAt, false, isCode, true)
						if Guest.flags.autoRedeem then
							if Guest.flags.secureRedeem then
								Guest.secureRedeem(webAnswer)
							else
								Guest.autoRedeemAnswer(webAnswer)
							end
						end
					elseif AnswerLabel.Text:find("CHECKING") then
						AnswerLabel.Text = "ANSWER  (WEB)"
					end
				end)
			end
		end)

		Guest.state.busy = false
		if not ok then pcall(function() Guest.setStatus("error: " .. tostring(err), "err") end) end
	end)
end

-- The dispatching brain — everything the model actually sees
function Guest.dispatch(arg)
	local key = Guest.cacheKey(arg)

	if Guest.isCodeIntent(arg) then
		local resolved = Guest.extremes.resolve(arg)
		if resolved then
			Guest.state.answerCache[key] = { text = resolved, isCode = true, searched = false }
			return resolved, false, nil, true, false
		end
	end

	local ok, parts = pcall(Guest.resolvePrizeParts, arg)
	if ok and type(parts) == "string" and parts ~= "" then
		return parts, false, nil, true, false
	end

	local cached = Guest.state.answerCache[key]
	if cached then
		return cached.text, true, nil, cached.isCode, cached.searched,
			nil, cached.altForm, cached.altAnswer
	end

	local raw, err = Guest.net.signed("solve", {
		riddle = arg,
		liveState = Guest.keepLive(Guest.liveState(arg)),
	})
	if not raw then return nil, false, err end

	if Guest.model == "FASTER" and Guest.rawNeedsSmartRetry(arg, raw) then
		raw = Guest.net.signed("solve", {
			riddle = arg,
			liveState = Guest.keepLive(Guest.liveState(arg)),
			tier = "FAST",
		}) or raw
	end

	-- OVERRIDE tag bypasses the sanitizer
	local override = raw:match("^OVERRIDE:%s*(.+)$")
	if override then
		local clean = Guest.text.trim(override)
		Guest.state.answerCache[key] = { text = clean, isCode = true, searched = false }
		return clean, false, nil, true, false
	end

	Guest.state.lastRawSolve = raw
	local stripped = raw:gsub("^[\"']", ""):gsub("[\"']$", "")
	local mainPart, altPart = stripped:match("^(.-)%s*||%s*ALT%s*:%s*(.+)$")
	if not mainPart then mainPart, altPart = stripped:match("^(.-)%s+ALT%s*:%s*(.+)$") end
	local hasAlt = mainPart and Guest.text.trim(mainPart) ~= ""
	local altAnswer = nil
	if hasAlt then
		stripped = Guest.text.trim(mainPart)
		altAnswer = Guest.text.trim(altPart)
	end

	-- Parse the "KIND: rest" prefix
	local kind, body = stripped:match("^(%a+)%s*:%s*(.*)$")
	local mode = "CODE"
	if kind then
		mode = kind:upper()
		if mode == "SEARCH" then
			mode = "SEARCHANSWER"
		elseif mode == "ANSWER" or mode == "CODE" or mode == "SEARCHCODE" or mode == "SEARCHANSWER" then
			stripped = body
		else
			mode = "CODE"
		end
	end

	local payload = Guest.text.trim(stripped)
	local isSearch = mode == "SEARCHCODE" or mode == "SEARCHANSWER"
	local searchQuery = nil
	if isSearch then
		local query, inner = payload:match("^(.-)%s*|%s*(.*)$")
		searchQuery = Guest.text.trim(query or payload)
		payload = Guest.text.trim(inner or "")
		if searchQuery == "" then searchQuery = arg end
		mode = mode == "SEARCHCODE" and "CODE" or "ANSWER"
		payload = payload ~= "" and payload or "..."
	end

	if mode ~= "CODE" and Guest.isCodeIntent(arg) then
		mode = "CODE"
	end
	if mode == "CODE" and Guest.malformedCodeBody(payload) then
		return nil, false, "model returned an explanation instead of a code"
	end

	local isCode = mode == "CODE"
	local codeForm, codeFormNoPrefix

	if isCode then
		codeForm = payload:gsub("%s+", ""):gsub("(%d)%.(%d)", "%1\1%2"):gsub("[%.,']", ""):gsub("\1", "."):upper()
		codeFormNoPrefix = Guest.preserveNumericSuffix(arg, Guest.stripSuffix(codeForm))
		if codeForm == codeFormNoPrefix then codeFormNoPrefix = nil end
	else
		codeForm = payload:gsub(",", ""):gsub("%s+", " "):gsub("%.$", "")
		codeFormNoPrefix = nil
	end

	-- Pin pipeline — repair stale names against the live game
	local step = Guest.pinLiveMutation(arg, Guest.expandUnits(codeForm), isCode)
	local afterNew, pinned1 = Guest.pinNewBrainrot(arg, step, isCode)
	local afterGear, pinned2 = Guest.pinNewGear(arg, afterNew, isCode)
	local afterMeta, pinned3 = Guest.pinNewMeta(arg, afterGear, isCode)
	local afterRarity, pinned4 = Guest.pinRarity(arg, afterMeta, isCode)
	pinned1 = pinned1 or pinned2 or pinned3
	pinned4 = pinned1 or pinned4

	local snapped, wasSnapped = Guest.snapSpelling(afterRarity)
	if wasSnapped then
		pinned4 = true
	else
		snapped = afterRarity
	end

	local descriptionWarning = Guest.checkDescribed(arg, snapped, isCode)
	if descriptionWarning then Guest.state.lastNameWarning = descriptionWarning end

	if snapped == "" or snapped == "NIL" or snapped == "..." then
		return nil, false, "model gave an empty answer"
	end

	if altAnswer then
		if isCode then
			altAnswer = Guest.stripSuffix(altAnswer:gsub("%s+", ""):gsub("[%.,']", ""):upper())
		else
			altAnswer = altAnswer:gsub(",", ""):gsub("%s+", " "):gsub("%.$", "")
		end
		if altAnswer == snapped or altAnswer == "" then
			altAnswer = nil
		end
		if pinned4 then altAnswer = nil end
	end

	Guest.state.lastAnswer = snapped
	if not searchQuery then
		Guest.state.answerCache[key] = {
			text = snapped, isCode = isCode, searched = false,
			altForm = codeForm, altAnswer = altAnswer,
		}
	end

	return snapped, false, nil, isCode, false, searchQuery, codeForm, altAnswer, key
end

-- Second pass — search-backed web answer
function Guest.searchWeb(arg, query, firstAnswer, isCode, cacheId)
	local raw = Guest.net.signed("search", { riddle = arg, query = query, isCode = isCode })
	if not raw then return nil end
	local payload = Guest.text.trim(raw:gsub("^%a+%s*:%s*", ""))
	local cleaned
	if isCode then
		cleaned = Guest.preserveNumericSuffix(arg, payload:gsub("%s+", ""):gsub("[%.,]$", ""):upper())
	else
		cleaned = payload:gsub(",", ""):gsub("%s+", " "):gsub("%.$", "")
	end
	if cleaned == "" then return nil end
	if cacheId then
		Guest.state.answerCache[cacheId] = { text = cleaned, isCode = isCode, searched = true }
	else
		Guest.state.answerCache[Guest.cacheKey(arg)] = { text = cleaned, isCode = isCode, searched = true }
	end
	if cleaned == firstAnswer then return nil end
	return cleaned
end

-- Post-pin guard for the model's "smart answer" retry
function Guest.rawNeedsSmartRetry(arg, raw)
	local kind, body = tostring(raw or ""):match("^%s*(%a+)%s*:%s*(.*)$")
	kind = kind and kind:upper() or "CODE"
	if kind == "ANSWER" and Guest.isCodeIntent(arg) then
		return Guest.malformedCodeBody(body)
	end
	return kind == "CODE" and Guest.malformedCodeBody(body)
end

-- Strip a trailing "...EVENT" or similar
Guest.suffixes = { "EVENT" }
function Guest.stripSuffix(arg)
	if arg == "REDCARPET" or arg == "THEREDCARPET" then return "REDCARPET" end
	for _, suf in ipairs(Guest.suffixes) do
		if #suf < #arg then
			local head = arg:sub(1, #arg - #suf)
			if arg:sub(-#suf) == suf and #head >= 3 then return head end
		end
	end
	return arg
end

function Guest.preserveNumericSuffix(arg, candidate)
	local src = tostring(arg or "")
	local m = src:match("[Pp][Ll][Uu][Ss]%s+(%d+)%s*[%?%.!]*$") or src:match("%+%s*(%d+)%s*[%?%.!]*$")
	if not m then return candidate end
	local c = tostring(candidate or "")
	if c:sub(-#m) ~= m then return c .. m end
	return c
end

