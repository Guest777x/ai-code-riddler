Guest.devBaseEvents = { "Sammy's Base", "Caylus Base", "Steak's Base", "Rusty's Base" }

function Guest.read.devBases()
	local out = {}
	local activeEvents = PlayerGui:FindFirstChild("ActiveEvents")
	activeEvents = activeEvents and activeEvents:FindFirstChild("ActiveEvents")
	if not activeEvents then return out end

	for _, eventName in ipairs(Guest.devBaseEvents) do
		local node = activeEvents:FindFirstChild(eventName)
		if node and node.Visible then
			local lbl = node:FindFirstChildWhichIsA("TextLabel", true)
			local who = eventName:match("^(.-)'s Base$") or eventName:match("^(.-) Base$")
			local plots = Workspace:FindFirstChild("Plots")
			local skin = nil
			if plots and who then
				for _, plot in ipairs(plots:GetChildren()) do
					for _, d in ipairs(plot:GetDescendants()) do
						if d:IsA("TextLabel") then
							local m = tostring(d.Text):match("^(.-)'s Base$")
							if m and m:lower():find(who:lower(), 1, true) then
								skin = plot:GetAttribute("Skin")
								break
							end
						end
					end
					if skin then break end
				end
			end
			out[#out+1] = {
				event    = eventName,
				who      = who,
				skin     = skin and tostring(skin) or nil,
				timeLeft = lbl and lbl.Text or nil,
			}
		end
	end
	return out
end

