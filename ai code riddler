	if Guest.redeem.remoteFn and Guest.redeem.remoteFn.Parent then return Guest.redeem.remoteFn end
	local ok, net = pcall(require, Net)
	if ok and type(net) == "table" then
		local ok2, rf = pcall(function()
			return net:RemoteFunction("7d14a912-1040-4867-b005-98838eb9acc4")
		end)
		if ok2 and typeof(rf) == "Instance" then Guest.redeem.remoteFn = rf end
