				for _, root in ipairs(roots) do
					local scanned = 0
					local ok = pcall(function()
						for _, d in ipairs(root:GetDescendants()) do
							scanned = scanned + 1
							if scanned > 4000 then break end
							if not d:IsDescendantOf(ScreenGui)
								and (d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton"))
								and leaks(d.Text) then
								trip()
								return
							end
						end
					end)
					if not ok then break end
				end
			end
		end)
	end)
end)
