function Guest.read.liveEvents()
	local out, seen = {}, {}
	local controllers = ReplicatedStorage:FindFirstChild("Controllers")
	local ctl = Guest.text.requireModule(controllers and controllers:FindFirstChild("EventController"))

	if ctl and ctl.GetActiveEvents then
		local ok, result = pcall(function() return ctl:GetActiveEvents() end)
		if ok and type(result) == "table" then
			for _, e in pairs(result) do
				if type(e) == "table" then
					local name = e.eventName or e.EventName or e.name
					if type(name) == "string" and name ~= "" and not seen[name] then
						seen[name] = true
						out[#out+1] = { name = name }
					end
				end
			end
		end
	end

	local active = PlayerGui:FindFirstChild("ActiveEvents")
	active = active and active:FindFirstChild("ActiveEvents")
	if active then
		local byName = {}
		for _, e in ipairs(out) do byName[e.name] = e end
		for _, ch in ipairs(active:GetChildren()) do
			if ch:IsA("Frame") and ch.Visible then
				local lbl = ch:FindFirstChildWhichIsA("TextLabel", true)
				local timeText = lbl and lbl.Text or nil
				if byName[ch.Name] then
					byName[ch.Name].timeLeft = timeText
				elseif not seen[ch.Name] then
					seen[ch.Name] = true
					out[#out+1] = { name = ch.Name, timeLeft = timeText }
				end
			end
		end
	end
	return out
end

-- ============================================================
-- NAME CANDIDATES  (fuzzy match against animal names)
-- ============================================================
function Guest.nameCandidates(arg)
	local s = tostring(arg or ""):lower()
	if s == "" then return nil end
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	if type(animals) ~= "table" then return nil end

	local ignore = {
		brainrot=true,brainrots=true,brain=true,brainrotr=true,
		what=true,which=true,that=true,this=true,with=true,from=true,
		does=true,much=true,make=true,makes=true,earn=true,earns=true,
		produce=true,produces=true,generate=true,generates=true,
		income=true,name=true,looks=true,like=true,game=true,
		added=true,update=true,newest=true,latest=true,right=true,now=true,
		plus=true,second=true,per=true,the=true,["and"]=true,new=true,
		["for"]=true,["in"]=true,is=true,["do"]=true,
	}

	local tokens = {}
	for w in s:gmatch("%a+") do
		if #w >= 4 and not ignore[w] then tokens[w] = true end
	end
	if next(tokens) == nil then return nil end

	local function lev(a, b, max)
		if math.abs(#a - #b) > max then return false end
		local prev = {}
		for i = 0, #b do prev[i] = i end
		for i = 1, #a do
			local cur = { [0] = i }
			local best = i
			for j = 1, #b do
				cur[j] = math.min(prev[j] + 1, cur[j-1] + 1, prev[j-1] + (a:sub(i,i) == b:sub(j,j) and 0 or 1))
				if cur[j] < best then best = cur[j] end
			end
			if best > max then return false end
			prev = cur
		end
		return prev[#b] <= max
	end

	local function fuzzy(a, b)
		if a == b then return true end
		local shorter = math.min(#a, #b)
		local prefix = 0
		for i = 1, shorter do
			if a:sub(i,i) == b:sub(i,i) then prefix = i else break end
		end
		if prefix >= 5 then return true end
		if prefix >= 4 and prefix >= shorter - 1 then return true end
		if prefix >= 3 and shorter >= 5 then return lev(a, b, shorter >= 8 and 2 or 1) end
		return false
	end

	local scored = {}
	for k, v in pairs(animals) do
		if type(v) == "table" then
			local name = tostring(v.DisplayName or k)
			local hits = 0
			for w in name:lower():gmatch("%a+") do
				if #w >= 4 then
					for t in pairs(tokens) do
						if fuzzy(t, w) then hits = hits + 1; break end
					end
				end
			end
			if hits > 0 then scored[#scored+1] = { name = name, hits = hits } end
		end
	end
	if #scored == 0 then return nil end
	table.sort(scored, function(a, b)
		if a.hits ~= b.hits then return a.hits > b.hits end
		return a.name < b.name
	end)

	local out = {}
	for i = 1, math.min(8, #scored) do out[#out+1] = scored[i].name end
	return out
end

-- ============================================================
-- SOURCE ROSTER  (which brainrots come from <this source>?)
-- ============================================================
function Guest.sourceRoster(arg)
	local s = tostring(arg or ""):lower()
	if s == "" then return nil end
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	if type(animals) ~= "table" then return nil end

	local skip = { the=true,this=true,was=true,obtained=true,from=true,s=true,new=true,
		year=true,years=true,event=true,machine=true,craft=true,fuse=true,code=true,codes=true }

	local grouped = {}
	for k, a in pairs(animals) do
		if type(a) == "table" and type(a.ObtainedFrom) == "table" and a.ObtainedFrom.Source then
			local src = tostring(a.ObtainedFrom.Source)
			grouped[src] = grouped[src] or {}
			table.insert(grouped[src], tostring(a.DisplayName or k))
		end
	end

	local bestSet, bestScore = nil, 0
	for src in pairs(grouped) do
		local score = 0
		for w in src:lower():gsub("'", ""):gmatch("%a+") do
			if not skip[w] and #w >= 3 and s:find(w, 1, true) then score = score + 1 end
		end
		if score > bestScore then bestSet, bestScore = { src }, score
		elseif score == bestScore and score > 0 then bestSet[#bestSet+1] = src end
	end

	if not bestSet or bestScore < 1 then return nil end
	if bestScore == 1 and #bestSet > 1 then return nil end

	local lines = {}
	for _, src in ipairs(bestSet) do
		local list = grouped[src]
		if #list <= 30 then
			table.sort(list)
			lines[#lines+1] = ("%s (%d): %s"):format(src, #list, table.concat(list, "; "))
		end
	end
	if #lines == 0 then return nil end
	return table.concat(lines, "  ||  ")
end

-- ============================================================
-- SNAP-SPELLING  (fix the model's "68" -> "67" typos)
-- ============================================================
Guest.factNames = {
	"ASTROWORLD","TRAVISSCOTT","SPYDERSAMMY","SAMBRAKTA","SKRILLA","ICEMAN",
	"BRAZIL","BRAZILIANSPYDER","FEBRUARY","GROWAGARDEN","RACCOONIJANDELINI","JANDEL",
}

function Guest.snapSpelling(arg)
	local s = tostring(arg or ""):upper():gsub("%W", "")
	if #s < 6 then return arg, false end
	local datas = ReplicatedStorage:FindFirstChild("Datas")
	local animals = Guest.text.requireModule(datas and datas:FindFirstChild("Animals"))
	if type(animals) ~= "table" then return arg, false end

	local anchors = {
		"SPYDERSAMMY","SAMMY","JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE",
		"JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER",
	}

	local core, suffix = s, ""
	local prefix = ""

	for _ = 1, 4 do
		local m = core:match("(%d+)$")
		local progressed = false
		if m and #core - #m >= 6 then
			core = core:sub(1, #core - #m)
			suffix = m .. suffix
			progressed = true
		end

		for _, a in ipairs(anchors) do
			if #core - #a >= 6 and core:sub(-#a) == a then
				core = core:sub(1, #core - #a)
				suffix = a .. suffix
				progressed = true
				break
			end
		end

		local m2 = core:match("^(%d+)")
		if m2 and #core - #m2 >= 6 then
			prefix = prefix .. m2
			core = core:sub(#m2 + 1)
			progressed = true
		end

		for _, a in ipairs(anchors) do
			if a ~= "MAY" and #core - #a >= 6 and core:sub(1, #a) == a then
				prefix = prefix .. a
				core = core:sub(#a + 1)
				progressed = true
				break
			end
		end

		if not progressed then break end
	end

	if #core < 6 then return arg, false end

	local function lev(a, b)
		if math.abs(#a - #b) > 2 then return 3 end
		local prev = {}
		for i = 0, #b do prev[i] = i end
		for i = 1, #a do
			local cur = { [0] = i }
			local best = i
			for j = 1, #b do
				cur[j] = math.min(prev[j] + 1, cur[j-1] + 1, prev[j-1] + (a:sub(i,i) == b:sub(j,j) and 0 or 1))
				if cur[j] < best then best = cur[j] end
			end
			if best > 2 then return 3 end
			prev = cur
		end
		return prev[#b]
	end

	local exact = false
	local matches = {}
	local seen = {}
	local function try(candidate)
		if candidate == core then exact = true; return true end
		if #candidate >= 6 and math.abs(#candidate - #core) <= 2 and not seen[candidate] then
			if lev(core, candidate) <= 2 then
				seen[candidate] = true
				matches[#matches+1] = candidate
			end
		end
		return false
	end

	for k, v in pairs(animals) do
		if type(v) ~= "table" then
			continue
		end
		if try(tostring(v.DisplayName or k):upper():gsub("%W", "")) then break end
	end
	if not exact then
		for _, n in ipairs(Guest.factNames) do
			if try(n) then break end
		end
	end

	if exact or #matches ~= 1 then return arg, false end
	Guest.state.lastSnap = ("%s -> %s%s%s"):format(arg, prefix, matches[1], suffix)
	return prefix .. matches[1] .. suffix, true
end

