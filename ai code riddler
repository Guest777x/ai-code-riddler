-- ============================================================
-- SEGMENTED CONTROL  (small pill selector — used for FASTER/FAST + UI size)
-- ============================================================
function Guest.ui.segmented(parent, options, current, onChange)
	local outer = Guest.ui.new("Frame", {
		BackgroundColor3 = Guest.theme.input,
		BorderSizePixel = 0,
	}, parent)
	Guest.ui.corner(outer, 7)

	local buttons = {}
	local state = current

	local function select(option)
		if option == state then return end
		state = option
		for k, b in pairs(buttons) do
			Guest.ui.tween(b, 0.12, {
				BackgroundColor3 = k == option and Guest.theme.acc or Guest.theme.input,
			})
			b.TextColor3 = k == option and Color3.fromRGB(255, 255, 255) or Guest.theme.sub
		end
		if onChange then onChange(option) end
	end

	for i, opt in ipairs(options) do
		local btn = Guest.ui.new("TextButton", {
			Size = UDim2.new(1 / #options, -2, 1, -2),
			Position = UDim2.new((i - 1) / #options, 1, 0, 1),
			BackgroundColor3 = opt == current and Guest.theme.acc or Guest.theme.input,
			Text = opt,
			Font = Guest.font.bold,
			TextSize = 10,
			TextColor3 = opt == current and Color3.fromRGB(255, 255, 255) or Guest.theme.sub,
			AutoButtonColor = false,
			BorderSizePixel = 0,
		}, outer)
		Guest.ui.corner(btn, 6)
		buttons[opt] = btn
		btn.MouseButton1Click:Connect(function() select(opt) end)
	end

	return outer, select, function() return state end
end

